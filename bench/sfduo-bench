#!/usr/bin/python3
"""sfduo-bench: the same measurements on the port and on stock Android.

    sfduo-bench linux   [--host root@172.16.42.1] SCENARIO... [--reps N]
    sfduo-bench android [--serial SERIAL]         SCENARIO... [--reps N]
    sfduo-bench report  RESULTS.jsonl...

Runs on the computer and drives the phone: over ssh when it runs the port,
over adb when it runs Android. Every run appends its raw measurements, one
JSON object a line, to bench/results/<date>-<target>.jsonl, and prints the
medians. `report` reads any number of those files and prints them side by
side. The protocol - the conditions, what each scenario measures and where
the two systems' tools differ - is bench/README.md.

Scenarios:
    launch   each app of the target's list started from nothing: the
             request to the app's first frame, cold (its process not
             running; the page cache is left as it is on both systems)
    grid     the app list opened with a swipe up and closed with a swipe
             down (the port's app grid; Android's launcher app drawer):
             the compositor's frame times through each motion
    look     each launch recorded and judged against what a launch must do
    move     an open app called to the other panel from that panel's dock
    close    an open app closed
    beside   an app launched with another app open on the other panel
    restore  a running app, put away, brought back from the dock
             (these four: bench/README.md, "Beyond the launch", #209)
"""
import argparse
import datetime
import json
import os
import re
import shlex
import statistics
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
RESULTS = os.path.join(HERE, "results")
FRAME_MS = 1000.0 / 60          # both Duos drive their panels at 60 Hz
IDLE_GAP_MS = 150               # a pause this long ends a motion


def die(message):
    sys.exit("sfduo-bench: " + message)


# ---- what every target is measured by -------------------------------------

def motion_metrics(frames, start, end=None):
    """Frame times through one motion.

    `frames` are the times (ms, the target's monotonic clock) the compositor
    put a frame on the panel. The motion is the frames from `start` (the
    finger coming down) until the first pause of IDLE_GAP_MS after `end`
    (the finger lifting; the motion carries on after it), or after `start`.
    A frame late by one refresh is one dropped; by two, two."""
    after = [t for t in frames if t >= start]
    if not after:
        return None
    motion = [after[0]]
    for t in after[1:]:
        if t - motion[-1] > IDLE_GAP_MS and t > (end or start):
            break
        motion.append(t)
    gaps = [b - a for a, b in zip(motion, motion[1:])]
    if not gaps:
        return None
    gaps_sorted = sorted(gaps)
    return {
        "frames": len(motion),
        "ms": round(motion[-1] - motion[0], 1),
        "fps": round(len(gaps) * 1000 / (motion[-1] - motion[0]), 1),
        "p50": round(statistics.median(gaps), 1),
        "p95": round(gaps_sorted[min(len(gaps) - 1, int(len(gaps) * 0.95))], 1),
        "max": round(max(gaps), 1),
        "dropped": sum(max(0, round(g / FRAME_MS) - 1) for g in gaps),
    }


class Target:
    name = "?"
    only = None                 # --apps: the kinds to run, all when None

    def selected(self, apps):
        if isinstance(apps, dict):
            return {k: v for k, v in apps.items() if not self.only or k in self.only}
        return [k for k in apps if not self.only or k in self.only]

    def __init__(self, reps):
        self.reps = reps
        stamp = datetime.date.today().isoformat()
        os.makedirs(RESULTS, exist_ok=True)
        self.out = os.path.join(RESULTS, f"{stamp}-{self.name}.jsonl")

    def record(self, scenario, **fields):
        row = {"target": self.name, "scenario": scenario,
               "time": datetime.datetime.now().isoformat(timespec="seconds"), **fields}
        with open(self.out, "a") as fp:
            fp.write(json.dumps(row) + "\n")
        return row


# ---- the port ---------------------------------------------------------------

# What the port offers for each kind of app: its desktop id, its window's
# app_id, its process,
# and whether that process runs all the time by design. Clock (alarms),
# Phone (incoming calls) and Messages (incoming texts) are started with the
# session and stay; their "launch" is a window from a running process, as
# on Android, and is recorded as resident. Every other app is killed by its
# exact process name before each launch - Calendar and Camera stay behind
# when their window closes, and a launch then would be warm.
LINUX_APPS = {
    "settings": ("org.gnome.Settings", "org.gnome.Settings", "gnome-control-center", False),
    "calculator": ("org.gnome.Calculator", "org.gnome.Calculator", "gnome-calculator", False),
    "clock": ("org.gnome.clocks", "org.gnome.clocks", "gnome-clocks", True),
    "contacts": ("org.gnome.Contacts", "org.gnome.Contacts", "gnome-contacts", False),
    "phone": ("org.gnome.Calls", "org.gnome.Calls", "gnome-calls", True),
    "messages": ("sm.puri.Chatty", "sm.puri.Chatty", "chatty", True),
    "calendar": ("org.gnome.Calendar", "org.gnome.Calendar", "gnome-calendar", False),
    "weather": ("org.gnome.Weather", "org.gnome.Weather", "gnome-weather", False),
    "browser": ("firefox", "firefox", "firefox", False),
    # its window is not named after its desktop file
    "camera": ("droidian-camera", "org.Droidian.droidian-camera", "droidian-camera", False),
}
# The apps the scenarios beyond the launch use: one with pages that follow it
# (Settings), one plain, one always running.
MOVE_APPS = ("settings", "calculator", "clock")
SCREEN_LOGICAL_WIDTH = 1392         # both panels and the hinge, at scale 2
SESSION = ("XDG_RUNTIME_DIR=/run/user/32011 WAYLAND_DISPLAY=wayland-0 "
           "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/32011/bus")
# The functions probed in the compositor. perf puts a probe on a function's
# PLT stub as well as on the function when both exist; only calls made from
# outside the library pass the stub, so the stub's probe saw some frames and
# not others - frames that looked dropped in pairs. Only the function itself
# is recorded.
PROBES = {
    "frame": ("/usr/lib/aarch64-linux-gnu/libwlroots.so.12a", "wlr_output_send_frame"),
    "map": ("/usr/bin/phoc", "phoc_view_map"),
}
# Named probes, with what they carry. A layer surface (the dock's curtain is
# one, "sfduo-curtain") mapped and unmapped; a window mapped, unmapped, moved
# and resized - the window by its address, which pairs its events.
NAMED = {
    "lmap": ("/usr/bin/phoc", "lmap=../src/layer-surface.c:332 ns=self->layer_surface->namespace:string"),
    "lunmap": ("/usr/bin/phoc", "lunmap=../src/layer-surface.c:376 ns=self->layer_surface->namespace:string"),
    "vmap": ("/usr/bin/phoc", "vmap=phoc_view_map self:x64"),
    "vunmap": ("/usr/bin/phoc", "vunmap=phoc_view_unmap view:x64"),
    "vpos": ("/usr/bin/phoc", "vpos=view_update_position view:x64 x:s32 y:s32"),
    "vsize": ("/usr/bin/phoc", "vsize=view_update_size view:x64 width:s32 height:s32"),
    # phoc letting a held new window go (phoc-patches/0010): its client fell
    # quiet at its panel's size, or the hold's cap ran out
    # a layer surface's commit with its bottom margin: the dock's curtain
    # stays mapped and is raised and lowered by its margin (#180)
    "lcommit": ("/usr/bin/phoc", "lcommit=../src/layer-surface.c:226 "
                "ns=wlr_layer_surface->namespace:string mb=wlr_layer_surface->current.margin.bottom:s32"),
    "hquiet": ("/usr/bin/phoc", "hquiet=on_wake_quiet"),
    "hcap": ("/usr/bin/phoc", "hcap=on_wake_cap"),
}
# The app grid on the left panel, in the touch tool's logical pixels: a
# flick up from the bottom band opens it, a flick down on it closes it. The
# finger lifts moving - a rest before the lift is not the shell's frame.
GRID_OPEN = "swipe 300 870 300 650 0.2 0"
GRID_CLOSE = "swipe 300 300 300 540 0.2 0"


class Linux(Target):
    name = "linux"

    def __init__(self, reps, host):
        self.host = host
        super().__init__(reps)

    def sh(self, command, timeout=120, check=True):
        done = subprocess.run(["ssh", "-o", "ConnectTimeout=5", self.host, command],
                              stdin=subprocess.DEVNULL, capture_output=True, text=True,
                              timeout=timeout)
        if check and done.returncode != 0:
            die(f"on the phone: {command[:60]}...: {done.stderr.strip()[-300:]}")
        return done.stdout

    def preflight(self):
        state = self.sh("cat /sys/class/backlight/panel0-backlight/bl_power "
                        "/sys/class/power_supply/battery/capacity "
                        "/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor; pidof phoc").split()
        if state[0] != "0":
            die("the display is off - the shell throttles with it (docs/PERF.md)")
        if state[2] == "powersave":
            die("the CPU governor is powersave")
        # Locked, every swipe lands on the lock screen, which redraws all of
        # itself each frame: the first day's numbers were that (#177).
        self.check_unlocked()
        self.battery = int(state[1])

    def check_unlocked(self):
        """Locked, every swipe lands on the lock screen, which redraws all of
        itself each frame (the first day's numbers were that, #177), and a
        screen recording waits for frames that never come. Asked before every
        launch too: the shell restarting mid-series comes back locked."""
        locked = self.sh("for s in $(loginctl list-sessions --no-legend | awk '$4==\"seat0\"{print $1}'); "
                         "do loginctl show-session $s -p LockedHint --value; done")
        if "yes" in locked.split():
            die("the phone is locked - unlock it first")

    def capture(self, probes, seconds, script="", before=""):
        """Record the probes on phoc for `seconds` while a touch script
        runs; returns ({probe: [ms]}, [touch output lines])."""
        adds = []
        for key in probes:
            if key in NAMED:
                binary, spec = NAMED[key]
                adds.append(f"perf probe -q -x {binary} {shlex.quote(spec)} 2>/dev/null || true")
                adds.append(f"E=\"$E -e probe_phoc:{key}\"")
                continue
            binary, symbol = PROBES[key]
            adds.append(f"perf probe -q -x {binary} {symbol} 2>/dev/null || true")
            adds.append(f"E=\"$E $(perf probe -l 2>/dev/null | grep -v '@plt' | grep '(on {symbol}[@ ]' "
                        "| awk '{printf \" -e %s\", $1}')\"")
        touch = (f"printf '%s\\n' {shlex.quote(script)} | /usr/local/sbin/sfduo-touch script"
                 if script else "")
        command = f"""
E=
{chr(10).join(adds)}
P=$(pidof phoc)
perf record -q -k CLOCK_MONOTONIC $E -p $P -o /tmp/sfduo-bench.data -- sleep {seconds} >/dev/null 2>&1 &
sleep 0.5
{before}
{touch}
wait
perf script -i /tmp/sfduo-bench.data -F time,event,trace 2>/dev/null
perf probe -q -d 'probe_libwlroots:*' 2>/dev/null; perf probe -q -d 'probe_phoc:*' 2>/dev/null
rm -f /tmp/sfduo-bench.data
"""
        out = self.sh(command, timeout=seconds + 60)
        found = {key: [] for key in probes}
        self.events = []                # (ms, probe, {arg: value}) in order
        lines = []
        for line in out.splitlines():
            m = re.match(r"\s*([\d.]+):\s+(\S+):(.*)", line)
            if m:
                t, name = float(m.group(1)) * 1000, m.group(2).split(":")[-1]
                args = dict(re.findall(r'(\w+)=("[^"]*"|\S+)', m.group(3)))
                for key in probes:
                    if name == key if key in NAMED else name.startswith(PROBES[key][1]):
                        found[key].append(t)
                        self.events.append((t, key, {k: v.strip('"') for k, v in args.items()}))
            elif line.startswith(("mark ", "swipe ")):
                lines.append(line.split())
        return found, lines

    # -- scenarios --

    def grid(self):
        script = ["sleep 1"]
        for _ in range(self.reps):
            script += [GRID_OPEN, "sleep 1.2", GRID_CLOSE, "sleep 1.2"]
        found, lines = self.capture(["frame"], seconds=2 + self.reps * 3.4, script="\n".join(script))
        swipes = [(float(a) * 1000, float(b) * 1000) for _, a, b in lines]
        rows = []
        for i, (down, up) in enumerate(swipes):
            m = motion_metrics(found["frame"], down, up)
            rows.append(self.record("grid", motion="open" if i % 2 == 0 else "close",
                                    rep=i // 2, battery=self.battery, **(m or {"frames": 0})))
        return rows

    def launch(self):
        rows = []
        session = f"sudo -u droidian {SESSION}"
        for kind, (desktop, app, process, resident) in self.selected(LINUX_APPS).items():
            for rep in range(self.reps):
                # from nothing: the window closed, and the process gone
                # unless it is one that always runs
                # the kernel keeps 15 characters of a process's name, and pkill -x
                # compares with those: gnome-calculator was never killed
                kill = "" if resident else f"pkill -x {process[:15]}; "
                self.sh(f"{session} wlrctl toplevel close app_id:{app} 2>/dev/null; sleep 1; "
                        f"{kill}sleep 2", check=False)
                before = (f"D=$(pgrep -x sfduo-dock); T=$(python3 -c 'import time;print(time.monotonic())'); echo mark request $T; "
                          f"echo '{desktop}.desktop left' > /run/user/32011/sfduo-launch; "
                          "kill -USR2 $D")
                found, lines = self.capture(["map", "frame"], seconds=8, before=before)
                request = next(float(l[2]) * 1000 for l in lines if l[:2] == ["mark", "request"])
                maps = [t for t in found["map"] if t > request]
                row = {"app": kind, "id": app, "rep": rep, "resident": resident,
                       "battery": self.battery}
                if maps:
                    row["to_map_ms"] = round(maps[0] - request, 1)
                    shown = [t for t in found["frame"] if t >= maps[0]]
                    if shown:
                        row["to_frame_ms"] = round(shown[0] - request, 1)
                rows.append(self.record("launch", **row))
                self.sh(f"{session} wlrctl toplevel close app_id:{app} 2>/dev/null; sleep 1", check=False)
        return rows

    def look(self):
        """Each app launched as `launch` does, recorded on screen and with the
        window's and the curtain's comings and goings, and judged against
        what every launch must do (bench/README.md)."""
        rows = []
        session = f"sudo -u droidian {SESSION}"
        clips = os.path.join(RESULTS, "clips")
        os.makedirs(clips, exist_ok=True)
        for kind, (desktop, app, process, resident) in self.selected(LINUX_APPS).items():
            for rep in range(self.reps):
                self.check_unlocked()
                # the kernel keeps 15 characters of a process's name, and pkill -x
                # compares with those: gnome-calculator was never killed
                kill = "" if resident else f"pkill -x {process[:15]}; "
                self.sh(f"{session} wlrctl toplevel close app_id:{app} 2>/dev/null; sleep 1; "
                        f"{kill}sleep 2", check=False)
                # bounded: a recorder given no frames (a locked screen) never ends
                before = ("rm -f /tmp/sfduo-look.mp4; "
                          f"timeout -s INT 8 {session} wf-recorder -r 60 -F scale=iw/{VIDEO_SCALE}:ih/{VIDEO_SCALE} "
                          "-f /tmp/sfduo-look.mp4 >/dev/null 2>&1 & W=$!; sleep 1; "
                          "D=$(pgrep -x sfduo-dock); T=$(python3 -c 'import time;print(time.monotonic())'); echo mark request $T; "
                          f"echo '{desktop}.desktop left' > /run/user/32011/sfduo-launch; "
                          "kill -USR2 $D; sleep 5; kill -INT $W; wait $W")
                found, lines = self.capture(["frame", "lmap", "lunmap", "lcommit", "vmap", "vunmap",
                                             "vpos", "vsize", "hquiet", "hcap"],
                                            seconds=8, before=before)
                request = next(float(l[2]) * 1000 for l in lines if l[:2] == ["mark", "request"])
                clip = os.path.join(clips, f"{datetime.datetime.now():%Y-%m-%d-%H%M%S}-{kind}-{rep}.mp4")
                subprocess.run(["scp", "-q", f"{self.host}:/tmp/sfduo-look.mp4", clip], check=False)
                rows.append(self.record("look", app=kind, id=app, rep=rep, resident=resident,
                                        **self._judge(request, clip)))
                self.sh(f"{session} wlrctl toplevel close app_id:{app} 2>/dev/null; sleep 1", check=False)
        return rows

    def _judge(self, request, clip):
        ev = [(t - request, k, a) for t, k, a in self.events if t >= request - 50]
        # up: mapped, or moved on screen; down: unmapped, or parked below it
        curtain = []
        for t, k, a in ev:
            if a.get("ns") != "sfduo-curtain":
                continue
            if k == "lmap" or (k == "lcommit" and int(a.get("mb", -1)) > -8):
                curtain.append((t, "up"))
            elif k == "lunmap" or (k == "lcommit" and int(a.get("mb", 0)) < -100):
                curtain.append((t, "down"))
        up = next((t for t, k in curtain if k == "up" and t >= 0), None)
        down = next((t for t, k in curtain if k == "down" and up is not None and t > up), None)
        mapped = next(((t, a["self_x64"]) for t, k, a in ev if k == "vmap"), None)
        out = {"clip": os.path.basename(clip)}
        if up is not None:
            out["curtain_up_ms"] = round(up, 1)
        if down is not None:
            out["curtain_down_ms"] = round(down, 1)
        if mapped:
            t_map, view = mapped
            out["map_ms"] = round(t_map, 1)
            mine = [(t, k, a) for t, k, a in ev if a.get("view_x64") == view or a.get("self_x64") == view]
            out["unmaps"] = sum(1 for t, k, a in mine if k == "vunmap")
            boxes, box = [], {}
            for t, k, a in mine:
                if k == "vpos":
                    box.update(x=int(a["x_s32"]), y=int(a["y_s32"]))
                elif k == "vsize":
                    box.update(w=int(a["width_s32"]), h=int(a["height_s32"]))
                else:
                    continue
                # the probes fire on entry, also when nothing changes: only
                # a change is kept
                if not boxes or boxes[-1][1] != box:
                    boxes.append((round(t, 1), dict(box)))
            out["boxes"] = boxes
            # the phases of the launch after the map (#191)
            full = next((t for t, b in boxes if b.get("w") == 675 and b.get("h") in (898, 900)), None)
            if full is not None:
                out["full_size_ms"] = full
            release = next(((t, k) for t, k, a in ev if k in ("hquiet", "hcap") and t >= t_map), None)
            if release:
                out["release_ms"] = round(release[0], 1)
                out["release_by"] = "quiet" if release[1] == "hquiet" else "cap"
        broken = []
        if up is None or up > 100:
            broken.append("1 answer")
        if not mapped or down is None:
            broken.append("2 finish")
        if os.path.exists(clip) and os.path.getsize(clip) > 0:
            left, right = panel_stats(clip, *LEFT), panel_stats(clip, *RIGHT)
            out["empty"] = {"left": empty(left), "right": empty(right)}
            out["flicker"] = {"left": flicker(left), "right": flicker(right)}
            if out["empty"]["left"]:
                broken.append("3 empty")
            if out["flicker"]["left"] or out["flicker"]["right"]:
                broken.append("4 flicker")
            if out["empty"]["right"]:
                broken.append("O other panel")
        else:
            broken.append("no recording")
        if mapped and out.get("unmaps"):
            broken.append("4 unmapped")
        # What the curtain covered was never seen: a window laid out under it
        # is in place when it lifts. Moved after that, the user saw it move.
        if mapped and out["boxes"]:
            shown = down if down is not None else out["map_ms"]
            if any(t > shown + 1 for t, _ in out["boxes"]):
                broken.append("5 moved")
            placed = out["boxes"][-1][0]
            out["curtain_after_placed_ms"] = round(down - placed, 1) if down is not None else None
            # Late against the moment the window was shown: phoc lets a new
            # window go once its client has laid itself out for its panel
            # (phoc-patches/0017), and the curtain is to follow within two
            # frames. Without the probe, against the last move.
            shown_at = out.get("release_ms", placed)
            if down is not None and down - shown_at > 2 * FRAME_MS:
                broken.append("6 curtain late")
        out["broken"] = broken
        return out

    # -- beyond the launch (#209) --

    def _session(self):
        return f"sudo -u droidian {SESSION}"

    def _launch_now(self, desktop, side, wait=4):
        """Start an app on a panel through the dock, outside any recording."""
        self.sh(f"echo '{desktop}.desktop {side}' > /run/user/32011/sfduo-launch; "
                f"kill -USR2 $(pgrep -x sfduo-dock); sleep {wait}", check=False)

    def _windows(self):
        """app_id: title of every window, as wlrctl lists them."""
        out = self.sh(f"{self._session()} wlrctl toplevel list", check=False)
        return sorted(line.strip() for line in out.splitlines() if ":" in line)

    def _reset(self, apps):
        """Every window of these apps closed, and their processes gone
        unless they always run."""
        cmds = []
        for kind in apps:
            desktop, app, process, resident = LINUX_APPS[kind]
            cmds.append(f"{self._session()} wlrctl toplevel close app_id:{app} 2>/dev/null")
            if not resident:
                cmds.append(f"pkill -x {process[:15]}")
        self.sh("; ".join(cmds) + "; sleep 2.5", check=False)

    def _episode(self, name, action, seconds=6):
        """Record one action: probes on phoc and a 60 fps recording of the
        screen, the action's start marked `request`. Returns what was seen:
        the events (ms from the request), both panels' frames on the
        recording, and the clip."""
        clips = os.path.join(RESULTS, "clips")
        os.makedirs(clips, exist_ok=True)
        before = ("rm -f /tmp/sfduo-look.mp4; "
                  f"timeout -s INT {seconds + 2} {self._session()} wf-recorder -r 60 "
                  f"-F scale=iw/{VIDEO_SCALE}:ih/{VIDEO_SCALE} -f /tmp/sfduo-look.mp4 >/dev/null 2>&1 & W=$!; "
                  "sleep 1; D=$(pgrep -x sfduo-dock); "
                  "T=$(python3 -c 'import time;print(time.monotonic())'); echo mark request $T; "
                  f"{action}; sleep {seconds - 1}; kill -INT $W; wait $W")
        found, lines = self.capture(["frame", "lmap", "lunmap", "lcommit", "vmap", "vunmap",
                                     "vpos", "vsize", "hquiet", "hcap"],
                                    seconds=seconds + 2, before=before)
        request = next(float(l[2]) * 1000 for l in lines if l[:2] == ["mark", "request"])
        clip = os.path.join(clips, f"{datetime.datetime.now():%Y-%m-%d-%H%M%S}-{name}.mp4")
        subprocess.run(["scp", "-q", f"{self.host}:/tmp/sfduo-look.mp4", clip], check=False)
        seen = {"request": request, "clip": clip,
                "events": [(t - request, k, a) for t, k, a in self.events if t >= request - 50],
                "frames": [t - request for t in found["frame"] if t >= request]}
        if os.path.exists(clip) and os.path.getsize(clip) > 0:
            seen["left"], seen["right"] = panel_stats(clip, *LEFT), panel_stats(clip, *RIGHT)
        return seen

    @staticmethod
    def _views(ev):
        """Each window's changes of place and size (only real changes), its
        maps and its unmaps, by its address."""
        views = {}
        for t, k, a in ev:
            view = a.get("view_x64") or a.get("self_x64")
            if view is None or k not in ("vpos", "vsize", "vmap", "vunmap"):
                continue
            v = views.setdefault(view, {"boxes": [], "box": {}, "maps": [], "unmaps": []})
            if k == "vmap":
                v["maps"].append(round(t, 1))
            elif k == "vunmap":
                v["unmaps"].append(round(t, 1))
            else:
                if k == "vpos":
                    v["box"].update(x=int(a["x_s32"]), y=int(a["y_s32"]))
                else:
                    v["box"].update(w=int(a["width_s32"]), h=int(a["height_s32"]))
                if not v["boxes"] or v["boxes"][-1][1] != v["box"]:
                    v["boxes"].append((round(t, 1), dict(v["box"])))
        for v in views.values():
            del v["box"]
        return views

    @staticmethod
    def _panels(seen, out, broken, acting):
        """The recording's verdict: flicker on either panel, an empty frame
        on either - the panel the action is on (`acting`) and the other."""
        if "left" not in seen:
            broken.append("no recording")
            return
        other = "right" if acting == "left" else "left"
        out["flicker"] = {side: flicker(seen[side]) for side in ("left", "right")}
        out["empty"] = {side: empty(seen[side]) for side in ("left", "right")}
        if out["flicker"][acting] or out["empty"][acting]:
            broken.append("flicker or empty frame")
        if out["flicker"][other] or out["empty"][other]:
            broken.append("O other panel")

    def _motion(self, seen, out, broken):
        m = motion_metrics([t for t in seen["frames"]], 0)
        if m:
            out["motion"] = m
            if m["dropped"]:
                broken.append("frames dropped")

    def move(self):
        """An open app called to the other panel from that panel's dock
        (#200, #201): the slide's frames, no window hidden or shown twice,
        the window at its new panel's corner, and the same windows - the
        pages that follow it - with the same titles afterwards."""
        rows = []
        for kind in self.selected(MOVE_APPS):
            desktop, app, process, resident = LINUX_APPS[kind]
            for rep in range(self.reps):
                self.check_unlocked()
                self._reset([kind])
                self._launch_now(desktop, "left")
                windows = self._windows()
                seen = self._episode(f"move-{kind}-{rep}",
                                     f"echo '{desktop}.desktop right' > /run/user/32011/sfduo-launch; kill -USR2 $D")
                after = self._windows()
                out, broken = {"clip": os.path.basename(seen["clip"])}, []
                self._motion(seen, out, broken)
                self._panels(seen, out, broken, "right")
                views = self._views(seen["events"])
                out["unmaps"] = sum(len(v["unmaps"]) for v in views.values())
                if out["unmaps"]:
                    broken.append("window hidden")
                finals = [v["boxes"][-1][1] for v in views.values() if v["boxes"]]
                out["finals"] = finals
                # the right panel starts past the hinge: a window's surface
                # there, shadow and all, starts well right of the middle
                if finals and not all(b.get("x", 0) > SCREEN_LOGICAL_WIDTH // 2 - 60 for b in finals):
                    broken.append("not on the other panel")
                out["windows_before"], out["windows_after"] = windows, after
                if windows != after:
                    broken.append("windows changed")
                out["broken"] = broken
                rows.append(self.record("move", app=kind, rep=rep, **out))
                self._reset([kind])
        return rows

    def close(self):
        """An open app closed (#202): its going's frames, the other panel
        steady, the dock back."""
        rows = []
        for kind in self.selected(MOVE_APPS):
            desktop, app, process, resident = LINUX_APPS[kind]
            for rep in range(self.reps):
                self.check_unlocked()
                self._reset([kind])
                self._launch_now(desktop, "left")
                seen = self._episode(f"close-{kind}-{rep}",
                                     f"{self._session()} wlrctl toplevel close app_id:{app}")
                out, broken = {"clip": os.path.basename(seen["clip"])}, []
                self._motion(seen, out, broken)
                self._panels(seen, out, broken, "left")
                if any(app in w for w in self._windows()):
                    broken.append("still open")
                out["broken"] = broken
                rows.append(self.record("close", app=kind, rep=rep, **out))
                self._reset([kind])
        return rows

    def beside(self):
        """An app launched onto the left panel with Clock open on the right:
        Clock's window neither moved nor hidden, the right panel steady."""
        rows = []
        neighbour = LINUX_APPS["clock"]
        for kind in self.selected(MOVE_APPS):
            if kind == "clock":
                continue
            desktop, app, process, resident = LINUX_APPS[kind]
            for rep in range(self.reps):
                self.check_unlocked()
                self._reset([kind, "clock"])
                self._launch_now(neighbour[0], "right")
                seen = self._episode(f"beside-{kind}-{rep}",
                                     f"echo '{desktop}.desktop left' > /run/user/32011/sfduo-launch; kill -USR2 $D")
                out, broken = {"clip": os.path.basename(seen["clip"])}, []
                self._panels(seen, out, broken, "left")
                views = self._views(seen["events"])
                mapped = {a["self_x64"] for t, k, a in seen["events"] if k == "vmap"}
                others = {v: d for v, d in views.items() if v not in mapped}
                # a window seen for the first time here has one box that is
                # only where it already was; a second one is a move
                out["other_changes"] = sum(max(0, len(d["boxes"]) - 1) + len(d["unmaps"])
                                           for d in others.values())
                if out["other_changes"]:
                    broken.append("the other app touched")
                out["broken"] = broken
                rows.append(self.record("beside", app=kind, rep=rep, **out))
                self._reset([kind, "clock"])
        return rows

    def restore(self):
        """A running app, minimized, brought back by its icon in the dock:
        the time to its first frame on the panel, and no empty frame."""
        rows = []
        for kind in self.selected(MOVE_APPS):
            desktop, app, process, resident = LINUX_APPS[kind]
            for rep in range(self.reps):
                self.check_unlocked()
                self._reset([kind])
                self._launch_now(desktop, "left")
                self.sh(f"{self._session()} wlrctl toplevel minimize app_id:{app}; sleep 2", check=False)
                seen = self._episode(f"restore-{kind}-{rep}",
                                     f"echo '{desktop}.desktop left' > /run/user/32011/sfduo-launch; kill -USR2 $D")
                out, broken = {"clip": os.path.basename(seen["clip"])}, []
                self._panels(seen, out, broken, "left")
                # back on the panel when phoc lets it go (Restore shows it at
                # its first frame, phoc-patches/0015), and the output frame
                # that carries it
                shown = next((t for t, k, a in seen["events"] if k in ("hquiet", "hcap") and t >= 0), None)
                if shown is not None:
                    out["shown_ms"] = round(shown, 1)
                    frame = next((t for t in seen["frames"] if t >= shown), None)
                    if frame is not None:
                        out["to_frame_ms"] = round(frame, 1)
                else:
                    broken.append("no release seen")
                if not any(app in w for w in self._windows()):
                    broken.append("not back")
                out["broken"] = broken
                rows.append(self.record("restore", app=kind, rep=rep, **out))
                self._reset([kind])
        return rows


