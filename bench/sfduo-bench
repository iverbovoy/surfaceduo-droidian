# The recording: the whole output scaled to a quarter, 696 x 450 - the left
# panel is x < 338, the right x > 358 (the hinge's gap between them).
VIDEO_SCALE = 4
LEFT = (0, 337)
RIGHT = (359, 696)


def panel_stats(video, x0, x1):
    """Per recorded frame of one panel: (pts s, mean luma, min, max)."""
    width = x1 - x0
    done = subprocess.run(
        ["ffmpeg", "-v", "error", "-i", video, "-vf",
         f"crop={width}:450:{x0}:0,signalstats,metadata=print:file=-", "-f", "null", "-"],
        capture_output=True, text=True)
    frames, cur = [], {}
    for line in done.stdout.splitlines():
        m = re.match(r"frame:\d+\s+pts:\d+\s+pts_time:([\d.]+)", line)
        if m:
            if cur:
                frames.append(cur)
            cur = {"t": float(m.group(1))}
            continue
        m = re.match(r"lavfi\.signalstats\.(YAVG|YMIN|YMAX)=([\d.]+)", line)
        if m:
            cur[m.group(1)] = float(m.group(2))
    if cur:
        frames.append(cur)
    return frames


def flicker(frames, threshold=12):
    """Frames where a panel's brightness jumps and comes straight back:
    A, B, A with B more than `threshold` away from both."""
    hits = []
    for a, b, c in zip(frames, frames[1:], frames[2:]):
        if abs(b["YAVG"] - a["YAVG"]) > threshold and abs(c["YAVG"] - a["YAVG"]) < threshold / 3:
            hits.append(round(b["t"], 3))
    return hits


def empty(frames):
    """Frames with nothing on the panel: all of it one level (no icon, no
    text), black or not."""
    return [round(f["t"], 3) for f in frames if f.get("YMAX", 255) - f.get("YMIN", 0) < 8]


# ---- Android ------------------------------------------------------------------

# Candidates for each kind, the first one installed is used. The Duos ship
# Microsoft's and Google's apps; which is there differs by model and update.
ANDROID_APPS = {
    "settings": ["com.android.settings"],
    "calculator": ["com.google.android.calculator", "com.android.calculator2",
                   "com.microsoft.math"],
    "clock": ["com.google.android.deskclock", "com.android.deskclock"],
    "contacts": ["com.google.android.contacts", "com.android.contacts"],
    "phone": ["com.google.android.dialer", "com.android.dialer"],
    "messages": ["com.google.android.apps.messaging", "com.android.messaging"],
    "calendar": ["com.google.android.calendar", "com.microsoft.office.outlook"],
    "weather": ["com.microsoft.amp.apps.bingweather"],
    "browser": ["com.microsoft.emmx", "com.android.chrome"],
    "camera": ["com.microsoft.surface.camera", "com.android.camera2",
               "com.google.android.GoogleCamera"],
}
ANDROID_RESIDENT = {"clock", "phone", "messages"}      # as on the port

class Android(Target):
    name = "android"

    def __init__(self, reps, serial):
        self.serial = serial
        super().__init__(reps)

    def adb(self, *args, timeout=120):
        command = ["adb"] + (["-s", self.serial] if self.serial else []) + list(args)
        done = subprocess.run(command, capture_output=True, text=True, timeout=timeout)
        if done.returncode != 0:
            die(f"adb {' '.join(args)[:60]}: {done.stderr.strip()[-300:]}")
        return done.stdout

    def preflight(self):
        model = self.adb("shell", "getprop", "ro.product.model").strip()
        self.name = "android-" + re.sub(r"\W+", "-", model.lower()).strip("-")
        self.out = os.path.join(RESULTS, f"{datetime.date.today().isoformat()}-{self.name}.jsonl")
        self.battery = int(re.search(r"level: (\d+)", self.adb("shell", "dumpsys", "battery")).group(1))

    def sh(self, command, timeout=120):
        return self.adb("shell", command, timeout=timeout)

    def installed(self):
        if not hasattr(self, "_packages"):
            self._packages = {line.split(":", 1)[1].strip()
                              for line in self.sh("pm list packages").splitlines() if ":" in line}
        return self._packages

    def apps(self):
        """Each kind's app on this device: the first candidate installed."""
        found = {}
        for kind, candidates in ANDROID_APPS.items():
            for package in candidates:
                if package in self.installed():
                    found[kind] = package
                    break
        return found

    def component(self, package):
        out = self.sh(f"cmd package resolve-activity --brief -c android.intent.category.LAUNCHER {package}")
        lines = [l.strip() for l in out.splitlines() if "/" in l]
        if not lines:
            die(f"{package} has no launcher activity")
        return lines[-1]

    def launch(self):
        rows = []
        for kind, package in self.apps().items():
            component = self.component(package)
            resident = kind in ANDROID_RESIDENT
            for rep in range(self.reps):
                self.sh("input keyevent KEYCODE_HOME; sleep 1")
                if not resident:
                    self.sh(f"am force-stop {package}")
                running = bool(self.sh(f"pidof {package} || true").strip())
                self.sh("sleep 2")
                out = self.sh(f"am start -W -n {component}")
                total = re.search(r"TotalTime: (\d+)", out)
                rows.append(self.record("launch", app=kind, id=package, rep=rep,
                                        resident=running, battery=self.battery,
                                        to_frame_ms=int(total.group(1)) if total else None))
            self.sh("input keyevent KEYCODE_HOME")
        return rows

    def layer_frames(self, match):
        """SurfaceFlinger's present times (ms) of the layer whose name
        contains `match`, for the frames since the last clear."""
        layers = [l for l in self.sh("dumpsys SurfaceFlinger --list").splitlines() if match in l]
        frames = []
        for layer in layers:
            out = self.sh(f"dumpsys SurfaceFlinger --latency {shlex.quote(layer)}")
            for line in out.splitlines()[1:]:
                parts = line.split()
                if len(parts) == 3 and parts[1] != "0" and int(parts[1]) < 2 ** 62:
                    frames.append(int(parts[1]) / 1e6)
        return sorted(set(frames))

    def grid(self):
        width, height = (int(v) for v in re.search(r"(\d+)x(\d+)",
                                                     self.sh("wm size")).groups()[-2:])
        x = width // 4                  # the middle of the left screen
        launcher = self.sh("cmd package resolve-activity --brief -c android.intent.category.HOME "
                           "android.intent.action.MAIN").splitlines()[-1].split("/")[0].strip()
        rows = []
        self.sh("input keyevent KEYCODE_HOME; sleep 1")
        for rep in range(self.reps):
            for motion, (y0, y1) in (("open", (int(height * 0.85), int(height * 0.45))),
                                     ("close", (int(height * 0.35), int(height * 0.75)))):
                self.sh("dumpsys SurfaceFlinger --latency-clear")
                self.sh(f"input swipe {x} {y0} {x} {y1} 200; sleep 1.2")
                frames = self.layer_frames(launcher)
                m = motion_metrics(frames, frames[0]) if frames else None
                rows.append(self.record("grid", motion=motion, rep=rep, battery=self.battery,
                                        launcher=launcher, **(m or {"frames": 0})))
        return rows


# ---- reading results back ------------------------------------------------------

def report(paths):
    rows = []
    for path in paths:
        with open(path) as fp:
            rows += [json.loads(line) for line in fp if line.strip()]
    groups = {}
    for row in rows:
        if row["scenario"] in ("launch", "restore"):
            key = (row["scenario"], row["app"])
            value = row.get("to_frame_ms")
        elif row["scenario"] == "grid":
            key = ("grid", row.get("motion", ""))
            value = row.get("dropped")
        elif isinstance(row.get("motion"), dict):
            key = (row["scenario"], row["app"])
            value = row["motion"].get("dropped")
        else:
            key = (row["scenario"], row.get("app", ""))
            value = len(row.get("broken", []))
        groups.setdefault(key, {}).setdefault(row["target"], []).append(value)
    targets = sorted({row["target"] for row in rows})
    print("%-24s" % "" + "".join("%22s" % t for t in targets))
    for key in sorted(groups):
        unit = {"launch": "ms", "restore": "ms", "look": "broken", "beside": "broken"}.get(key[0], "dropped")
        label = " ".join(key) + f"  ({unit})"
        cells = []
        for t in targets:
            values = [v for v in groups[key].get(t, []) if v is not None]
            cells.append("%22s" % (f"{statistics.median(values):.0f} [{min(values):.0f}-{max(values):.0f}] n={len(values)}"
                                   if values else "-"))
        print("%-24s" % label + "".join(cells))


def main(argv):
    parser = argparse.ArgumentParser(prog="sfduo-bench", description=__doc__.split("\n")[0])
    parser.add_argument("target", choices=("linux", "android", "report"))
    parser.add_argument("what", nargs="+", help="scenarios, or result files for report")
    parser.add_argument("--reps", type=int, default=10)
    parser.add_argument("--host", default="root@172.16.42.1")
    parser.add_argument("--serial")
    parser.add_argument("--apps", help="comma-separated kinds, e.g. settings,camera")
    args = parser.parse_args(argv)
    if args.target == "report":
        report(args.what)
        return
    target = Linux(args.reps, args.host) if args.target == "linux" else Android(args.reps, args.serial)
    target.only = set(args.apps.split(",")) if args.apps else None
    target.preflight()
    for scenario in args.what:
        if not hasattr(target, scenario) or scenario.startswith("_"):
            die(f"no scenario {scenario}")
        rows = getattr(target, scenario)()
        print(f"{scenario}: {len(rows)} measurements -> {target.out}")
    report([target.out])


if __name__ == "__main__":
    main(sys.argv[1:])
