# Microsoft's surfaceduo_defconfig is their debug configuration, and it is
# what this port builds: the perf one beside it (surfaceduo-perf_defconfig)
# also drops things the port stands on - the backlight class, the GENI
# console, serdev - so it is not used as the base. This fragment turns off
# only what was measured to cost, and only what is debugging. Applied after
# surfaceduo.config (kernel-info.mk, KERNEL_CONFIG_EXTRA_FRAGMENTS).
#
# What it cost, on the device, with all of this on (2026-09-18, screen on,
# schedutil - most of what was first blamed on it was the powersave governor
# a blanked screen brings): 3000 fork+exec 26 s against 11 s without, a boot
# to ssh in about twice the time, Slab 605 MB against 182 MB; every slab
# cache with sanity checks, red zones, poisoning and user tracking, every
# freed page filled with a pattern and every allocated one verified.
#
# Kept on purpose: DEBUG_LIST, BUG_ON/PANIC_ON_DATA_CORRUPTION, the soft
# lockup and workqueue watchdogs, FUNCTION_TRACER, DYNAMIC_DEBUG, QCOM_RTB
# and pstore - cheap, and they are what docs/FREEZE-FORENSICS.md leans on.
#
# NOTE: merge_config.sh parses any "# CONFIG_FOO ..." line as an unset
# directive - never name a config option first thing in a comment here.

# slab: poison, red zones, user tracking on every cache (and slub_debug=- was
# the cmdline half of this)
CONFIG_SLUB_DEBUG_ON=n
CONFIG_SLUB_DEBUG_PANIC_ON=n

# pages: poisoning and page-alloc debugging were already off by cmdline
# (page_poison=off debug_pagealloc=off); the code and its checks stay
# compiled in until they are off here
CONFIG_DEBUG_PAGEALLOC=n
CONFIG_DEBUG_PAGEALLOC_ENABLE_DEFAULT=n
CONFIG_PAGE_POISONING=n
CONFIG_PAGE_POISONING_ENABLE_DEFAULT=n
CONFIG_PAGE_OWNER=n
CONFIG_PAGE_OWNER_ENABLE_DEFAULT=n

# object lifetime tracking, leak detection, stack checks
CONFIG_DEBUG_OBJECTS=n
CONFIG_DEBUG_KMEMLEAK=n
CONFIG_DEBUG_STACK_USAGE=n
CONFIG_DEBUG_MEMORY_INIT=n
CONFIG_SCHED_STACK_END_CHECK=n
CONFIG_HARDENED_USERCOPY_PAGESPAN=n

# locks: a check on every spin lock and mutex, and pid 1 was measured in
# spin unlock
CONFIG_DEBUG_SPINLOCK=n
CONFIG_DEBUG_MUTEXES=n
CONFIG_DEBUG_ATOMIC_SLEEP=n

# per-call checks in scatterlists, notifier chains, credentials
CONFIG_DEBUG_SG=n
CONFIG_DEBUG_NOTIFIERS=n
CONFIG_DEBUG_CREDENTIALS=n

# fault injection and self-tests - never used on this port
CONFIG_FAULT_INJECTION=n
CONFIG_FAIL_PAGE_ALLOC=n
CONFIG_UFS_FAULT_INJECTION=n
CONFIG_FAULT_INJECTION_DEBUG_FS=n
CONFIG_FAULT_INJECTION_STACKTRACE_FILTER=n
CONFIG_LOCK_TORTURE_TEST=n
CONFIG_RCU_TORTURE_TEST=n
CONFIG_LKDTM=n
CONFIG_ATOMIC64_SELFTEST=n
CONFIG_TEST_USER_COPY=n
CONFIG_MEMTEST=n

# vendor debug ring buffers and refcount tracing
CONFIG_DEBUG_DMA_BUF_REF=n
CONFIG_QCOM_GPI_DMA_DEBUG=n
CONFIG_SCSI_UFSHCD_CMD_LOGGING=n

# tracers that hook every irq-off and preempt-off transition
CONFIG_IRQSOFF_TRACER=n
CONFIG_PREEMPT_TRACER=n
CONFIG_PREEMPTIRQ_EVENTS=n
