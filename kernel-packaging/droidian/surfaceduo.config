# Device fragment for the Microsoft Surface Duo (surfaceduo, SM8150).
# Applied by kernel-snippet.mk on top of vendor/surfaceduo_defconfig,
# together with the common 4.14-android fragments (halium.config,
# droidian.config, container.config).
#
# NOTE: merge_config.sh parses any "# CONFIG_FOO ..." line as an unset
# directive - never name a config option first thing in a comment here.
#
# The stock defconfig already enables the DT overlay build, binder and
# the device drivers (touch, sensors, WLAN), so only genuine deltas
# live in this fragment.

# Overlay build OFF: the in-tree dtc cannot compile the .dtbo overlays
# (MS built them with the Android prebuilt dtc), and we don't need them -
# the stock dtbo partition stays on the device and ABL merges its overlay
# onto our base DTB by board-id, exactly as with the stock boot.img.
# With this off the DTS Makefile builds the same per-revision base DTBs
# (dv/ev1/ev1.5/ev2/ev2-1 x a/b/c) directly.
CONFIG_BUILD_ARM64_DT_OVERLAY=n

# Touch: Duo 1 touch is Microsoft D5 over HID-over-SPI (drivers/hid/spi-hid,
# DT node d5_hid@0 on spi@89c000 - present in the merged DT via stock dtbo).
# Stock builds it =m, but the droidian image ships no /lib/modules and the
# kernel enforces module signatures (SIG_FORCE), so build it in.
CONFIG_SPI_HID=y

# Let the stock vendor modules load (wifi, audio): the vendor partition
# ships /vendor/lib/modules/*.ko built for this exact 4.14-190 tree
# (qca_cld3_wlan, audio_*), signed with Microsoft's key. Keep signing on
# but stop refusing foreign/unsigned modules - they load with a taint
# flag instead. Without this, WiFi has no driver at all (qcacld source
# is not in the OSS drop, only the icnss platform glue is built in).
CONFIG_MODULE_SIG_FORCE=n

# pstore: keep the last kernel console log across a crash - our kernels
# have a history of dying mid-boot with no console, this is the cheapest
# black box we can get.
# NOTE (2026-07-11): these options are INERT with the stock-extracted DTB
# (no ramoops node in it, none in the downstream Duo DTS either). The node
# was added binarily (fdtput) at 0xa4b00000 (+0x100000, a free hole between
# the qseecom and cdsp_sec carveouts) -> out/dtb-sm8150v2-stock-ramoops.dtb,
# packaged as out/boot-duo1-droidian-v3-ramoops.img. Test v3 as its own
# change only after v2+ssh is confirmed. Read crash logs: /sys/fs/pstore/.
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_RAM_ANNOTATION_APPEND=y
