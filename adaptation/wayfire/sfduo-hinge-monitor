#!/bin/sh
# sfduo-hinge-monitor: stream the hinge angle for the waybar custom module.
# sfduo-livebg owns the sensorfw session and writes every angle change to
# $XDG_RUNTIME_DIR/sfduo-hinge (atomic rename); we follow the file BUT
# rate-limit to 2 Hz: per-degree waybar re-renders made the whole display
# blink during hinge motion (top layer + exclusive zone commits appear to
# be expensive on the droidian hwcomposer stack).
F="${XDG_RUNTIME_DIR:-/run/user/32011}/sfduo-hinge"
LAST=""
while :; do
    V=$(cat "$F" 2>/dev/null)
    if [ -n "$V" ] && [ "$V" != "$LAST" ]; then
        echo "$V"
        LAST="$V"
    fi
    sleep 0.5
done
