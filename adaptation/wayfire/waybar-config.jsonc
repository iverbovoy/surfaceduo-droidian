{
    "layer": "top",
    "position": "top",
    "height": 44,
    "width": 0,
    "margin-right": 717,
    "spacing": 8,
    "modules-left": ["custom/launcher", "custom/kbd", "custom/swap"],
    "modules-center": ["clock"],
    "modules-right": ["custom/hinge", "network", "battery"],
    "custom/launcher": {
        "format": "  ☰ apps  ",
        "on-click": "/usr/local/bin/sfduo-launcher-toggle"
    },
    "custom/kbd": {
        "format": "  ⌨ kbd  ",
        "on-click": "/usr/local/bin/sfduo-kbd-toggle"
    },
    "custom/swap": {
        "format": "  ⇄ swap  ",
        "on-click": "/usr/local/bin/sfduo-swap"
    },
    "clock": {
        "format": "{:%H:%M}"
    },
    "custom/hinge": {
        "exec": "/usr/local/bin/sfduo-hinge-monitor",
        "format": "⌒ {}"
    },
    "network": {
        "format-wifi": "  {essid}",
        "format-disconnected": "no net"
    },
    "battery": {
        "format": "{capacity}%"
    }
}
