{
    "layer": "top",
    "position": "top",
    "height": 44,
    "width": 0,
    "spacing": 8,
    "modules-left": ["custom/launcher", "custom/kbd", "custom/swap", "custom/bg", "wlr/taskbar"],
    "modules-right": ["custom/hinge", "network", "clock", "battery"],
    "custom/launcher": {
        "format": "  ☰ apps  ",
        "on-click": "/usr/local/bin/sfduo-launcher-toggle"
    },
    "custom/kbd": {
        "format": "  ⌨ kbd  ",
        "on-click": "/usr/local/bin/sfduo-kbd-toggle"
    },
    "custom/swap": {
        "format": "  ⇄ swap  ",
        "on-click": "/usr/local/bin/sfduo-swap"
    },
    "custom/bg": {
        "format": "  ◐ bg  ",
        "on-click": "/usr/local/bin/sfduo-bg-toggle"
    },
    "wlr/taskbar": {
        "format": "{icon} {title:.10}",
        "icon-size": 22,
        "on-click": "activate",
        "on-click-right": "close"
    },
    "clock": {
        "format": "{:%H:%M}"
    },
    "custom/hinge": {
        "exec": "/usr/local/bin/sfduo-hinge-monitor",
        "format": "⌒ {}"
    },
    "network": {
        "format-wifi": "  {essid}",
        "format-disconnected": "no net"
    },
    "battery": {
        "format": "{capacity}%"
    }
}
