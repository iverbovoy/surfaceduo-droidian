#!/usr/bin/python3
# sfduo-tiler: hinge-aware auto-tiler for the Surface Duo wayfire session.
# Every new toplevel is snapped to the emptier panel, and any window that
# ends up covering the hinge (self-maximizing apps, fullscreen requests)
# is re-snapped to its nearest panel. Zones in logical coords
# (2784x1800 @ scale 2): left [0,675], hinge [675,717], right [717,1392].
import socket, json, struct, os, sys, time

SOCK = os.environ.get("WAYFIRE_SOCKET", "/run/user/32011/wayfire-wayland-0-.socket")
LEFT  = {"x": 0,   "y": 44, "width": 675, "height": 856}  # y offset: waybar
RIGHT = {"x": 717, "y": 44, "width": 675, "height": 856}  # bar spans both panels
HINGE_L, HINGE_R = 675, 717
HINGE_MID = (HINGE_L + HINGE_R) // 2
LOG = os.path.expanduser("~/.cache/sfduo-tiler.log")

def log(*a):
    with open(LOG, "a") as f:
        f.write(time.strftime("%H:%M:%S ") + " ".join(str(x) for x in a) + "\n")

class Ipc:
    def __init__(self, path):
        self.s = socket.socket(socket.AF_UNIX)
        self.s.connect(path)
        self.events = []
    def _read(self):
        hdr = b""
        while len(hdr) < 4:
            c = self.s.recv(4 - len(hdr))
            if not c: raise ConnectionError("eof")
            hdr += c
        n = struct.unpack("<I", hdr)[0]
        buf = b""
        while len(buf) < n:
            c = self.s.recv(n - len(buf))
            if not c: raise ConnectionError("eof")
            buf += c
        return json.loads(buf)
    def request(self, method, data=None):
        b = json.dumps({"method": method, "data": data or {}}).encode()
        self.s.sendall(struct.pack("<I", len(b)) + b)
        while True:
            m = self._read()
            if isinstance(m, dict) and "event" in m: self.events.append(m)
            else: return m
    def next_event(self):
        if self.events: return self.events.pop(0)
        while True:
            m = self._read()
            if isinstance(m, dict) and "event" in m: return m

def list_views(ipc):
    r = ipc.request("window-rules/list-views")
    return r if isinstance(r, list) else r.get("views", [])

def zone_of(view):
    g = view.get("geometry") or {}
    cx = g.get("x", 0) + g.get("width", 0) / 2
    return "L" if cx < HINGE_MID else "R"

def covers_hinge(g):
    x0 = g.get("x", 0)
    x1 = x0 + g.get("width", 0)
    return x0 < HINGE_R and x1 > HINGE_L

def is_tileable(v):
    return (v.get("role") == "toplevel" and v.get("mapped", True)
            and v.get("parent", -1) in (-1, 0)
            and v.get("type", "toplevel") == "toplevel")

def snap(ipc, vid, zone, why):
    ipc.request("window-rules/configure-view", {"id": vid, "geometry": zone})
    log(why, vid, "->", "L" if zone is LEFT else "R")

def place(ipc, view):
    vid = view["id"]
    others = [v for v in list_views(ipc) if is_tileable(v) and v["id"] != vid]
    nl = sum(1 for v in others if zone_of(v) == "L")
    nr = len(others) - nl
    zone = LEFT if nl <= nr else RIGHT
    snap(ipc, vid, zone, "placed app=%s (L=%d R=%d)" % (view.get("app-id"), nl, nr))

def main():
    time.sleep(1)
    ipc = Ipc(SOCK)
    ipc.request("window-rules/events/watch",
                {"events": ["view-mapped", "view-tiled", "view-fullscreen",
                            "view-geometry-changed"]})
    log("tiler v2 up, socket", SOCK)
    for v in list_views(ipc):
        if is_tileable(v):
            place(ipc, v)
    last_fix = {}
    while True:
        ev = ipc.next_event()
        v = ev.get("view") or {}
        if not is_tileable(v):
            continue
        kind = ev.get("event")
        if kind == "view-mapped":
            place(ipc, v)
        else:
            # maximize / fullscreen / drags that end on the seam
            g = v.get("geometry") or {}
            if covers_hinge(g):
                now = time.time()
                if now - last_fix.get(v["id"], 0) > 0.5:  # damp re-snap loops
                    last_fix[v["id"]] = now
                    zone = LEFT if (g.get("x", 0) + g.get("width", 0) / 2) < HINGE_MID else RIGHT
                    snap(ipc, v["id"], zone, "re-snapped app=%s ev=%s" % (v.get("app-id"), kind))

if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        log("fatal:", repr(e))
        sys.exit(1)
