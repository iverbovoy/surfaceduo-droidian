#!/bin/sh
# sfduo-osk: launch the wvkbd on-screen keyboard on a SINGLE Duo panel so it
# does not straddle the 84 px hinge (keys near the seam get swallowed).
#
# The single-panel width is a wvkbd extension (`-w WIDTH`, see
# wvkbd-0.20-single-panel.patch). We probe for it: a patched binary parses
# `-w 675` and then prints its version (exit 0); a stock binary rejects `-w`
# (exit 1). So an un-rebuilt OSK simply keeps the old full-width behaviour
# instead of failing to start.
#
# -non-exclusive is REQUIRED alongside -w: the single-panel surface is
# anchored to 2 edges (bottom+left) and wayfire supports exclusive zones
# only for 1- or 3-edge anchors - with one set, it refuses to arrange the
# surface at all, so the keyboard exists but never becomes visible.
# Trade-off: windows don't auto-shrink above the OSK; it overlays them.
#
# 675 = left panel in logical coords (output 2784x1800 @ scale 2 -> 1392x900,
# left [0,675] | hinge [675,717] | right [717,1392]). Add --panel-right to
# pin it to the right panel instead. Height -L 260 matches the session.
KBD=/usr/local/bin/wvkbd-mobintl
PANEL_W=675

WIDTH_ARGS=""
if "$KBD" -w "$PANEL_W" -v >/dev/null 2>&1; then
    WIDTH_ARGS="-w $PANEL_W -non-exclusive"  # patched build: pin to the left panel
fi

exec "$KBD" -L 260 $WIDTH_ARGS --hidden
