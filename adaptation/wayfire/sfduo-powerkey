#!/usr/bin/python3
# sfduo-powerkey: power-button screen toggle for the wayfire-duo session.
# Phosh handles the power key itself; wayfire has no binding for it, which
# left the phone LOOKING dead (panels dark, button mute, system fine over
# ssh). Listens on the qpnp_pon evdev node (KEY_POWER only - the volume
# keys are dead at the kernel level on this port) and toggles panel power
# via sfduo-screens. Does not grab the device: long-press PMIC behaviour
# (hard reset) stays untouched.
import subprocess
import time

import evdev


def find_pon():
    for path in evdev.list_devices():
        d = evdev.InputDevice(path)
        if d.name == "qpnp_pon":
            return d
        d.close()
    raise SystemExit("sfduo-powerkey: qpnp_pon input device not found")


def main():
    dev = find_pon()
    last = 0.0
    for ev in dev.read_loop():
        if (ev.type == evdev.ecodes.EV_KEY
                and ev.code == evdev.ecodes.KEY_POWER and ev.value == 1):
            now = time.monotonic()
            if now - last < 0.4:  # debounce duplicate reports
                continue
            last = now
            subprocess.run(["/usr/local/sbin/sfduo-screens", "toggle"])


if __name__ == "__main__":
    main()
