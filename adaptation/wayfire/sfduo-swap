#!/usr/bin/python3
# sfduo-swap: exchange the two panels - every window on the left panel
# moves to the right one and vice versa (wayfire IPC). With two windows
# this is a clean swap; with one it just crosses the hinge. (V1 moved
# only the focused window, which stacked it over the neighbour and read
# as "my window disappeared" - exchange semantics match the button.)
# Same zone math as sfduo-tiler: logical 1392x900, left [0,675],
# hinge [675,717], right [717,1392]; left zone starts at y=44 (waybar).
import json
import os
import socket
import struct

SOCK = os.environ.get("WAYFIRE_SOCKET", "/run/user/32011/wayfire-wayland-0-.socket")
LEFT  = {"x": 0,   "y": 44, "width": 675, "height": 856}
RIGHT = {"x": 717, "y": 0, "width": 675, "height": 900}
HINGE_MID = (675 + 717) // 2


def request(s, method, data=None):
    b = json.dumps({"method": method, "data": data or {}}).encode()
    s.sendall(struct.pack("<I", len(b)) + b)
    while True:
        hdr = b""
        while len(hdr) < 4:
            c = s.recv(4 - len(hdr))
            if not c:
                raise ConnectionError("eof")
            hdr += c
        n = struct.unpack("<I", hdr)[0]
        buf = b""
        while len(buf) < n:
            c = s.recv(n - len(buf))
            if not c:
                raise ConnectionError("eof")
            buf += c
        m = json.loads(buf)
        if isinstance(m, dict) and "event" in m:
            continue  # stray event, not our reply
        return m


def is_tileable(v):
    return (v.get("role") == "toplevel" and v.get("mapped", True)
            and v.get("parent", -1) in (-1, 0))


def main():
    s = socket.socket(socket.AF_UNIX)
    s.connect(SOCK)
    views = request(s, "window-rules/list-views")
    if isinstance(views, dict):
        views = views.get("views", [])
    for v in views:
        if not is_tileable(v):
            continue
        g = v.get("geometry") or {}
        cx = g.get("x", 0) + g.get("width", 0) / 2
        zone = RIGHT if cx < HINGE_MID else LEFT
        request(s, "window-rules/configure-view",
                {"id": v["id"], "geometry": zone})


if __name__ == "__main__":
    main()
