+/* {{{ One window, the whole panel */
+/*
+ * The near half's bar reserves its height at the top of the output, and one
+ * output is both panels: every window loses those pixels, on either side.
+ * With one panel taken and the other free there is no need - the free half's
+ * bar can say it all - so the taken half's bar folds away, the other shows
+ * everything, and the reservation drops to a pixel. Which panels are taken
+ * is the dock's to say (org.sfduo.Dock "Busy": none, left, right or both);
+ * without a dock, and on the lock screen, the bars stay as they are.
+ */
+static void
+update_bar_modes (PhoshShell *self)
+{
+  PhoshShellPrivate *priv = phosh_shell_get_instance_private (self);
+  PhoshTopBarMode near = PHOSH_TOP_BAR_MODE_HALF, far = PHOSH_TOP_BAR_MODE_HALF;
+  g_autoptr (GVariant) value = NULL;
+  g_autofree char *owner = NULL;
+  const char *busy = "none";
+  guint exclusive = PHOSH_TOP_BAR_HEIGHT;
+
+  if (priv->top_panel == NULL || priv->top_panel_right == NULL)
+    return;
+
+  if (priv->dock_proxy && !priv->locked) {
+    owner = g_dbus_proxy_get_name_owner (priv->dock_proxy);
+    value = owner ? g_dbus_proxy_get_cached_property (priv->dock_proxy, "Busy") : NULL;
+    if (value && g_variant_is_of_type (value, G_VARIANT_TYPE_STRING))
+      busy = g_variant_get_string (value, NULL);
+  }
+
+  if (g_strcmp0 (busy, "left") == 0) {
+    near = PHOSH_TOP_BAR_MODE_NONE;
+    far = PHOSH_TOP_BAR_MODE_ALL;
+    exclusive = 1;
+  } else if (g_strcmp0 (busy, "right") == 0) {
+    near = PHOSH_TOP_BAR_MODE_ALL;
+    far = PHOSH_TOP_BAR_MODE_NONE;
+    exclusive = 1;
+  }
+  g_debug ("Busy: %s", busy);
+
+  phosh_top_panel_set_bar_mode (PHOSH_TOP_PANEL (priv->top_panel), near);
+  phosh_top_panel_set_bar_mode (PHOSH_TOP_PANEL (priv->top_panel_right), far);
+  if (priv->bar_exclusive != exclusive) {
+    priv->bar_exclusive = exclusive;
+    phosh_drag_surface_set_exclusive (priv->top_panel, exclusive);
+    phosh_layer_surface_wl_surface_commit (PHOSH_LAYER_SURFACE (priv->top_panel));
+  }
+}
