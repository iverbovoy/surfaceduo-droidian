 G_DEFINE_TYPE (PhoshSettings, phosh_settings, GTK_TYPE_BIN)
 
+static void update_drag_handle_offset (PhoshSettings *self);
+
+
+/*
+ * On a display with a seam each half has a shade of its own, and each does
+ * one job: the near one the settings - the sliders, the quick settings, the
+ * torch - and the far one what is going on - the media player and the
+ * notifications. The lock screen keeps both whole: phosh shows no player
+ * and no notifications in a shade there, and a far half that hid the rest
+ * would open onto nothing.
+ */
+static void
+apply_half (PhoshSettings *self)
+{
+  gboolean settings, bottom;
+
+  if (self->half == PHOSH_SETTINGS_HALF_WHOLE)
+    return;
+
+  settings = self->half == PHOSH_SETTINGS_HALF_NEAR || self->on_lockscreen;
+  bottom = self->half == PHOSH_SETTINGS_HALF_FAR && !self->on_lockscreen;
+
+  gtk_widget_set_visible (self->box_sliders, settings);
+  gtk_widget_set_visible (self->quick_settings, settings);
+  /* the revealer's own visibility is bound to the torch; its child is not */
+  gtk_widget_set_visible (gtk_bin_get_child (GTK_BIN (self->revealer)), settings);
+  gtk_widget_set_visible (self->box_bottom_half, bottom);
+  update_drag_handle_offset (self);
+}
+
 
 static void
 set_on_lockscreen (PhoshSettings *self, gboolean on_lockscreen)
@@ -577,6 +608,12 @@
                           G_BINDING_SYNC_CREATE | G_BINDING_INVERT_BOOLEAN);
 
   g_signal_connect (self, "size-allocate", G_CALLBACK (on_size_allocate), NULL);
+  /* The .ui binds the bottom half's visibility to on-lockscreen, and a
+   * notify is held back until g_object_set returns: calling this from the
+   * setter ran it before the binding, which then showed the bottom half on
+   * the near half again. Connected after the template's bindings, it runs
+   * after them. */
+  g_signal_connect (self, "notify::on-lockscreen", G_CALLBACK (apply_half), NULL);
   /* where the notification list is decides what a swipe up does */
   g_signal_connect_swapped (gtk_scrolled_window_get_vadjustment (GTK_SCROLLED_WINDOW (self->scrolled_window)),
                             "value-changed", G_CALLBACK (update_drag_handle_offset), self);
