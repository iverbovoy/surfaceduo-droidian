+/**
+ * phosh_settings_set_half:
+ * @self: The settings
+ * @half: Which half of the display this shade is on
+ *
+ * Deal the shade's contents out between the halves of a display with a
+ * seam. See `apply_half`.
+ */
+void
+phosh_settings_set_half (PhoshSettings *self, PhoshSettingsHalf half)
+{
+  g_return_if_fail (PHOSH_IS_SETTINGS (self));
+
+  self->half = half;
+  apply_half (self);
+}
