+/**
+ * phosh_top_panel_set_half:
+ * @self: The top panel
+ * @half: Which half of the display the panel is on
+ *
+ * The shade shows that half's share of the settings menu, and lock and
+ * power are the settings' - the far half keeps their places, so its clock
+ * stays centred, and draws and takes nothing there.
+ */
+void
+phosh_top_panel_set_half (PhoshTopPanel *self, PhoshSettingsHalf half)
+{
+  g_return_if_fail (PHOSH_IS_TOP_PANEL (self));
+
+  phosh_settings_set_half (PHOSH_SETTINGS (self->settings), half);
+  gtk_widget_set_child_visible (self->btn_lock, half != PHOSH_SETTINGS_HALF_FAR);
+  gtk_widget_set_child_visible (self->btn_power, half != PHOSH_SETTINGS_HALF_FAR);
+}
