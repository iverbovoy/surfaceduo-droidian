#!/bin/sh
# sfduo-phosh-install: put the port's patched phosh in place of the packaged
# one - or, with --restore, put the packaged one back and keep it there.
#
# The patched binary is phosh 0.49.0 at Droidian's cf38ab5 plus the patches
# 0001-0014 in adaptation/shell/phosh-patches of the port's repository: it
# tells logind it came up locked, it says LTE rather than 4G, its home
# overview lets go of the keyboard when a window opens, so windows can take
# the focus and be tiled, it gives a display with a seam down it a top
# bar and a shade per half - settings on the near one, notifications and
# the player on the far one - that folds from anywhere on it. It is built against exactly that package's
# libraries and resources, so it is installed only beside exactly that
# version. A phosh upgrade overwrites it with the new stock binary, which is
# the safe way for this to stop applying.
#
# The package's postinst runs this on every install and upgrade. A restore
# has to survive that, so --restore leaves a marker, and while the marker is
# there this script installs nothing. --patched removes the marker and puts
# the patched binary back.
#
# The dconf lock on sm.puri.phoc auto-maximize goes with the patched phosh:
# tiling a window to a panel needs auto-maximize off, and phosh turns it back
# on at every start unless the lock holds it. On the packaged phosh no window
# can be tiled (its home keeps the keyboard, so no window takes the focus),
# and the lock only leaves every window at its own size under the top bar -
# phoc refuses a maximize request for a window without the focus, so nothing
# else can put it right. So the lock is there exactly when the patched phosh
# is, and the packaged phosh maximizes windows itself, as it does anywhere.
#
# The hinge description goes with the patched binary for the same reason. It
# is a gmobile display-panel file naming the 84 physical pixels of hinge as a
# cutout; the patched phosh reads a cutout that runs the panel's whole height
# as a seam and splits the top bar on it. The packaged phosh reads the same
# file as a notch, applies its height as a top margin to the settings menu,
# and pushes the shade off the bottom of the display - pulled down it gives a
# black screen with nothing drawn in it. So the file is present exactly when
# the patched binary is.
set -e
OURS=/usr/lib/sfduo/phosh/phosh
WANT=$(cat /usr/lib/sfduo/phosh/version 2>/dev/null || true)
BIN=/usr/libexec/phosh
STOCK=/usr/libexec/phosh.stock
KEEP_STOCK=/etc/sfduo/phosh-stock
LOCK=/etc/dconf/db/local.d/locks/50-sfduo-phoc
PANELS=/usr/lib/sfduo/phosh/display-panels
# where G_RESOURCE_OVERLAYS in Droidian's phosh.service already points
PANELS_LIVE=/var/lib/droidian/phosh-notch

dock_can_run() {
    command -v wlrctl >/dev/null 2>&1 && command -v wtype >/dev/null 2>&1 &&
        python3 -c 'import gi; gi.require_version("GtkLayerShell", "0.1")' 2>/dev/null
}

tiling_lock() {
    # on: windows tile, off: phosh maximizes them (its own default)
    # Tiling is the dock's: with auto-maximize off and no dock to put windows
    # on a panel, every window stayed at its own size, floating over the
    # others - what a fresh image showed before `sfduo-shell-setup` had run.
    if [ "$1" = on ] && ! dock_can_run; then
        echo "sfduo-phosh: the dock cannot run yet - phosh maximizes windows until"
        echo "sfduo-phosh: \`sudo sfduo-shell-setup\` has installed what it needs"
        set -- off
    fi
    if [ "$1" = on ]; then
        [ -f "$LOCK" ] && return 0
        mkdir -p "$(dirname "$LOCK")"
        echo /sm/puri/phoc/auto-maximize > "$LOCK"
        echo "sfduo-phosh: auto-maximize locked off - windows tile to a panel"
    else
        [ -f "$LOCK" ] || return 0
        rm -f "$LOCK"
        echo "sfduo-phosh: auto-maximize lock dropped - the packaged phosh maximizes windows itself"
    fi
    command -v dconf >/dev/null 2>&1 && dconf update || true
}

hinge_description() {
    # on: the shell is told where the hinge is, off: it is not told at all
    [ -d "$PANELS" ] || return 0
    for panel in "$PANELS"/*.json; do
        [ -e "$panel" ] || continue
        live=$PANELS_LIVE/$(basename "$panel")
        if [ "$1" = on ]; then
            cmp -s "$panel" "$live" && continue
            mkdir -p "$PANELS_LIVE"
            cp -a "$panel" "$live.tmp" && mv -f "$live.tmp" "$live"
            echo "sfduo-phosh: hinge described to the shell ($live) - a top bar and a shade per half"
        else
            [ -e "$live" ] || continue
            rm -f "$live"
            echo "sfduo-phosh: hinge description withdrawn ($live) - one top bar across both halves"
        fi
    done
}

case "$1" in
--restore)
    [ -f "$STOCK" ] || { echo "sfduo-phosh: no $STOCK to restore" >&2; exit 1; }
    mkdir -p "$(dirname "$KEEP_STOCK")"
    : > "$KEEP_STOCK"
    if cmp -s "$STOCK" "$BIN"; then
        echo "sfduo-phosh: packaged phosh already in place; it now stays through package upgrades"
    else
        cp -a "$STOCK" "$BIN.tmp" && mv -f "$BIN.tmp" "$BIN"
        echo "sfduo-phosh: packaged phosh restored"
        echo "sfduo-phosh: it stays through package upgrades until 'sfduo-phosh-install --patched'"
    fi
    tiling_lock off
    hinge_description off
    echo "sfduo-phosh: restart the shell (sudo systemctl restart phosh). Only the phosh binary and"
    echo "sfduo-phosh: the tiling changed: the dock, the CSS and the black background are separate -"
    echo "sfduo-phosh: see adaptation/shell/README.md to turn them off. The packaged phosh does not"
    echo "sfduo-phosh: tell logind about its first lock screen: after a reboot the dock is visible"
    echo "sfduo-phosh: over it until the first unlock."
    exit 0
    ;;
--patched)
    rm -f "$KEEP_STOCK"
    ;;
"")
    if [ -f "$KEEP_STOCK" ]; then
        echo "sfduo-phosh: packaged phosh kept, as --restore asked ($KEEP_STOCK); 'sfduo-phosh-install --patched' undoes that"
        tiling_lock off
        hinge_description off
        exit 0
    fi
    ;;
*)
    echo "usage: sfduo-phosh-install [--restore | --patched]" >&2
    exit 2
    ;;
esac

[ -f "$OURS" ] && [ -n "$WANT" ] || { echo "sfduo-phosh: no patched binary in this package"; tiling_lock off; hinge_description off; exit 0; }
HAVE=$(dpkg-query -W -f='${Version}' phosh 2>/dev/null || true)
if [ "$HAVE" != "$WANT" ]; then
    echo "sfduo-phosh: phosh is $HAVE, the patched binary is for $WANT - left alone;"
    echo "sfduo-phosh: windows will not tile to a panel on this phosh (see adaptation/shell/README.md)"
    tiling_lock off
    hinge_description off
    exit 0
fi
if cmp -s "$OURS" "$BIN"; then
    echo "sfduo-phosh: patched phosh already in place"
    tiling_lock on
    hinge_description on
    exit 0
fi
# keep the packaged binary, once: never overwrite the copy with our own
[ -f "$STOCK" ] || cp -a "$BIN" "$STOCK"
# a running binary cannot be written over, only replaced
cp -a "$OURS" "$BIN.tmp" && chmod 755 "$BIN.tmp" && mv -f "$BIN.tmp" "$BIN"
tiling_lock on
hinge_description on
echo "sfduo-phosh: patched phosh installed (packaged one kept as $STOCK) - restart the shell (sudo systemctl restart phosh)"
