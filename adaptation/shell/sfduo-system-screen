def mix(a, b, t):
    return tuple(x + (y - x) * t for x, y in zip(a, b))


def ease_out(t):
    return 1 - (1 - t) ** 3


class Backdrop(Gtk.Widget):
    """The background: one colour node, whatever the colour is now. Also the
    veil over the content: the same colour at an alpha going from 1 to 0, so
    the content comes out of the background - one more colour node a frame,
    where an opacity over the content had GTK render the whole page into a
    texture of its own each frame and halved the frame rate (16.6 -> 33 ms)."""

    def __init__(self, alpha=1.0):
        super().__init__()
        self.rgb = DARK
        self.alpha = alpha
        self.set_hexpand(True)
        self.set_vexpand(True)
        self.set_can_target(False)

    def do_snapshot(self, snapshot):
        if self.alpha <= 0.0:
            return
        colour = Gdk.RGBA()
        colour.red, colour.green, colour.blue, colour.alpha = (*self.rgb, self.alpha)
        rect = Graphene.Rect().init(0, 0, self.get_width(), self.get_height())
        snapshot.append_color(colour, rect)


UPOWER = "org.freedesktop.UPower"
UPOWER_DEVICE = "org.freedesktop.UPower.Device"
# UPower's device states
CHARGING, DISCHARGING, EMPTY, FULL = 1, 2, 3, 4
HISTORY_S = 24 * 3600                     # the battery graph's span
CHARGE_RGB = (0x34 / 255, 0xC7 / 255, 0x59 / 255)
DRAIN_RGB = (0x3A / 255, 0x3A / 255, 0x3C / 255)


def about(seconds):
    """A duration as a person would say it: to 10 minutes, UPower's
    estimate being no finer than that on battery - and from 5 hours on in
    whole hours, a day ahead being no finer than that."""
    if seconds >= 5 * 3600:
        return f"{int(round(seconds / 3600.0))} h"
    minutes = int(round(seconds / 600.0)) * 10
    if minutes < 10:
        return "under 10 min"
    hours, minutes = divmod(minutes, 60)
    if not hours:
        return f"{minutes} min"
    return f"{hours} h {minutes} min" if minutes else f"{hours} h"


class ChargeGraph(Gtk.Widget):
    """The charge over the last HISTORY_S, from UPower's history: charging
    in green, draining in dark grey, broken where the history has a gap
    (a restart).

    Drawn into a texture when the data changes - the history once a minute,
    the level when it moves - and not in the frame that shows it: a cairo
    node drawn in the snapshot was drawn and uploaded again each time the
    page's content came out, and that frame took 33-50 ms in half the opens.
    A texture kept is uploaded once and shown from then on."""

    HEIGHT = 64

    def __init__(self):
        super().__init__()
        self.points = []                  # (unix time, percent, state), oldest first
        self.last = None                  # the level now: the history adds a point a percent
        self.texture = None
        self.drawn_for = None             # (width, scale) the texture was drawn at
        self.set_size_request(-1, self.HEIGHT)
        self.set_hexpand(True)

    def set_points(self, points):
        if points != self.points:
            self.points = points
            self._draw()

    def set_now(self, pct, state):
        if self.last is None or self.last[1:] != (pct, state):
            self.last = (time.time(), pct, state)
            self._draw()

    def _draw(self):
        """Draw the graph into self.texture at the size it is shown at."""
        w, scale = self.get_width(), self.get_scale_factor()
        if w <= 0:
            return                        # not laid out yet: the snapshot will ask
        pw, ph = w * scale, self.HEIGHT * scale
        surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, pw, ph)
        cr = cairo.Context(surface)
        cr.scale(scale, scale)
        h = self.HEIGHT
        cr.set_line_width(1)
        cr.set_source_rgba(0, 0, 0, 0.08)
        for level in (0, 50, 100):            # the empty, half and full lines
            y = round(h - 1 - (h - 2) * level / 100) + 0.5
            cr.move_to(0, y)
            cr.line_to(w, y)
            cr.stroke()
        points = list(self.points)
        if self.last is not None and points and self.last[0] > points[-1][0]:
            points.append((time.time(), *self.last[1:]))
        now = time.time()

        def at(t, pct):
            return (w * (1 - (now - t) / HISTORY_S), h - 1 - (h - 2) * pct / 100.0)

        cr.set_line_width(2)
        for (t0, p0, s0), (t1, p1, s1) in zip(points, points[1:]):
            # a point of unknown state is a gap (the phone restarting, the
            # history saying 0 %); so is a long silence
            if s0 == 0 or s1 == 0 or t1 - t0 > 3 * 3600:
                continue
            cr.set_source_rgb(*(CHARGE_RGB if s0 in (CHARGING, FULL) else DRAIN_RGB))
            cr.move_to(*at(t0, p0))
            cr.line_to(*at(t1, p1))
            cr.stroke()
        surface.flush()
        data = GLib.Bytes.new(bytes(surface.get_data()))
        self.texture = Gdk.MemoryTexture.new(pw, ph, Gdk.MemoryFormat.B8G8R8A8_PREMULTIPLIED,
                                             data, surface.get_stride())
        self.drawn_for = (w, scale)
        self.queue_draw()

    def do_snapshot(self, snapshot):
        if self.drawn_for != (self.get_width(), self.get_scale_factor()):
            self._draw()                  # first shown, or resized
        if self.texture is not None:
            snapshot.append_texture(self.texture,
                                    Graphene.Rect().init(0, 0, self.get_width(), self.HEIGHT))


class BatteryCard:
    """The battery card (#115): the level and what it is doing, the power
    and the temperature, and the charge over the last day. UPower is asked
    without waiting, and only while the page is open."""

    def __init__(self, body):
        for child in list(body):
            body.remove(child)
        self.lead = Gtk.Label(css_classes=["system-card-lead"], xalign=0)
        self.detail = Gtk.Label(css_classes=["system-quiet"], xalign=0)
        self.graph = ChargeGraph()
        self.graph.set_margin_top(8)
        axis = Gtk.Box()
        axis.append(Gtk.Label(label="24 h ago", css_classes=["system-axis"], xalign=0, hexpand=True))
        axis.append(Gtk.Label(label="now", css_classes=["system-axis"], xalign=1))
        for w in (self.lead, self.detail, self.graph, axis):
            body.append(w)
        self.path = None
        self.bus = None

    def refresh(self, history=False):
        if self.bus is None:
            try:
                self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
            except GLib.Error:
                return
        if self.path is None:
            self.bus.call(UPOWER, "/org/freedesktop/UPower", UPOWER, "EnumerateDevices", None,
                          None, Gio.DBusCallFlags.NONE, 1000, None, self._got_devices, history)
            return
        self.bus.call(UPOWER, self.path, "org.freedesktop.DBus.Properties", "GetAll",
                      GLib.Variant("(s)", (UPOWER_DEVICE,)), None, Gio.DBusCallFlags.NONE, 1000,
                      None, self._got_props)
        if history:
            self.bus.call(UPOWER, self.path, UPOWER_DEVICE, "GetHistory",
                          GLib.Variant("(suu)", ("charge", HISTORY_S, 300)), None,
                          Gio.DBusCallFlags.NONE, 1000, None, self._got_history)

    def _got_devices(self, bus, result, history):
        try:
            paths = bus.call_finish(result).unpack()[0]
        except GLib.Error:
            return
        batteries = [p for p in paths if "battery" in p.rsplit("/", 1)[-1]]
        if batteries:
            self.path = batteries[0]
            self.refresh(history)

    def _got_props(self, bus, result):
        try:
            props = bus.call_finish(result).unpack()[0]
        except GLib.Error:
            return
        pct = float(props.get("Percentage", 0.0))
        state = int(props.get("State", 0))
        rate = float(props.get("EnergyRate", 0.0))
        temp = float(props.get("Temperature", 0.0))
        to_full, to_empty = int(props.get("TimeToFull", 0)), int(props.get("TimeToEmpty", 0))
        if state == FULL or (state == CHARGING and pct >= 99.5):
            doing = "Full"
        elif state == CHARGING:
            doing = f"full in about {about(to_full)}" if to_full > 0 else "Charging"
        elif state in (DISCHARGING, EMPTY):
            doing = f"about {about(to_empty)} left" if to_empty > 0 else "On battery"
        else:
            doing = "Plugged in"
        self.lead.set_text(f"{pct:.0f}% \u00b7 {doing}")
        self.graph.set_now(round(pct), state)
        parts = []
        if rate > 0.05 and state in (CHARGING, DISCHARGING):
            parts.append(f"{rate:.1f} W {'in' if state == CHARGING else 'out'}")
        if temp > 0:
            parts.append(f"{temp:.0f} \u00b0C")
        self.detail.set_text(" \u00b7 ".join(parts))
        self.detail.set_visible(bool(parts))

    def _got_history(self, bus, result):
        try:
            rows = bus.call_finish(result).unpack()[0]
        except GLib.Error:
            return
        self.graph.set_points(sorted((int(t), float(v), int(s)) for t, v, s in rows))


LOAD_EVERY_S = 10                         # a load sample
LOAD_SPAN_S = 600                         # the load histogram's span
LITTLE_RGB = (0x8E / 255, 0x8E / 255, 0x93 / 255)
BIG_RGB = (0x0A / 255, 0x84 / 255, 0xFF / 255)


def size(n):
    """Bytes as a person reads them: 1.7 GB, 72 GB, 640 MB, 12 kB."""
    gb = n / 1e9
    if gb >= 10:
        return f"{gb:.0f} GB"
    if gb >= 1:
        return f"{gb:.1f} GB"
    if n >= 1e6:
        return f"{n / 1e6:.0f} MB"
    return f"{n / 1e3:.0f} kB"


def read_text(path):
    try:
        with open(path) as fp:
            return fp.read()
    except OSError:
        return ""


class LoadSampler:
    """The CPU's use, a sample every LOAD_EVERY_S, the little cores and the
    big ones apart, kept for LOAD_SPAN_S so that the load card has a past
    when the page opens (#116). One read of /proc/stat a sample, and none
    while the display is off: a timer waking a folded phone every 10 s is
    not worth a histogram nobody can see - the past it keeps is the last
    minutes the phone was in use."""

    def __init__(self):
        self.clusters = []                # (name, [cpu numbers]), little first
        for policy in sorted(os.listdir("/sys/devices/system/cpu/cpufreq")
                             if os.path.isdir("/sys/devices/system/cpu/cpufreq") else []):
            cpus = [int(c) for c in read_text(
                f"/sys/devices/system/cpu/cpufreq/{policy}/related_cpus").split()]
            if cpus:
                self.clusters.append((policy, cpus))
        self.clusters.sort(key=lambda c: c[1][0])
        self.samples = []                 # (monotonic s, little 0..1, big 0..1)
        self.last = None                  # per-cpu (busy, total) at the last read
        self.timer = None
        self.listeners = []

    def _read(self):
        stat = {}
        for line in read_text("/proc/stat").splitlines():
            if line.startswith("cpu") and line[3:4].isdigit():
                name, *fields = line.split()
                values = [int(v) for v in fields]
                idle = values[3] + (values[4] if len(values) > 4 else 0)
                stat[int(name[3:])] = (sum(values) - idle, sum(values))
        return stat

    def sample(self):
        now, stat = time.monotonic(), self._read()
        if self.last is not None and self.clusters:
            def use(cpus):
                busy = sum(stat[c][0] - self.last[c][0] for c in cpus if c in stat and c in self.last)
                total = sum(stat[c][1] - self.last[c][1] for c in cpus if c in stat and c in self.last)
                return busy / total if total > 0 else 0.0
            little = self.clusters[0][1]
            big = [c for _name, cpus in self.clusters[1:] for c in cpus]
            self.samples.append((now, use(little), use(big)))
            self.samples = [x for x in self.samples if now - x[0] <= LOAD_SPAN_S]
            for listener in self.listeners:
                listener()
        self.last = stat
        return True

    def run(self, on):
        """Sample while the display is on, and not while it is off."""
        if on and self.timer is None:
            self.last = None              # a span of darkness is not one long sample
            self.sample()
            self.timer = GLib.timeout_add_seconds(LOAD_EVERY_S, self.sample)
        elif not on and self.timer is not None:
            GLib.source_remove(self.timer)
            self.timer = None


class LoadGraph(Gtk.Widget):
    """The load over the last LOAD_SPAN_S: a bar a sample, the little
    cores' in grey above the big cores' in blue.

    Plain colour rectangles, one node a bar: the GPU draws them for nothing,
    and GTK keeps them until a new sample asks for a new drawing. Drawn with
    cairo into a texture, as the charge graph is, the redrawing and the
    upload with every sample showed: a long frame in 34% of the slides
    against 19% without the sampler."""

    ROW = 28
    GAP = 6

    def __init__(self, sampler):
        super().__init__()
        self.sampler = sampler
        self.shown = False                # the page is open
        self.set_size_request(-1, 2 * self.ROW + self.GAP)
        self.set_hexpand(True)

    def redraw(self):
        """A sample came: drawn now if the page is open; otherwise the next
        time it is shown, GTK having thrown the old drawing away then."""
        if self.shown:
            self.queue_draw()

    def show(self, shown):
        if shown and not self.shown:
            self.queue_draw()
        self.shown = shown

    def do_snapshot(self, snapshot):
        w = self.get_width()
        bg = Gdk.RGBA()
        bg.red = bg.green = bg.blue = 0.0
        bg.alpha = 0.05
        rows = ((0, 1, LITTLE_RGB), (self.ROW + self.GAP, 2, BIG_RGB))
        for top, _i, _rgb in rows:
            snapshot.append_color(bg, Graphene.Rect().init(0, top, w, self.ROW))
        now = time.monotonic()
        bar = w / (LOAD_SPAN_S / LOAD_EVERY_S)
        colours = {}
        for top, i, rgb in rows:
            c = Gdk.RGBA()
            c.red, c.green, c.blue, c.alpha = (*rgb, 1.0)
            colours[i] = c
        for sample in self.sampler.samples:
            x = w * (1 - (now - sample[0]) / LOAD_SPAN_S) - bar
            for top, i, _rgb in rows:
                height = max(1.0, self.ROW * sample[i])
                snapshot.append_color(colours[i], Graphene.Rect().init(
                    x + 0.5, top + self.ROW - height, max(1.0, bar - 1), height))


def clear(body):
    for child in list(body):
        body.remove(child)


class LoadCard:
    """The CPU (#116): the last ten minutes of use, the clusters' clocks
    now and the hottest core's temperature."""

    def __init__(self, body, sampler):
        clear(body)
        self.sampler = sampler
        self.detail = Gtk.Label(css_classes=["system-card-body"], xalign=0, wrap=True)
        self.graph = LoadGraph(sampler)
        self.graph.set_margin_top(6)
        axis = Gtk.Box()
        axis.append(Gtk.Label(label="10 min ago \u00b7 little above, big below",
                              css_classes=["system-axis"], xalign=0, hexpand=True))
        axis.append(Gtk.Label(label="now", css_classes=["system-axis"], xalign=1))
        for w in (self.detail, self.graph, axis):
            body.append(w)
        self.temps = [f"/sys/class/thermal/{z}/temp" for z in sorted(os.listdir("/sys/class/thermal"))
                      if z.startswith("thermal_zone")
                      and read_text(f"/sys/class/thermal/{z}/type").strip().endswith("-usr")
                      and read_text(f"/sys/class/thermal/{z}/type").startswith("cpu")] \
            if os.path.isdir("/sys/class/thermal") else []
        sampler.listeners.append(self.graph.redraw)

    def refresh(self):
        self.graph.show(True)
        names = ["Little", "Big", "Prime"]
        parts = []
        for i, (policy, _cpus) in enumerate(self.sampler.clusters):
            khz = read_text(f"/sys/devices/system/cpu/cpufreq/{policy}/scaling_cur_freq").strip()
            if khz.isdigit():
                parts.append(f"{names[i] if i < len(names) else policy} {int(khz) / 1e6:.1f} GHz")
        temps = [int(t) for t in (read_text(p).strip() for p in self.temps) if t.lstrip("-").isdigit()]
        if temps:
            parts.append(f"{max(temps) / 1000:.0f} \u00b0C")
        self.detail.set_text(" \u00b7 ".join(parts))


class MemoryCard:
    """The RAM (#116): used and total, and the swap if any is in use."""

    def __init__(self, body):
        clear(body)
        self.lead = Gtk.Label(css_classes=["system-card-lead"], xalign=0)
        self.bar = Gtk.LevelBar(min_value=0.0, max_value=1.0)
        self.bar.set_margin_top(6)
        self.detail = Gtk.Label(css_classes=["system-quiet"], xalign=0)
        for w in (self.lead, self.bar, self.detail):
            body.append(w)

    def refresh(self):
        info = {}
        for line in read_text("/proc/meminfo").splitlines():
            key, _, rest = line.partition(":")
            if rest.strip().split()[:1]:
                info[key] = int(rest.split()[0]) * 1024
        total, free = info.get("MemTotal", 0), info.get("MemAvailable", 0)
        if not total:
            return
        self.lead.set_text(f"{size(total - free)} used of {size(total)}")
        self.bar.set_value((total - free) / total)
        swap = info.get("SwapTotal", 0) - info.get("SwapFree", 0)
        self.detail.set_text(f"Swap {size(swap)} in use" if swap >= 50e6 else "")
        self.detail.set_visible(swap >= 50e6)


class StorageCard:
    """The space (#116): the system image and the user data apart - the
    root is an image of its own on /userdata, much the smaller of the two."""

    LOW = 1e9                              # free space under this on a row is red

    PLACES = [("System", "/"), ("Data", "/userdata")]

    def __init__(self, body):
        clear(body)
        self.rows = []
        for name, path in self.PLACES:
            row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            line = Gtk.Box(spacing=8)
            line.append(Gtk.Label(label=name, css_classes=["system-row-name"], xalign=0))
            text = Gtk.Label(css_classes=["system-card-body"], xalign=1, hexpand=True)
            line.append(text)
            bar = Gtk.LevelBar(min_value=0.0, max_value=1.0)
            row.append(line)
            row.append(bar)
            body.append(row)
            self.rows.append((path, row, text, bar))

    def refresh(self):
        for path, row, text, bar in self.rows:
            try:
                st = os.statvfs(path)
            except OSError:
                row.set_visible(False)
                continue
            total, free = st.f_blocks * st.f_frsize, st.f_bavail * st.f_frsize
            row.set_visible(total > 0)
            if total <= 0:
                continue
            text.set_text(f"{size(free)} free of {size(total)}")
            bar.set_value(1 - free / total)
            if free < self.LOW:
                text.add_css_class("system-warn")
            else:
                text.remove_css_class("system-warn")


class TrafficLedger:
    """Today's data, Wi-Fi and mobile apart (#117). The interfaces count from
    boot and know nothing of midnight, so a small ledger keeps the counts
    the day started with, carried over restarts, in
    ~/.local/state/sfduo/traffic.json. It is brought up to date with the
    load samples, while the display is on, and written once a minute: data
    that went by with the display off lands on the day it is next seen."""

    PATH = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"),
                        "sfduo", "traffic.json")
    SAVE_EVERY = 6                        # load samples: a minute

    def __init__(self):
        self.ledger = None
        self.samples = 0

    @staticmethod
    def counters():
        """Bytes in and out since boot: (Wi-Fi, mobile). The mobile data is
        rmnet_data*; rmnet_ipa0 under them would count it twice."""
        wifi = mobile = 0
        for line in read_text("/proc/net/dev").splitlines()[2:]:
            name, _, rest = line.partition(":")
            name, fields = name.strip(), rest.split()
            if len(fields) < 9:
                continue
            both = int(fields[0]) + int(fields[8])
            if name.startswith("wlan"):
                wifi += both
            elif name.startswith("rmnet_data"):
                mobile += both
        return wifi, mobile

    def _load(self):
        import json
        try:
            with open(self.PATH) as fp:
                return json.load(fp)
        except (OSError, ValueError):
            return None

    def _save(self):
        import json
        try:
            os.makedirs(os.path.dirname(self.PATH), exist_ok=True)
            with open(self.PATH + ".new", "w") as fp:
                json.dump(self.ledger, fp)
            os.replace(self.PATH + ".new", self.PATH)
        except OSError:
            pass

    def tally(self, save=False):
        """Bring the ledger up to now and give today's (Wi-Fi, mobile)."""
        day = time.strftime("%Y-%m-%d")
        boot = read_text("/proc/sys/kernel/random/boot_id").strip()
        now = list(self.counters())
        if self.ledger is None:
            self.ledger = self._load()
        led = self.ledger
        if not led or led.get("day") != day:
            # a new day starts from what the counters say now
            led = {"day": day, "boot": boot, "base": now, "carried": [0, 0], "last": now}
        elif led.get("boot") != boot:
            # restarted today: what the old boot counted since the base is kept
            led["carried"] = [c + max(0, last - base) for c, last, base
                              in zip(led["carried"], led["last"], led["base"])]
            led.update(boot=boot, base=[0, 0])
        led["last"] = now
        self.ledger = led
        if save:
            self._save()
        return tuple(c + max(0, n - b) for c, n, b in zip(led["carried"], now, led["base"]))

    def sampled(self):
        """A load sample came: keep up, and write it down once a minute."""
        self.samples += 1
        self.tally(save=self.samples % self.SAVE_EVERY == 0)


NM = "org.freedesktop.NetworkManager"
MM = "org.freedesktop.ModemManager1"
# ModemManager's access technologies, the newest first
TECH = [(1 << 15, "5G"), (1 << 14, "LTE"), (0x3E0, "3G"), (0x1E, "2G")]


class NetworkCard:
    """Wi-Fi and the mobile network (#117): the Wi-Fi network, its signal,
    band and speed; the operator, the technology and the signal; and today's
    data, each apart. NetworkManager and ModemManager are asked without
    waiting, only while the page is open."""

    def __init__(self, body, ledger):
        clear(body)
        self.ledger = ledger
        self.rows = {}
        for key, name in (("wifi", "Wi-Fi"), ("mobile", "Mobile"), ("today", "Today")):
            line = Gtk.Box(spacing=8)
            line.append(Gtk.Label(label=name, css_classes=["system-row-name"], xalign=0))
            text = Gtk.Label(css_classes=["system-card-body"], xalign=1, hexpand=True,
                             ellipsize=3)             # Pango.EllipsizeMode.END
            line.append(text)
            body.append(line)
            self.rows[key] = text
        self.bus = None
        self.wifi_device = None
        self.modem_device = None
        self.wifi = "Off"
        self.data = None

    def refresh(self):
        wifi, mobile = self.ledger.tally()
        self.rows["today"].set_text(f"Wi-Fi {size(wifi)} \u00b7 mobile {size(mobile)}")
        if self.bus is None:
            try:
                self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
            except GLib.Error:
                return
        if self.wifi_device is None:
            self.bus.call(NM, "/org/freedesktop/NetworkManager", NM, "GetDevices", None, None,
                          Gio.DBusCallFlags.NONE, 1000, None, self._got_devices)
        else:
            self._ask_wifi()
            self._ask_data()
        self.bus.call(MM, "/org/freedesktop/ModemManager1", "org.freedesktop.DBus.ObjectManager",
                      "GetManagedObjects", None, None, Gio.DBusCallFlags.NONE, 1000, None,
                      self._got_modems)

    def _props(self, path, iface, done):
        def got(bus, result):
            try:
                done(bus.call_finish(result).unpack()[0])
            except GLib.Error:
                done(None)
        self.bus.call(NM, path, "org.freedesktop.DBus.Properties", "GetAll",
                      GLib.Variant("(s)", (iface,)), None, Gio.DBusCallFlags.NONE, 1000, None, got)

    def _got_devices(self, bus, result):
        try:
            paths = bus.call_finish(result).unpack()[0]
        except GLib.Error:
            return
        for path in paths:
            def seen(props, path=path):
                if not props:
                    return
                kind = int(props.get("DeviceType", 0))
                if kind == 2 and self.wifi_device is None:     # Wi-Fi
                    self.wifi_device = path
                    self._ask_wifi()
                elif kind == 8 and self.modem_device is None:  # the modem's data
                    self.modem_device = path
                    self._ask_data()
            self._props(path, NM + ".Device", seen)

    def _ask_wifi(self):
        def device(props):
            if not props or int(props.get("State", 0)) != 100:
                self.wifi = "Off" if props and int(props.get("State", 0)) <= 20 else "Not connected"
                self._show_wifi()
                return
            self._props(self.wifi_device, NM + ".Device.Wireless",
                        lambda w: wireless(w) if w else None)

        def wireless(w):
            ap, rate = w.get("ActiveAccessPoint", "/"), int(w.get("Bitrate", 0))
            if ap == "/":
                self.wifi = "Not connected"
                self._show_wifi()
                return
            self._props(ap, NM + ".AccessPoint", lambda a: point(a, rate) if a else None)

        def point(a, rate):
            ssid = bytes(a.get("Ssid", b"")).decode("utf-8", "replace") or "Hidden network"
            band = "5 GHz" if int(a.get("Frequency", 0)) >= 4900 else "2.4 GHz"
            parts = [ssid, f"{int(a.get('Strength', 0))}%", band]
            if rate:
                parts.append(f"{rate // 1000} Mb/s")
            self.wifi = " \u00b7 ".join(parts)
            self._show_wifi()
        self._props(self.wifi_device, NM + ".Device", device)

    def _show_wifi(self):
        self.rows["wifi"].set_text(self.wifi)

    def _ask_data(self):
        def device(props):
            if not props:
                return
            state = int(props.get("State", 0))
            self.data = "data on" if state == 100 else (
                "data off" if state <= 30 else "data connecting")
        if self.modem_device:
            self._props(self.modem_device, NM + ".Device", device)

    def _got_modems(self, bus, result):
        try:
            objects = bus.call_finish(result).unpack()[0]
        except GLib.Error:
            self.rows["mobile"].set_text("No modem")
            return
        for _path, ifaces in objects.items():
            modem = ifaces.get(MM + ".Modem", {})
            gsm = ifaces.get(MM + ".Modem.Modem3gpp", {})
            if not modem:
                continue
            state = int(modem.get("State", 0))
            if state < 7:                 # locked, disabled, searching and the like
                self.rows["mobile"].set_text("No service")
                return
            quality = modem.get("SignalQuality", (0, False))[0]
            tech = int(modem.get("AccessTechnologies", 0))
            parts = [gsm.get("OperatorName") or "Mobile network"]
            parts += [name for bit, name in TECH if tech & bit][:1]
            parts.append(f"{quality}%")
            if self.data:
                parts.append(self.data)
            self.rows["mobile"].set_text(" \u00b7 ".join(parts))
            return
        self.rows["mobile"].set_text("No modem")


EVENTS_AHEAD_S = 7 * 86400                # how far the calendar is looked into


def clock_text(t, twelve):
    lt = time.localtime(t)
    return time.strftime("%l:%M %p", lt).strip() if twelve else time.strftime("%H:%M", lt)


def day_text(t):
    """today, tomorrow, or the weekday, for something within the week."""
    days = (datetime.date.fromtimestamp(t) - datetime.date.today()).days
    return "today" if days == 0 else "tomorrow" if days == 1 else time.strftime("%a", time.localtime(t))


def until_text(t):
    left = t - time.time()
    if left < 60:
        return "now"
    if left < 3600:
        return f"in {int(left // 60)} min"
    if left < 86400:
        hours, minutes = divmod(int(left // 60), 60)
        return f"in {hours} h {minutes} min" if minutes else f"in {hours} h"
    days = int(round(left / 86400))
    return f"in {days} day" + ("s" if days > 1 else "")


def next_alarm(alarms):
    """The next time one of Clocks' alarms rings, and its name: each alarm
    is a dict of hour, minute, active and days (0 Monday .. 6 Sunday, none
    for once) - Clocks' own serialisation."""
    now = time.time()
    best = None
    for alarm in alarms:
        if not alarm.get("active", True):
            continue
        hour, minute = int(alarm.get("hour", 0)), int(alarm.get("minute", 0))
        days = list(alarm.get("days", []))
        for ahead in range(8):
            lt = time.localtime(now + ahead * 86400)
            at = time.mktime((lt.tm_year, lt.tm_mon, lt.tm_mday, hour, minute, 0, 0, 0, -1))
            if at <= now or (days and lt.tm_wday not in days):
                continue
            if best is None or at < best[0]:
                best = (at, str(alarm.get("name", "")))
            break
    return best


class NextUpCard:
    """What comes next (#118): Clocks' next alarm and the calendar's next
    event, with how long until each. The calendar is evolution-data-server's,
    asked from a thread of its own - its calls wait on the answer - once on
    the way in and once a minute while the page is open; its clients are
    made and kept in that thread, and only the answer comes back."""

    def __init__(self, body, screen):
        clear(body)
        self.screen = screen
        self.rows = {}
        for key, name in (("alarm", "Alarm"), ("event", "Calendar")):
            line = Gtk.Box(spacing=8)
            line.append(Gtk.Label(label=name, css_classes=["system-row-name"], xalign=0))
            text = Gtk.Label(css_classes=["system-card-body"], xalign=1, hexpand=True, ellipsize=3)
            line.append(text)
            body.append(line)
            self.rows[key] = text
        source = Gio.SettingsSchemaSource.get_default()
        self.clocks = (Gio.Settings.new("org.gnome.clocks")
                       if source and source.lookup("org.gnome.clocks", True) else None)
        self.event = None                 # (start, all day, summary) or False: none
        self.asking = False
        self.eds = {}                     # the calendar thread's: registry and clients

    def refresh(self, calendar=False):
        twelve = self.screen.interface is not None and \
            self.screen.interface.get_string("clock-format") == "12h"
        alarm = next_alarm(self.clocks.get_value("alarms").unpack()) if self.clocks else None
        if alarm:
            at, name = alarm
            text = f"{clock_text(at, twelve)} {day_text(at)} \u00b7 {until_text(at)}"
            self.rows["alarm"].set_text(f"{name} \u00b7 {text}" if name and name != "Alarm" else text)
        else:
            self.rows["alarm"].set_text("No alarm set")
        if calendar and not self.asking:
            self.asking = True
            threading.Thread(target=self._ask_calendar, daemon=True).start()
        self._show_event(twelve)

    def _show_event(self, twelve):
        if self.event is None:
            self.rows["event"].set_text("")
        elif self.event is False:
            self.rows["event"].set_text("Nothing in the next 7 days")
        elif self.event == "unavailable":
            self.rows["event"].set_text("Calendar unavailable")
        else:
            start, all_day, summary = self.event
            when = day_text(start) if all_day else f"{day_text(start)} {clock_text(start, twelve)}"
            self.rows["event"].set_text(f"{summary} \u00b7 {when} \u00b7 {until_text(start)}")

    def _ask_calendar(self):
        """In the calendar thread: the next event in any enabled calendar."""
        found, failed = None, False
        try:
            gi.require_version("EDataServer", "1.2")
            gi.require_version("ECal", "2.0")
            from gi.repository import ECal, EDataServer
            if "registry" not in self.eds:
                self.eds["registry"] = EDataServer.SourceRegistry.new_sync(None)
            registry = self.eds["registry"]
            now = int(time.time())
            for source in registry.list_sources(EDataServer.SOURCE_EXTENSION_CALENDAR):
                if not source.get_enabled():
                    continue
                uid = source.get_uid()
                if uid not in self.eds:
                    self.eds[uid] = ECal.Client.connect_sync(
                        source, ECal.ClientSourceType.EVENTS, 30, None)
                client = self.eds[uid]
                zone = client.get_default_timezone()

                def instance(icomp, start, end, *_rest, zone=zone):
                    nonlocal found
                    t0 = start.as_timet_with_zone(zone)
                    t1 = end.as_timet_with_zone(zone) if end else t0
                    if t1 > now and (found is None or t0 < found[0]):
                        found = (t0, bool(start.is_date()), icomp.get_summary() or "Event")
                    return True
                client.generate_instances_sync(now, now + EVENTS_AHEAD_S, None, instance)
        except (GLib.Error, ValueError, ImportError) as e:
            # no evolution-data-server introspection (gir1.2-ecal-2.0,
            # installed by sfduo-shell-setup), or the server not answering
            print(f"sfduo-system-screen: calendar: {e}", file=sys.stderr)
            failed = True

        def show():
            self.asking = False
            self.event = "unavailable" if failed and not found else (found or False)
            self.refresh()
            return False
        GLib.idle_add(show)


RELEASES = "https://api.github.com/repos/iverbovoy/surfaceduo-droidian/releases/latest"
UPDATE_EVERY_S = 86400                    # GitHub is asked at most once a day
POSTURE_NAMES = {"closed": "closed", "laptop": "laptop", "flat": "flat", "folded": "folded back"}


def uptime_text(seconds):
    minutes = int(seconds // 60)
    days, minutes = divmod(minutes, 1440)
    hours, minutes = divmod(minutes, 60)
    if days:
        return f"{days} day{'s' if days > 1 else ''} {hours} h"
    return f"{hours} h {minutes} min" if hours else f"{minutes} min"


def version_tuple(text):
    return tuple(int(p) for p in text.lstrip("v").split(".") if p.isdigit())


class DeviceCard:
    """This device (#119): the hinge live, the uptime, the port's version
    and whether a newer one is out, and the system under it. GitHub is asked
    about releases at most once a day, only while the page is open, from a
    thread; the answer is kept in ~/.local/state/sfduo/update.json."""

    STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"),
                         "sfduo", "update.json")

    def __init__(self, body, session_bus_getter):
        clear(body)
        self.rows = {}
        for key, name in (("hinge", "Hinge"), ("uptime", "Uptime"), ("port", "Port"),
                          ("system", "System")):
            line = Gtk.Box(spacing=8)
            line.append(Gtk.Label(label=name, css_classes=["system-row-name"], xalign=0))
            text = Gtk.Label(css_classes=["system-card-body"], xalign=1, hexpand=True, ellipsize=3)
            line.append(text)
            body.append(line)
            self.rows[key] = text
        self.bus = session_bus_getter
        self.shown = False
        self.subscribed = False
        self.posture = None
        self.version = None
        self.latest = None
        self.asking = False
        os_release = dict(line.split("=", 1) for line in read_text("/etc/os-release").splitlines()
                          if "=" in line)
        name = os_release.get("NAME", "Linux").strip('"')
        number = (os_release.get("VERSION_ID") or os_release.get("VERSION", "")).strip('"')
        kernel = os.uname().release.split("-microsoft")[0]       # the device's name, again
        self.rows["system"].set_text(f"{name} {number} \u00b7 kernel {kernel}".replace("  ", " "))

    def show(self, shown):
        self.shown = shown

    def refresh(self):
        self.show(True)
        self.rows["uptime"].set_text(uptime_text(float(read_text("/proc/uptime").split()[0] or 0)))
        conn = self.bus()
        if conn is not None:
            if not self.subscribed:
                self.subscribed = True
                conn.signal_subscribe("org.sfduo.Posture", "org.freedesktop.DBus.Properties",
                                      "PropertiesChanged", "/org/sfduo/Posture", None,
                                      Gio.DBusSignalFlags.NONE,
                                      lambda _c, _s, _p, _i, _sig, params:
                                      self._posture(params.unpack()[1]))
            conn.call("org.sfduo.Posture", "/org/sfduo/Posture", "org.freedesktop.DBus.Properties",
                      "GetAll", GLib.Variant("(s)", ("org.sfduo.Posture",)), None,
                      Gio.DBusCallFlags.NO_AUTO_START, 1000, None, self._got_posture)
        if not self.asking and (self.version is None or self._due()):
            self.asking = True
            threading.Thread(target=self._ask_versions, daemon=True).start()
        self._show_port()

    def _got_posture(self, conn, result):
        try:
            self._posture(conn.call_finish(result).unpack()[0], force=True)
        except GLib.Error:
            self.rows["hinge"].set_text("")

    def _posture(self, changed, force=False):
        self.posture = {**(self.posture or {}), **changed}
        if not (self.shown or force):
            return                         # the hinge moves all day; drawn when seen
        angle = self.posture.get("Angle")
        if angle is None:
            return
        name = POSTURE_NAMES.get(self.posture.get("Posture", ""))
        self.rows["hinge"].set_text(f"{float(angle):.0f}\u00b0" + (f" \u00b7 {name}" if name else ""))

    def _due(self):
        state = self._load()
        return not state or time.time() - state.get("checked", 0) > UPDATE_EVERY_S

    def _load(self):
        import json
        try:
            with open(self.STATE) as fp:
                return json.load(fp)
        except (OSError, ValueError):
            return None

    def _ask_versions(self):
        """In a thread: the installed version, and GitHub's latest when due."""
        import json
        import urllib.request
        version = read_text("/usr/share/sfduo/version").strip()
        if not version:                    # a package from before it said so
            block = None
            for chunk in read_text("/var/lib/dpkg/status").split("\n\n"):
                if chunk.startswith("Package: adaptation-droidian-surfaceduo\n"):
                    block = chunk
                    break
            for line in (block or "").splitlines():
                if line.startswith("Version: "):
                    version = line[9:].strip()
        state = self._load() or {}
        if time.time() - state.get("checked", 0) > UPDATE_EVERY_S:
            try:
                request = urllib.request.Request(RELEASES, headers={
                    "Accept": "application/vnd.github+json", "User-Agent": "sfduo-system-screen"})
                with urllib.request.urlopen(request, timeout=10) as reply:
                    tag = json.load(reply).get("tag_name", "")
                state = {"checked": time.time(), "latest": tag}
                os.makedirs(os.path.dirname(self.STATE), exist_ok=True)
                with open(self.STATE, "w") as fp:
                    json.dump(state, fp)
            except (OSError, ValueError) as e:
                print(f"sfduo-system-screen: releases: {e}", file=sys.stderr)

        def show():
            self.asking = False
            self.version = version or "?"
            self.latest = state.get("latest")
            self._show_port()
            return False
        GLib.idle_add(show)

    def _show_port(self):
        if self.version is None:
            return
        text = self.version
        if self.latest and version_tuple(self.latest) > version_tuple(self.version):
            text += f" \u00b7 {self.latest.lstrip('v')} is out"
        elif self.latest:
            text += " \u00b7 up to date"
        self.rows["port"].set_text(text)


WEATHER_EVERY_S = 1800                   # an answer older than this is asked again
WEATHER_HOURS = [0, 2, 4, 6, 8, 10]      # the strip's hours from now


class WeatherCard:
    """The weather (#120) for the first city chosen in GNOME Weather - the
    desktop clock's (#98) - from met.no through GWeather: now, the high and
    low of the next 24 hours, and a strip of the next 12. Asked on the way
    in when the last answer is over half an hour old; nothing while closed."""

    def __init__(self, body):
        clear(body)
        top = Gtk.Box(spacing=10)
        self.sky = Gtk.Image(pixel_size=28)
        self.lead = Gtk.Label(css_classes=["system-card-lead"], xalign=0, ellipsize=3)
        self.city = Gtk.Label(css_classes=["system-quiet"], xalign=1, hexpand=True)
        for w in (self.sky, self.lead, self.city):
            top.append(w)
        self.detail = Gtk.Label(css_classes=["system-quiet"], xalign=0)
        self.strip = Gtk.Box(homogeneous=True)
        self.strip.set_margin_top(8)
        self.hours = []
        for _ in WEATHER_HOURS:
            column = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            when = Gtk.Label(css_classes=["system-axis"])
            icon = Gtk.Image(pixel_size=20)
            temp = Gtk.Label(css_classes=["system-hour"])
            for w in (when, icon, temp):
                column.append(w)
            self.strip.append(column)
            self.hours.append((when, icon, temp))
        for w in (top, self.detail, self.strip):
            body.append(w)
        self.info = None
        self.asked = 0.0
        self.settings = None
        if GWeather is None:
            self._say("No weather library")
            return
        source = Gio.SettingsSchemaSource.get_default()
        if source and source.lookup("org.gnome.Weather", True):
            self.settings = Gio.Settings.new("org.gnome.Weather")
            self.settings.connect("changed::locations", lambda *_a: self._city())
        self._city()

    def _say(self, text):
        self.lead.set_text(text)
        for w in (self.sky, self.detail, self.strip):
            w.set_visible(False)

    def _city(self):
        cities = self.settings.get_value("locations") if self.settings else None
        if not cities or cities.n_children() == 0:
            self.info = None
            self._say("Choose a city in Weather")
            return
        location = GWeather.Location.get_world().deserialize(cities.get_child_value(0).get_variant())
        if location is None:
            return
        self.city.set_text(location.get_city_name() or location.get_name())
        self.info = GWeather.Info.new(location)
        self.info.set_application_id("org.sfduo.SystemScreen")
        self.info.set_contact_info("https://github.com/iverbovoy/surfaceduo-droidian")
        # as the desktop clock: met.no, not GWeather's default of an airport's
        # report and a service for the United States
        self.info.set_enabled_providers(GWeather.Provider.METAR | GWeather.Provider.MET_NO)
        self.info.connect("updated", self._on_weather)
        self.asked = 0.0

    def refresh(self):
        if self.info is not None and time.time() - self.asked > WEATHER_EVERY_S:
            self.asked = time.time()
            self.info.update()

    def _on_weather(self, info):
        if not info.is_valid():
            self.asked = 0.0               # asked again next time
            return
        unit = GWeather.TemperatureUnit.DEFAULT
        summary = info.get_weather_summary()
        sky = summary.split(": ", 1)[-1] if summary else ""
        ok, now_temp = info.get_value_temp(unit)
        self.lead.set_text(f"{now_temp:.0f}\u00b0" + (f" \u00b7 {sky}" if sky else "")
                           if ok else sky)
        self.sky.set_from_icon_name(info.get_symbolic_icon_name())
        now = time.time()
        points = []
        for f in info.get_forecast_list():
            ok_t, t = f.get_value_update()
            ok_v, v = f.get_value_temp(unit)
            if ok_t and ok_v and t >= now - 1800:
                points.append((t, v, f.get_symbolic_icon_name()))
        day = [v for t, v, _i in points if t <= now + 86400]
        if day:
            self.detail.set_text(f"High {max(day):.0f}\u00b0 \u00b7 low {min(day):.0f}\u00b0 "
                                 f"in the next 24 h")
        twelve = False
        try:
            twelve = Gio.Settings.new("org.gnome.desktop.interface").get_string("clock-format") == "12h"
        except (GLib.Error, TypeError):
            pass
        for (when, icon, temp), ahead in zip(self.hours, WEATHER_HOURS):
            if not points:
                break
            t, v, name = min(points, key=lambda p: abs(p[0] - (now + ahead * 3600)))
            when.set_text("Now" if ahead == 0 else
                          time.strftime("%l %p" if twelve else "%H:00", time.localtime(t)).strip())
            icon.set_from_icon_name(name)
            temp.set_text(f"{v:.0f}\u00b0")
        for w in (self.sky, self.detail, self.strip):
            w.set_visible(bool(points) or w is self.sky)


class SystemScreen:
    def __init__(self, app):
        self.app = app
        self.conn = None                          # the session bus, once the name is ours
        self.said = None                          # the progress last said on it
        self.progress = 0.0
        self.animation = None
        self.frames = []
        self.width = self._panel_width()

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        self.window = Gtk.Window(application=app)
        self.window.set_decorated(False)
        self.window.set_default_size(self.width, -1)
        Gtk4LayerShell.init_for_window(self.window)
        Gtk4LayerShell.set_namespace(self.window, "sfduo-system")
        Gtk4LayerShell.set_layer(self.window, Gtk4LayerShell.Layer.TOP)
        for edge in (Gtk4LayerShell.Edge.LEFT, Gtk4LayerShell.Edge.TOP, Gtk4LayerShell.Edge.BOTTOM):
            Gtk4LayerShell.set_anchor(self.window, edge, True)
        Gtk4LayerShell.set_exclusive_zone(self.window, -1)
        Gtk4LayerShell.set_keyboard_mode(self.window, Gtk4LayerShell.KeyboardMode.NONE)

        overlay = Gtk.Overlay()
        self.backdrop = Backdrop()
        overlay.set_child(self.backdrop)
        self.content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.content.append(self._build_head())
        scroll = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        column = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        for side in ("margin_start", "margin_end"):
            column.set_property(side, 20)
        column.set_margin_top(8)
        column.set_margin_bottom(24)
        self.cards = {}
        for key, title in self.CARDS:
            column.append(self._card(key, title))
        self.battery = BatteryCard(self.cards["battery"])
        self.sampler = LoadSampler()
        self.load = LoadCard(self.cards["load"], self.sampler)
        self.memory = MemoryCard(self.cards["memory"])
        self.storage = StorageCard(self.cards["storage"])
        self.ledger = TrafficLedger()
        self.sampler.listeners.append(self.ledger.sampled)
        self.network = NetworkCard(self.cards["network"], self.ledger)
        self.next_up = NextUpCard(self.cards["next"], self)
        self.device = DeviceCard(self.cards["device"], lambda: self.conn)
        self.weather = WeatherCard(self.cards["weather"])
        scroll.set_child(column)
        self.content.append(scroll)
        self.content.set_child_visible(False)     # not drawn at all under a full veil
        overlay.add_overlay(self.content)
        self.veil = Backdrop(alpha=1.0)
        overlay.add_overlay(self.veil)
        self.window.set_child(overlay)
        # A swipe left on it closes it - the way the swipe right from the
        # desktop brought it, back (#111)
        drag = Gtk.GestureDrag()
        drag.set_touch_only(True)
        drag.connect("drag-begin", self._on_drag_begin)
        drag.connect("drag-update", self._on_drag_update)
        drag.connect("drag-end", self._on_drag_end)
        self.window.add_controller(drag)
        self.refreshing = None
        self.step = None
        self.avatar_file = None                   # (path, mtime) of the picture shown
        try:
            self.interface = Gio.Settings.new("org.gnome.desktop.interface")
        except (GLib.Error, TypeError):
            self.interface = None

    # ---- the page ---------------------------------------------------------------
    #
    # A head - the time and date where the shade shows them, then a greeting
    # and the owner's picture - and a scrolling column of cards, one per
    # subject, filled by the tickets of epic #109. Everything on it is read
    # while the screen is open and not otherwise: on the way in, then every
    # REFRESH_S; closed, nothing is asked of anyone.

    CARDS = [("battery", "Battery"), ("load", "Load"), ("memory", "Memory"),
             ("storage", "Storage"), ("network", "Network"), ("next", "Next up"),
             ("device", "This device"), ("weather", "Weather")]
    REFRESH_S = 5
    HISTORY_EVERY = 12                    # a minute: UPower adds a point a percent

    def _build_head(self):
        head = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        head.set_margin_top(14)                   # where the shade's head is
        self.time = Gtk.Label(css_classes=["system-time"])
        self.date = Gtk.Label(css_classes=["system-date"])
        head.append(self.time)
        head.append(self.date)
        hello = Gtk.Box(spacing=14)
        hello.set_margin_top(22)
        hello.set_margin_bottom(14)
        hello.set_margin_start(20)
        hello.set_margin_end(20)
        self.avatar = Adw.Avatar(size=56, show_initials=True)
        self.greeting = Gtk.Label(css_classes=["system-greeting"], xalign=0, hexpand=True,
                                  wrap=True)
        hello.append(self.avatar)
        hello.append(self.greeting)
        head.append(hello)
        return head

    def _card(self, key, title):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, css_classes=["system-card"])
        card.append(Gtk.Label(label=title.upper(), css_classes=["system-card-title"], xalign=0))
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        body.append(Gtk.Label(label="Coming", css_classes=["system-quiet"], xalign=0))
        card.append(body)
        self.cards[key] = body
        return card

    def _read_owner(self):
        """Ask AccountsService for the system user's name as they gave it and
        their picture - without waiting: the answer comes while the page is
        sliding in, and a call waited for there costs frames."""
        def got_props(bus, result):
            try:
                props = bus.call_finish(result).unpack()[0]
            except GLib.Error:
                return
            self._show_owner(props.get("RealName"), props.get("UserName"), props.get("IconFile"))

        def got_user(bus, result):
            try:
                path = bus.call_finish(result).unpack()[0]
            except GLib.Error:
                self._show_owner(None, None, None)
                return
            bus.call("org.freedesktop.Accounts", path, "org.freedesktop.DBus.Properties",
                     "GetAll", GLib.Variant("(s)", ("org.freedesktop.Accounts.User",)),
                     None, Gio.DBusCallFlags.NONE, 1000, None, got_props)

        try:
            bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        except GLib.Error:
            return
        bus.call("org.freedesktop.Accounts", "/org/freedesktop/Accounts",
                 "org.freedesktop.Accounts", "FindUserById",
                 GLib.Variant("(x)", (os.getuid(),)), None,
                 Gio.DBusCallFlags.NONE, 1000, None, got_user)

    def _show_owner(self, real, user, icon):
        # a login is not a name: 'droidian' is greeted by the time of day alone
        name = real.split()[0] if real and real != user else None
        hour = GLib.DateTime.new_now_local().get_hour()
        part = ("Good morning" if 5 <= hour < 12 else "Good afternoon" if 12 <= hour < 18
                else "Good evening" if 18 <= hour < 23 else "Good night")
        self.greeting.set_text(f"{part}, {name}" if name else part)
        self.avatar.set_text(real or user or "")
        # decoded again only when the picture changed
        try:
            key = (icon, os.path.getmtime(icon)) if icon else None
        except OSError:
            key = None
        if key == self.avatar_file:
            return
        self.avatar_file = key
        texture = None
        if key:
            try:
                texture = Gdk.Texture.new_from_filename(icon)
            except GLib.Error:
                texture = None
        self.avatar.set_custom_image(texture)

    DISPLAY = "org.gnome.Mutter.DisplayConfig"
    DISPLAY_PATH = "/org/gnome/Mutter/DisplayConfig"

    def follow_display(self, conn):
        """Sample the load while the display is on: phosh says it as
        PowerSaveMode, 0 on and 3 off. A shell that does not answer leaves
        the sampler on."""
        conn.signal_subscribe(self.DISPLAY, "org.freedesktop.DBus.Properties", "PropertiesChanged",
                              self.DISPLAY_PATH, None, Gio.DBusSignalFlags.NONE,
                              lambda _c, _s, _p, _i, _sig, params:
                              self._display_changed(params.unpack()[1]))

        def got(conn_, result):
            try:
                mode = conn_.call_finish(result).unpack()[0]
            except GLib.Error:
                mode = 0
            self.sampler.run(int(mode) == 0)
        conn.call(self.DISPLAY, self.DISPLAY_PATH, "org.freedesktop.DBus.Properties", "Get",
                  GLib.Variant("(ss)", (self.DISPLAY, "PowerSaveMode")), None,
                  Gio.DBusCallFlags.NONE, 1000, None, got)

    def _display_changed(self, changed):
        if "PowerSaveMode" in changed:
            self.sampler.run(int(changed["PowerSaveMode"]) == 0)

    def _refresh(self):
        """Read what changes while the page is open: the time, the battery.
        Called on the way in and then every REFRESH_S while it is open; the
        battery's history every HISTORY_EVERY of them."""
        self._show_time()
        self.refreshes = getattr(self, "refreshes", -1) + 1
        self.battery.refresh(history=self.refreshes % self.HISTORY_EVERY == 0)
        for card in (self.load, self.memory, self.storage, self.network):
            card.refresh()
        self.next_up.refresh(calendar=self.refreshes % self.HISTORY_EVERY == 0)
        self.device.refresh()
        self.weather.refresh()
        return True

    def _opened(self, is_open):
        if is_open and self.refreshing is None:
            self.refreshes = -1                   # the history too, on the way in
            self._refresh()
            self._read_owner()                    # once a visit: it hardly changes
            self.refreshing = GLib.timeout_add_seconds(self.REFRESH_S, self._refresh)
        elif not is_open and self.refreshing is not None:
            self.load.graph.show(False)
            self.device.show(False)
            GLib.source_remove(self.refreshing)
            self.refreshing = None

    # ---- geometry -------------------------------------------------------------

    @staticmethod
    def _monitor():
        display = Gdk.Display.get_default()
        monitors = display.get_monitors()
        return monitors.get_item(0) if monitors.get_n_items() else None

    def _panel_width(self):
        monitor = self._monitor()
        width = monitor.get_geometry().width if monitor else 1392
        gap = max(1, round(width * HINGE_FRACTION))
        return (width - gap) // 2

    def _screen_height(self):
        monitor = self._monitor()
        return monitor.get_geometry().height if monitor else 900

    # ---- what it shows ----------------------------------------------------------

    def _show_time(self):
        now = GLib.DateTime.new_now_local()
        twelve = self.interface is not None and self.interface.get_string("clock-format") == "12h"
        self.time.set_text(now.format("%l:%M %p").strip() if twelve else now.format("%H:%M"))
        self.date.set_text(now.format("%A, %B %e").replace("  ", " "))

    def apply(self, progress):
        """Everything a progress says: where the surface stands, its colour,
        how much of the content shows."""
        self.progress = max(0.0, min(1.0, progress))
        if self.progress <= 0.0:
            self.window.set_visible(False)
            self._say_progress()
            self._opened(False)
            return
        self._opened(True)
        if not self.window.get_visible():
            self.window.present()
        # One pixel stays on screen however little is open: a surface wholly
        # off it gets no frame callbacks, GTK then draws no frame, and the
        # margins that would bring it in are sent with a frame - it stayed
        # out for good, saying it was open (#133).
        hidden = min(self.width - 1, int(round(self.width * (1 - self.progress))))
        Gtk4LayerShell.set_margin(self.window, Gtk4LayerShell.Edge.LEFT, -hidden)
        self.backdrop.rgb = mix(DARK, LIGHT, self.progress)
        self.backdrop.queue_draw()
        shown = max(0.0, (self.progress - CONTENT_FROM) / (1 - CONTENT_FROM))
        if self.content.get_child_visible() != (shown > 0.0):
            self.content.set_child_visible(shown > 0.0)
        self.veil.rgb = self.backdrop.rgb
        self.veil.alpha = 1.0 - shown
        self.veil.queue_draw()
        self._say_progress()

    def _say_progress(self):
        """Progress on the bus, for the dock to move the clock and its left
        half with: every step it can see, and always the ends."""
        p = self.progress
        if self.conn is None or (self.said is not None and abs(p - self.said) < 0.004
                                 and p not in (0.0, 1.0)) or p == self.said:
            return
        self.said = p
        self.conn.emit_signal(None, BUS_PATH, "org.freedesktop.DBus.Properties", "PropertiesChanged",
                              GLib.Variant("(sa{sv}as)", (BUS_NAME, {"Progress": GLib.Variant("d", p)}, [])))

    # ---- animation --------------------------------------------------------------

    FRAME_MS = 16

    def animate_to(self, target, why):
        """Slide to `target`, easing out, over SLIDE_MS.

        Stepped on the frame clock - in step with the display's refresh - while
        the surface is on the screen. A surface slid off the screen is not
        drawn and gets no frame callbacks, and an animation on the frame clock
        alone stalled there for good (the close never ended, every open after
        it went nowhere); a timer stands by for that, and takes over the steps
        when the frame clock has been silent for two frames. A timer alone
        missed the refresh a frame or two per slide (~20 ms a frame, max 50)."""
        self.chasing = False
        start, t0 = self.progress, GLib.get_monotonic_time()
        self.frames = []
        if target > 0 and not self.window.get_visible():
            self.apply(0.001)

        def step():
            now = GLib.get_monotonic_time()
            t = min(1.0, (now - t0) / 1000.0 / SLIDE_MS)
            self.apply(start + (target - start) * ease_out(t))
            if t >= 1.0:
                self._log(why)
                self._stop()
                return False
            return True

        self._drive(step)

    def _drive(self, step):
        """Step `step` from now on: on the frame clock, with the watchdog.

        One motion hands over to the next - a finger let go, its chase
        becoming the slide that finishes the job - without the frame clock
        stopping in between: a tick callback taken off and another put on
        cost the first frame of the slide, 33-50 ms instead of 16.6 (#114)."""
        self.step = step
        self.last_step = GLib.get_monotonic_time()
        if getattr(self, "ticking", None) is None:
            self.ticking = self.window.add_tick_callback(self._on_tick)
        if self.animation is None:
            self.animation = GLib.timeout_add(self.FRAME_MS, self._on_watchdog)

    def _on_tick(self, _widget, clock):
        if self.step is None:                     # stopped since it was put on
            self.ticking = None
            return GLib.SOURCE_REMOVE
        if self.frames is not None:
            self.frames.append(clock.get_frame_time())
        self.last_step = GLib.get_monotonic_time()
        return GLib.SOURCE_CONTINUE if self.step() else GLib.SOURCE_REMOVE

    def _on_watchdog(self):
        if self.step is None:
            self.animation = None
            return False
        now = GLib.get_monotonic_time()
        if now - self.last_step > 2 * self.FRAME_MS * 1000:
            self.last_step = now
            return self.step()
        return True

    # ---- following a finger -------------------------------------------------------
    #
    # SetProgress sets a target, and the surface chases it frame by frame - half
    # the way that is left each frame, snapping on at the end - on the same
    # frame-clock-and-watchdog stepping the animations use. A progress applied
    # once and left to draw on its own did not reach the screen: gtk4-layer-shell
    # sends a new margin with the window's next frame, and GTK draws no frame for
    # a picture that has not changed - the window was configured and never
    # committed a buffer. Chasing, every frame is a new picture until it is there,
    # and a finger's steps come out smoothed.

    CHASE = 0.5                               # the share of what is left, per frame

    def begin(self):
        """A finger is down: have the surface ready before it moves."""
        if self.progress <= 0.0:
            self.set_progress(0.001)

    def set_progress(self, progress):
        self.target = max(0.0, min(1.0, progress))
        if self.animation is not None and getattr(self, "chasing", False):
            return                            # the chase in progress takes it from here
        self.chasing = True
        self.frames = None                    # a finger's pace is not the display's
        if self.target > 0 and not self.window.get_visible():
            self.apply(0.001)

        def step():
            left = self.target - self.progress
            if abs(left) * self.width < 0.5:
                self.apply(self.target)
                self.chasing = False
                self._stop()
                return False
            self.apply(self.progress + left * self.CHASE)
            return True

        self._drive(step)

    def _stop(self):
        self.step = None
        if self.animation is not None:
            GLib.source_remove(self.animation)
            self.animation = None
        if getattr(self, "ticking", None) is not None:
            self.window.remove_tick_callback(self.ticking)
            self.ticking = None

    def _log(self, why):
        gaps = [(b - a) / 1000.0 for a, b in zip(self.frames, self.frames[1:])]
        if not gaps:
            return
        steady = sorted(gaps)[len(gaps) // 2]
        line = "%s %s: %d frames over %.0f ms, %.1f ms/frame (median %.1f, max %.0f) [%s]" % (
            time.strftime("%H:%M:%S"), why, len(gaps), sum(gaps),
            sum(gaps) / len(gaps), steady, max(gaps), " ".join("%.0f" % g for g in gaps))
        print("sfduo-system-screen: " + line, file=sys.stderr, flush=True)
        try:
            with open(PERF_LOG, "a") as fp:
                fp.write(line + "\n")
        except OSError:
            pass

    # ---- the swipe that closes it ---------------------------------------------------

    def _on_drag_begin(self, _gesture, _x, _y):
        self._stop()
        self.chasing = False
        self.drag_start = self.progress
        self.drag_claimed = False
        self.drag_last = (GLib.get_monotonic_time(), 0.0)
        self.drag_velocity = 0.0

    def _on_drag_update(self, gesture, dx, dy):
        # GTK's offset is in the window's own coordinates, and the window
        # slides under the finger as the finger drives it: add back what it
        # has travelled, or a slow swipe comes out as a wobble on the spot
        # (the dock's grid learned this, #47)
        dx += self.width * (self.progress - self.drag_start)
        if not self.drag_claimed:
            if abs(dy) >= SWIPE_PX and abs(dy) > abs(dx):
                gesture.set_state(Gtk.EventSequenceState.DENIED)   # the content's, later
                return
            if dx > -SWIPE_PX:
                return
            self.drag_claimed = True
            gesture.set_state(Gtk.EventSequenceState.CLAIMED)
        now = GLib.get_monotonic_time()
        then, last = self.drag_last
        if now > then:
            self.drag_velocity = (dx - last) / ((now - then) / 1000.0)
        self.drag_last = (now, dx)
        self.apply(max(0.001, min(1.0, self.drag_start + dx / self.width)))

    def _on_drag_end(self, _gesture, _dx, _dy):
        if not getattr(self, "drag_claimed", False):
            return
        if self.drag_velocity < -FLICK:
            target = 0.0
        elif self.drag_velocity > FLICK:
            target = 1.0
        else:
            target = 0.0 if self.progress < CLOSE_BELOW else 1.0
        self.animate_to(target, "close by swipe" if target == 0.0 else "stay by swipe")

    # ---- the bus ----------------------------------------------------------------

    def on_method(self, _conn, _sender, _path, _iface, method, params, invocation):
        if method == "Open":
            self.animate_to(1.0, "open")
        elif method == "Close":
            self.animate_to(0.0, "close")
        elif method == "Begin":
            self.begin()
        elif method == "SetProgress":
            self.set_progress(params.unpack()[0])
        invocation.return_value(None)

    def on_property(self, _conn, _sender, _path, _iface, name):
        return GLib.Variant("d", self.progress) if name == "Progress" else None


def main():
    # `sfduo-shell --stock`: Droidian's own shell has no dock to bring it
    if os.path.exists("/etc/sfduo/phosh-stock"):
        print("sfduo-system-screen: the packaged phosh is kept (/etc/sfduo/phosh-stock) - "
              "no system screen", file=sys.stderr)
        return
    demo = "--demo" in sys.argv
    app = Gtk.Application(application_id="org.sfduo.SystemScreenApp",
                          flags=Gio.ApplicationFlags.NON_UNIQUE)
    state = {}

    def activate(app):
        Adw.init()                                # the avatar is libadwaita's
        screen = SystemScreen(app)
        state["screen"] = screen
        app.hold()
        node = Gio.DBusNodeInfo.new_for_xml(INTROSPECTION)

        def acquired(conn, _name):
            conn.register_object(BUS_PATH, node.interfaces[0],
                                 screen.on_method, screen.on_property, None)
            screen.conn = conn
            screen.follow_display(conn)
            # said at once: a system screen that went away open left the
            # dock thinking it still was, its left panel's swipes switched off
            screen._say_progress()

        def lost(_conn, _name):
            # another one has the name: the dock talks to that one, and this
            # one would only sample the load behind its back
            print("sfduo-system-screen: the name is taken - leaving", file=sys.stderr)
            app.quit()
        Gio.bus_own_name(Gio.BusType.SESSION, BUS_NAME, Gio.BusNameOwnerFlags.NONE,
                         acquired, None, lost)
        if demo:
            rounds = int(os.environ.get("SFDUO_DEMO", "10"))
            steps = []
            for _ in range(rounds):
                steps += [("open", 1.0), ("close", 0.0)]

            def next_step():
                if not steps:
                    app.quit()
                    return False
                why, target = steps.pop(0)
                screen.animate_to(target, why)
                GLib.timeout_add(SLIDE_MS + 700, next_step)
                return False
            GLib.timeout_add(1000, next_step)

    app.connect("activate", activate)
    app.run([sys.argv[0]])


if __name__ == "__main__":
    main()
