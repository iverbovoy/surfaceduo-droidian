        self.mic = False
        self.camera = False
        self.location = False
        self._follow_mic()
        self._follow_location()

    def _follow_mic(self):
        try:
            # line-buffered: into a pipe pactl holds its events back in a
            # block, and the dot came on after the recording had ended
            self.pactl = Gio.Subprocess.new(["stdbuf", "-oL", "pactl", "subscribe"],
                                            Gio.SubprocessFlags.STDOUT_PIPE)
        except GLib.Error as err:
            print(f"sfduo-dock: no microphone dot: {err.message}", file=sys.stderr)
            return
        self.events = Gio.DataInputStream.new(self.pactl.get_stdout_pipe())
        self._count_recording()
        self.events.read_line_async(GLib.PRIORITY_DEFAULT, None, self._on_event)

    def _on_event(self, stream, result):
        try:
            line, _length = stream.read_line_finish_utf8(result)
        except GLib.Error:
            line = None
        if line is None:
            return                  # PulseAudio went away; the dot stays as it was
        if "source-output" in line:
            self._count_recording()
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, self._on_event)

    def _count_recording(self):
        try:
            out = subprocess.run(["pactl", "list", "short", "source-outputs"],
                                 capture_output=True, text=True, timeout=2).stdout
        except (OSError, subprocess.TimeoutExpired):
            return
        self.mic = bool(out.strip())
        self._show()

    GEOCLUE = "org.freedesktop.GeoClue2"
    GEOCLUE_MANAGER = "/org/freedesktop/GeoClue2/Manager"

    def _follow_location(self):
        try:
            self.system_bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        except GLib.Error:
            return
        self.system_bus.signal_subscribe(
            self.GEOCLUE, "org.freedesktop.DBus.Properties", "PropertiesChanged",
            self.GEOCLUE_MANAGER, None, Gio.DBusSignalFlags.NONE,
            lambda _c, _s, _p, _i, _sig, params: self._on_geoclue(params.unpack()[1]))
        # GeoClue restarting starts with nobody using it
        Gio.bus_watch_name_on_connection(self.system_bus, self.GEOCLUE, Gio.BusNameWatcherFlags.NONE,
                                         lambda *_a: self._read_location(),
                                         lambda *_a: self._on_geoclue({"InUse": False}))

    def _read_location(self):
        try:
            value = self.system_bus.call_sync(
                self.GEOCLUE, self.GEOCLUE_MANAGER, "org.freedesktop.DBus.Properties", "Get",
                GLib.Variant("(ss)", ("org.freedesktop.GeoClue2.Manager", "InUse")),
                None, Gio.DBusCallFlags.NO_AUTO_START, 1000, None)
            self._on_geoclue({"InUse": value.unpack()[0]})
        except GLib.Error:
            self._on_geoclue({"InUse": False})

    def _on_geoclue(self, changed):
        if "InUse" in changed and bool(changed["InUse"]) != self.location:
            self.location = bool(changed["InUse"])
            self._show()

    def set_camera(self, on):
        if on != self.camera:
            self.camera = on
            self._show()

    def _show(self):
        style = self.dot.get_style_context()
        for name, on in (("camera", self.camera), ("mic", self.mic and not self.camera),
                         ("location", self.location and not (self.mic or self.camera))):
            (style.add_class if on else style.remove_class)(name)
        debug(f"privacy dot: mic {self.mic}, camera {self.camera}, location {self.location}")
        if self.mic or self.camera or self.location:
            self.show_all()
        else:
            self.hide()


class SwipeCatcher(Gtk.Window):
    """Where a swipe on an empty panel's desktop is caught (#111, #135).

    A panel's desktop is phosh's home, a top-layer surface of its own, and
    nothing on it answers a finger. This is a transparent top-layer surface
    over it - clear of the strip along the top the shades are pulled by and
    of the dock's strip along the bottom - there only while the panel is
    free, and it hands the finger to the dock, which reads the direction: a
    swipe right brings the system screen, a swipe up the app grid, a swipe
    down this panel's shade. The shade is phoc's to drag: phoc passes a drag
    that starts on a surface of this namespace on to the shade above it
    (phoc-patches/0014), and takes the touch from here once it is one.
    """

    def __init__(self, dock, side):
        super().__init__()
        self.dock = dock
        self.side = side
        self.active = False
        self.get_style_context().add_class("sfduo-catcher")
        screen = Gdk.Screen.get_default()
        visual = screen.get_rgba_visual()
        if visual is not None:
            self.set_visual(visual)
        self.set_app_paintable(True)
        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_namespace(self, "sfduo-catcher")
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.TOP)
        edge_side = GtkLayerShell.Edge.LEFT if side == "left" else GtkLayerShell.Edge.RIGHT
        self.edge = edge_side
        for edge in (edge_side, GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.BOTTOM):
            GtkLayerShell.set_anchor(self, edge, True)
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.TOP, SHADE_TOP)
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.BOTTOM, DOCK_HEIGHT)
        GtkLayerShell.set_exclusive_zone(self, -1)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.NONE)
        self.drag = Gtk.GestureDrag.new(self)
        self.drag.set_touch_only(True)
        self.drag.connect("drag-begin", lambda _g, x, y: dock._on_catch_begin(side))
        self.drag.connect("drag-update", lambda g, dx, dy: dock._on_catch_update(side, g, dx, dy))
        self.drag.connect("drag-end", lambda g, dx, dy: dock._on_catch_end(side, g, dx, dy))
        self.drag.connect("cancel", lambda *_a: dock._on_catch_cancel(side))
        self.connect("draw", lambda _w, cr: (cr.set_source_rgba(0, 0, 0, 0),
                                             cr.set_operator(cairo.OPERATOR_SOURCE),
                                             cr.paint()) and False)

    def set_active(self, on):
        if on == self.active:
            return
        self.active = on
        debug(f"catcher on the {self.side} panel: {'on' if on else 'off'}")
        # A touch phoc took for the shade is cancelled here, and a catcher
        # hidden as the shade comes down may never see the cancel: the
        # gesture kept the touch as its own, and the next one - GTK names a
        # touch by its slot, the same for every first finger - went nowhere.
        self.drag.reset()
        # Mapped once and moved beyond its outer edge when off, as the curtain
        # is parked below the screen: hidden and shown again, it was drawn and
        # uploaded whole, 1350x1584, in the first frame of every move of an
        # app off its panel - a 40 ms frame of the slide (#200). Transparent
        # and left in place it would be blended over the window every frame.
        margin = 0 if on else -SCREEN_WIDTH
        if not self.get_mapped():
            GtkLayerShell.set_margin(self, self.edge, margin)
            self.show_all()
        elif self.side == "left":
            raw_margins(self, top=SHADE_TOP, bottom=DOCK_HEIGHT, left=margin)
        else:
            raw_margins(self, top=SHADE_TOP, bottom=DOCK_HEIGHT, right=margin)


class Dock(Gtk.Window):
    def __init__(self):
        super().__init__()
        self.get_style_context().add_class("sfduo-dock")

        # This window is nothing to look at: transparent, the strip along the
        # bottom of both panels, there for the touches that are not a
        # button's - a swipe up on a free panel for the grid, a swipe up along
        # the bottom edge of a busy panel for its window. The dock's buttons
        # are in two windows of their own (PaneWindow), the grid and the
        # launch curtain in others (GridPanel, CurtainPanel). Painted once.
        screen = Gdk.Screen.get_default()
        visual = screen.get_rgba_visual()
        if visual is not None:
            self.set_visual(visual)
        self.set_app_paintable(True)
        self.set_size_request(-1, DOCK_HEIGHT)

        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_namespace(self, "sfduo-dock")
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        for edge in (GtkLayerShell.Edge.LEFT,
                     GtkLayerShell.Edge.RIGHT,
                     GtkLayerShell.Edge.BOTTOM):
            GtkLayerShell.set_anchor(self, edge, True)
        # Nothing is reserved, and nothing reserved by others is honoured:
        # the window runs to the very bottom, over the strip phosh keeps for
        # its home bar, so that the bottom edge of every panel is this
        # window's - the dock on a free panel, a gesture band on a busy one.
        # A window never needs room made for it: on the Duo an application
        # fills its panel to the bottom edge, and the dock is on the other
        # one, or gone when both are taken.
        GtkLayerShell.set_exclusive_zone(self, -1)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.NONE)

        # One dock, cut in half by the bezel rather than two docks side by
        # side: the buttons are dealt out across the two panels, each app
        # appearing once, and the halves are pushed against the seam so the
        # bar reads as a single thing with the hinge lying across it. Which
        # half an app sits in is therefore which panel it opens on.
        # No all-apps button: the swipe up across the strip is the way to
        # the grid, and without the button the dock fits a panel whole.
        items = favourites()
        cut = (len(items) + 1) // 2

        # Two halves, each a window of its own that always holds the same
        # buttons: with nothing open they sit one per panel, pushed against
        # the hinge so the bar reads as one thing cut by the bezel; when a
        # panel is taken they sit side by side on the other one. Which panel
        # a tap opens onto is where the half is at that moment.
        self.panes = {
            "left": PaneWindow(self, "left", self._pane("left", items[:cut])),
            "right": PaneWindow(self, "right", self._pane("right", items[cut:])),
        }
        self.mode = "both"
        self.half = 1             # a panel's width and the hinge, from size-allocate
        self.gap = 1

        self._build_grid()
        self.grids = {side: GridPanel(self, side, pane)
                      for side, pane in (("left", self.grid_left), ("right", self.grid_right))}
        self.curtains = {side: CurtainPanel(side) for side in ("left", "right")}
        # back from the outer edges (#80)
        self.back_strips = {side: BackStrip(self, side) for side in ("left", "right")}
        self.back_arrows = {side: BackArrow(side) for side in ("left", "right")}
        self.back_buttons = {side: BackButton(self, side) for side in ("left", "right")}
        self.clock = DesktopClock()
        self.system_progress = 0.0    # the system screen's, as it says (#111)
        self.system_dragging = False
        self.catchers = {side: SwipeCatcher(self, side) for side in ("left", "right")}
        self.catching = None          # the panel a finger on a catcher is on
        self.catch_kind = None        # what that finger turned out to be doing
        self.privacy = PrivacyDot()
        self._follow_accent()
        strip = Gtk.Box()
        strip.set_size_request(-1, DOCK_HEIGHT)
        self.add(strip)
        self.curtain_up = False
        self.curtain_timer = None
        self.awaiting_shown = None    # the window whose Shown lifts the curtain
        self.shown = {}               # window -> when phoc last said it was shown

        self.progress = 0.0       # 0 closed .. 1 open
        self.animation = None     # tick id of the grid's motion
        self.move = None          # tick id of the dock's crossing
        self.placed = self._load_placed()   # app_id -> the panel it was sent to
        self.locked = False       # see _set_locked
        self.placing = 0          # launches of our own still being placed
        self.adopted = set()      # windows we did not launch and have dealt with
        self.shell_places = None  # whether windows can be placed at all - see _shell_places
        self.shell_places = self._shell_places()
        self.connect("size-allocate", self._on_size_allocate)
        self.connect("map", lambda *_a: self._shape())
        self.show_all()
        for pane in self.panes.values():
            pane.connect("size-allocate", self._on_pane_size_allocate)
            pane.show_all()
        self._follow_lockscreen()
        self._follow_keyboard()
        self._follow_shade()
        self._follow_system()
        self._publish_placement()
        self.watch_wake = threading.Event()
        self._follow_windows()
        threading.Thread(target=self._watch_windows, daemon=True).start()
        self.session_bus.signal_subscribe(
            "org.sfduo.Phoc", "org.sfduo.Phoc", "Shown", "/org/sfduo/Phoc", None,
            Gio.DBusSignalFlags.NONE,
            lambda _c, _s, _p, _i, _sig, params: self._on_shown(params.unpack()[0]))

        # The finger drives the grid. In the capture phase, so that the
        # sequence can be claimed once it is a swipe and taken away from the
        # button it started on; touch only, so a stylus or a pointer keeps
        # clicking things.
        self.drag = Gtk.GestureDrag.new(self)
        self.drag.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        self.drag.set_touch_only(True)
        self.drag.connect("drag-begin", lambda g, x, y: self._begin_drag(self._panel_at(x)))
        self.drag.connect("drag-update", self._on_drag_update)
        self.drag.connect("drag-end", self._on_drag_end)
        # A touch can also be taken away - the compositor cancels it when a
        # gesture of its own starts, a device goes away mid-swipe - and then
        # there is no drag-end at all: the grid stayed wherever the finger
        # had left it, half way up the screen with the strip half faded.
        self.drag.connect("cancel", self._on_drag_cancel)
        # `pkill -USR1 -f sfduo-dock` toggles the grid: a keybinding can be
        # pointed at it, and so can a test that has no finger.
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1,
                             lambda: self._toggle_grid() or True)
        # `pkill -USR2 -f sfduo-dock` launches what $XDG_RUNTIME_DIR/sfduo-launch
        # names - "org.gnome.Settings.desktop right" - exactly as a tap on its
        # button would: curtain, placement and all. For tests with no finger.
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR2,
                             lambda: self._launch_from_file() or True)

    @staticmethod
    def _load_placed():
        """Which panel each app was put on, remembered across a restart of
        the dock - it is the only record there is. The compositor will say
        which windows exist but not where they are."""
        try:
            # A record older than the compositor describes windows that died
            # with the last one: everything on the screen now is new, and
            # opened across both panels, whatever the file says. Believed, it
            # left the first-run wizard untiled after a restart of the shell.
            age = process_age(b"/usr/bin/phoc")
            if age is not None and time.time() - os.path.getmtime(PLACED) > age:
                return {}
            with open(PLACED) as fp:
                return {k: v for k, v in json.load(fp).items() if v in ("left", "right")}
        except (OSError, ValueError):
            return {}

    @staticmethod
    def _load_follows():
        """The Follow map as it was left: a page belongs to the program that
        opened it for as long as both are running, and the dock is restarted
        more often than they are."""
        try:
            with open(FOLLOWS) as fp:
                return {k: v for k, v in json.load(fp).items()
                        if isinstance(k, str) and isinstance(v, str)}
        except (OSError, ValueError):
            return {}

    def _save_follows(self):
        try:
            with open(FOLLOWS, "w") as fp:
                json.dump(self.follow, fp)
        except OSError as err:
            print(f"sfduo-dock: {FOLLOWS}: {err}", file=sys.stderr)

    def _save_placed(self):
        try:
            with open(PLACED, "w") as fp:
                json.dump(self.placed, fp)
        except OSError as err:
            print(f"sfduo-dock: {PLACED}: {err}", file=sys.stderr)
        # the window watcher saves from its own thread; the bus is the loop's
        GLib.idle_add(self._placement_changed)

    # ---- which panel each window is on, said on the bus --------------------

    DOCK_NAME = "org.sfduo.Dock"
    DOCK_PATH = "/org/sfduo/Dock"
    DOCK_XML = """
    <node>
      <interface name="org.sfduo.Dock">
        <property name="Placed" type="a{ss}" access="read"/>
        <property name="Busy" type="s" access="read"/>
        <property name="Follows" type="a{ss}" access="read"/>
        <method name="Follow">
          <arg name="app_id" type="s" direction="in"/>
          <arg name="leader" type="s" direction="in"/>
        </method>
      </interface>
    </node>"""

    def _publish_placement(self):
        """Publish placement, panel occupancy and page/leader relationships.

        The dock is the only one that knows. The compositor tiles a window
        when asked and keeps no record of the half, and the foreign-toplevel
        protocol carries no geometry. The port's shell lists the open windows
        in the far half's shade and says where each one is from this
        (phosh-patches/0009). Follows lets it leave out a page while the
        window it belongs to is still open (phosh-patches/0014)."""
        node = Gio.DBusNodeInfo.new_for_xml(self.DOCK_XML)
        self.follow = self._load_follows()   # app_id -> the app whose panel it goes to
        self.session_bus.register_object(
            self.DOCK_PATH, node.interfaces[0], self._on_dock_method,
            self._on_dock_property, None)
        Gio.bus_own_name_on_connection(self.session_bus, self.DOCK_NAME,
                                       Gio.BusNameOwnerFlags.NONE, None, None)

    def _on_dock_method(self, _conn, _sender, _path, _iface, method, params, invocation):
        """Follow(app_id, leader): the windows of app_id go on the panel the
        leader's window is on, not on the free one.

        For an app that opens another's pages - the port's Settings opens
        GNOME Settings and Mobile Settings - and wants them where it is
        itself: on one panel, the page over the list, nothing on the other.
        A window of app_id already open on the other panel is moved at once;
        one that is yet to open is placed so when it does (see _adopt)."""
        if method != "Follow":
            invocation.return_dbus_error("org.freedesktop.DBus.Error.UnknownMethod", method)
            return
        app_id, leader = params.unpack()
        changed = self.follow.get(app_id) != leader
        self.follow[app_id] = leader
        self._save_follows()
        if changed:
            self._follows_changed()
            # The buttons were laid out before this was known: a page that
            # already had one of its own keeps it until they are laid out
            # again, and the dock shows two gears for one Settings. Learning
            # this happens whenever the record has been lost - it lives in
            # the runtime directory, which a reboot empties.
            GLib.idle_add(self._relay_running)
        invocation.return_value(None)
        side = self.placed.get(leader)
        debug(f"{app_id} follows {leader} ({side})")
        if side in ("left", "right") and app_id in getattr(self, "last_ids", []) \
                and self.placed.get(app_id) != side:
            threading.Thread(target=self._move_to, args=(app_id, side), daemon=True).start()

    def _move_group(self, app_ids, side):
        """Move windows to a panel in order - the last one ends up on top -
        and set off across at once, with them: the panels they take are
        known now, the next look at the windows only confirms it."""
        for app_id in app_ids:
            self._move_to(app_id, side)
        # Called to this panel, it has to be visible on it: a window that was
        # put away is tiled where it belongs and stays away otherwise, which
        # is a tap on a dock button doing nothing at all.
        if app_ids:
            self._present(app_ids[-1])
        running = getattr(self, "running", {})
        self.window_busy = {self.placed.get(a, "both") for a, minimized in running.items()
                            if not minimized}
        GLib.idle_add(self._apply_mode)
        self.watch_wake.set()

    def _present(self, app_id):
        """Bring an app's windows out and to the front.

        A window that was put away is not shown again by tiling it, and a tap
        on a dock button is the hand asking for that app: the port's phoc
        wakes it and shows it when its client has caught up
        (org.sfduo.Phoc.Present, phoc-patches/0009). Anywhere else the focus
        does it, which is what the dock did before there was anything to put
        a window away with."""
        shown = 0
        # Restore: back as it was put away, shown at its first frame; the
        # port's phoc before it knew only Present, which waits for the
        # client to go quiet - ~400 ms longer (#149)
        for method in ("Restore", "Present"):
            try:
                shown = self.session_bus.call_sync(
                    "org.sfduo.Phoc", "/org/sfduo/Phoc", "org.sfduo.Phoc", method,
                    GLib.Variant("(s)", (app_id,)), GLib.VariantType("(u)"),
                    Gio.DBusCallFlags.NO_AUTO_START, 1000, None)[0]
                break
            except GLib.Error:
                continue
        if not shown:
            subprocess.run(["wlrctl", "toplevel", "focus", f"app_id:{app_id}"], check=False)

    def _expect(self, app_id, side):
        """Tell the port's phoc where the app's next window goes: it is put
        there as it maps, rather than once this dock has found it (#194).
        _place tiles it all the same, which does nothing to a window already
        there - and is what places it on a phoc without Expect, or when the
        window turns out to be called something else."""
        try:
            self.session_bus.call_sync(
                "org.sfduo.Phoc", "/org/sfduo/Phoc", "org.sfduo.Phoc", "Expect",
                GLib.Variant("(ss)", (app_id, side)), None,
                Gio.DBusCallFlags.NO_AUTO_START, 500, None)
        except GLib.Error:
            pass

    def _tile(self, app_id, side):
        """Ask the port's phoc to put an app's windows on a panel.

        Directly: no focus, no raise, and the window slides across - or, if
        it has not been seen yet, is simply put there (phoc-patches/0010).
        Returns whether anything was moved."""
        try:
            tiled = self.session_bus.call_sync(
                "org.sfduo.Phoc", "/org/sfduo/Phoc", "org.sfduo.Phoc", "Tile",
                GLib.Variant("(ss)", (app_id, side)), GLib.VariantType("(u)"),
                Gio.DBusCallFlags.NO_AUTO_START, 1000, None)[0]
        except GLib.Error:
            tiled = 0
        if not tiled:
            return False
        self.placed[app_id] = side
        self._save_placed()
        return True

    def _move_to(self, app_id, side):
        """Put an open window on a panel.

        The port's phoc does it directly (_tile). Anywhere else, as a user
        would: focus it, wait for it, the tiling chord - half a second a
        window."""
        if self._tile(app_id, side):
            return
        if not self._take_focus(app_id):
            return
        key = "Left" if side == "left" else "Right"
        if subprocess.run(["wtype", "-M", "logo", "-k", key, "-m", "logo"],
                          check=False).returncode == 0:
            self.placed[app_id] = side
            self._save_placed()

    def _on_dock_property(self, _conn, _sender, _path, _iface, name):
        if name == "Busy":
            return GLib.Variant("s", self._busy())
        if name == "Follows":
            return self._follows_variant()
        if name == "Placed":
            return self._placed_variant()
        return None

    def _follows_variant(self):
        return GLib.Variant("a{ss}", self.follow)

    def _follows_changed(self):
        # Follow runs on the main loop, like the D-Bus property callbacks.
        # The shade hides a page only while its leader has an open window.
        self.session_bus.emit_signal(
            None, self.DOCK_PATH, "org.freedesktop.DBus.Properties",
            "PropertiesChanged",
            GLib.Variant("(sa{sv}as)", (self.DOCK_NAME,
                                        {"Follows": self._follows_variant()}, [])))

    @property
    def compositor_holds(self):
        """Whether the compositor keeps a new window out of sight until it
        has been placed - the port's phoc, which owns org.sfduo.Phoc."""
        if getattr(self, "_holds", None) is None:
            try:
                self._holds = self.session_bus.call_sync(
                    "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
                    "NameHasOwner", GLib.Variant("(s)", ("org.sfduo.Phoc",)), None,
                    Gio.DBusCallFlags.NONE, 1000, None).unpack()[0]
            except GLib.Error:
                self._holds = False
            debug(f"the compositor holds new windows: {self._holds}")
        return self._holds

    def _busy(self):
        """Which panels have a window on them: "none", "left", "right" or
        "both". Windows only - the app grid does not count - so the shell can
        give a lone window the whole height of its panel and put the bar on
        the free one (phosh-patches/0011)."""
        busy = getattr(self, "window_busy", set())
        if "both" in busy or {"left", "right"} <= busy:
            return "both"
        if busy:
            return next(iter(busy))
        return "none"

    def _busy_changed(self):
        busy = self._busy()
        if busy == getattr(self, "busy_said", None):
            return False
        self.busy_said = busy
        debug(f"busy: {busy}")
        self._place_clock()
        self.session_bus.emit_signal(
            None, self.DOCK_PATH, "org.freedesktop.DBus.Properties",
            "PropertiesChanged",
            GLib.Variant("(sa{sv}as)", ("org.sfduo.Dock",
                                        {"Busy": GLib.Variant("s", busy)}, [])))
        return False

    def _place_clock(self):
        """The desktop's clock where the dock is: the free panel, the right
        one when both are, none when the dock is hidden (see DesktopClock)."""
        if not hasattr(self, "clock") or self.half <= 1:
            return
        side = {"both": "right", "left": "left", "right": "right"}.get(self._mode_for(False))
        left = None if side is None else (0 if side == "left" else self.half + self.gap)
        self.clock.place(left, self.half)

    def _placed_variant(self):
        return GLib.Variant("a{ss}", {k: v for k, v in self.placed.items()
                                      if v in ("left", "right")})

    def _placement_changed(self):
        self.session_bus.emit_signal(
            None, self.DOCK_PATH, "org.freedesktop.DBus.Properties",
            "PropertiesChanged",
            GLib.Variant("(sa{sv}as)", ("org.sfduo.Dock",
                                        {"Placed": self._placed_variant()}, [])))
        # The corner back button is offered for the window placed on its
        # panel: a launch lands on its panel after the window list has come
        # in, and without this the button stayed off until something else
        # reshaped the dock - Settings came up with no way back, now and then.
        self._shape()
        return False

    # ---- where the dock is ------------------------------------------------

    def _watch_windows(self):
        """Ask, on a beat, which panels have a window on them."""
        while True:
            while self.dark:                  # nothing is seen: wait for the light
                self.watch_wake.wait()
                self.watch_wake.clear()
            try:
                out = subprocess.run(["wlrctl", "toplevel", "list"],
                                     capture_output=True, text=True,
                                     check=False).stdout
                ids = [line.split(":", 1)[0].strip()
                       for line in out.splitlines() if ":" in line]
                # A window that is gone takes its placement with it: the
                # next window of that app is new, and maximized, and the
                # dock must tile it again rather than believe it is already
                # where it was. Settings opened across both panels because
                # of this once.
                gone = [a for a in self.placed if a not in ids]
                if gone:
                    for a in gone:
                        self.placed.pop(a, None)
                    self._save_placed()
                # The grid, a notification, the first-run wizard, a terminal:
                # a window nobody asked the dock for opens across both panels
                # like any other, and has the same right to one of its own.
                self._adopt_strangers(ids)
                busy = set()
                running = {}
                for app_id in ids:
                    minimized = subprocess.run(
                        ["wlrctl", "toplevel", "find", f"app_id:{app_id}",
                         "state:minimized"], check=False).returncode == 0
                    running[app_id] = minimized
                    if minimized:
                        continue
                    # A window we placed is on the panel we put it on; one
                    # we did not is assumed to span both.
                    busy.add(self.placed.get(app_id, "both"))
                GLib.idle_add(self._set_running, running)
                self.window_busy = busy
                GLib.idle_add(self._apply_mode)
                GLib.idle_add(self._busy_changed)
            except Exception as err:      # noqa: BLE001 - keep the beat going
                print(f"sfduo-dock: windows: {err}", file=sys.stderr)
            self.watch_wake.wait(WATCH_MS / 1000)
            self.watch_wake.clear()

    def _adopt_strangers(self, ids):
        """Put a window the dock did not launch on the free panel - the right
        one when both are free. Once per window: if the chord cannot reach it
        it stays as it opened, rather than being chased every beat."""
        self.adopted &= set(ids)
        self.last_ids = list(ids)
        if self.locked:
            GLib.idle_add(self._cover_strangers)        # see _set_locked
            return
        if self.placing:                                # a launch of our own
            return
        strangers = [a for a in ids if a not in self.placed and a not in self.adopted]
        if not strangers:
            # held for nothing - unless it waits for phoc to show the window
            # it was raised for, which is what it is there for (#182)
            if self.curtain_up and not self.placing and not self.awaiting_shown:
                GLib.idle_add(self._lift_curtain)
            return
        # It is already on the screen, across both panels; the move to one of
        # them happens behind the curtain all the same - unless the shell has
        # shown it cannot place windows, in which case there is nothing to
        # hide and the curtain would only be a black screen.
        # A curtain is only for a window that would be seen in the wrong
        # place. The port's compositor holds a new window until it has been
        # put on a panel and has drawn itself there (phoc-patches/0009), so
        # there is nothing to hide; anywhere else the window is up at its
        # own size for as long as the placing takes, and the panel is
        # covered meanwhile.
        if self.shell_places is not False and not self.compositor_holds:
            # a window that follows another goes to that one's panel, and
            # only that panel is covered: the other stays what it was
            follow = getattr(self, "follow", {})
            sides = {self.placed.get(follow.get(a)) for a in strangers}
            side = sides.pop() if len(sides) == 1 and None not in sides else None
            GLib.idle_add(lambda: self._raise_curtain(side=side, quiet=side is not None) or False)
        try:
            self._adopt(strangers)
        finally:
            GLib.timeout_add(CURTAIN_SETTLE, self._lift_curtain)

    def _adopt(self, strangers):
        for app_id in strangers:
            self.adopted.add(app_id)
            taken = set(self.placed.values())
            side = "left" if taken == {"right"} else "right"
            leader_side = self.placed.get(getattr(self, "follow", {}).get(app_id))
            if leader_side in ("left", "right"):
                side = leader_side                      # see _on_dock_method
            debug(f"adopting {app_id} onto the {side} panel")
            self._move_to(app_id, side)         # phoc's Tile, or focus and the chord

    # ---- a shell that cannot place windows -----------------------------------
    #
    # Placement is a chord to the focused window, and phosh as packaged never
    # focuses one after its app grid has closed: its home keeps the keyboard
    # (README, "When a launched app opens across both panels"; phosh-patches/
    # 0003 is the fix). On such a shell everything the dock does around a
    # launch is harm: a black curtain for as long as it waits, per launch and
    # per window it adopts. So the dock finds out, and steps back: no curtain,
    # no chord. (Maximizing the window instead is not open to it - phoc
    # refuses maximize, minimize and fullscreen for a window without the
    # focus; the dconf lock that keeps auto-maximize off for the tiling's
    # sake is dropped by sfduo-phosh-install on such a shell, and phosh then
    # maximizes windows itself.)
    #
    # shell_places is True, False or None (not known yet). It is read from the
    # binaries at start when the package's patched phosh is there to compare
    # with, and from the first window otherwise: one that takes the focus
    # settles it either way. False is not final - every window is still asked
    # once, because a shell that starts placing windows should be believed.

    def _shell_places(self):
        try:
            if not os.path.exists(PATCHED_PHOSH):
                return None
            if filecmp.cmp(SHELL_BIN, PATCHED_PHOSH, shallow=False):
                return True
        except OSError:
            return None
        self._step_back("the shell is not the patched phosh")
        return False

    def _step_back(self, why):
        if self.shell_places is False:
            debug(f"still cannot place windows: {why}")
            return
        self.shell_places = False
        print(f"sfduo-dock: {why} - this shell does not let a new window take "
              "the focus, so no window can be placed on a panel: they open "
              "across both, and the dock stays out of their way. The port's "
              "patched phosh fixes it; `sudo sfduo-phosh-install` says whether "
              "it is installed and, if not, why.", file=sys.stderr)

    def _take_focus(self, app_id):
        """Give the window the focus, and say whether it took it."""
        # Ask for the focus rather than hope for it: phoc gives it to a new
        # window on its own, but not when another window was raised meanwhile.
        subprocess.run(["wlrctl", "toplevel", "focus", f"app_id:{app_id}"],
                       check=False)
        if self._wait_for_window(app_id):
            self.shell_places = True
            return True
        # Asking did not help, so it is not a window that has the focus but a
        # layer surface with exclusive keyboard - phoc's log says "Layer
        # surface has focus, not focusing view yet" (LogDomains phoc-seat).
        # Behind the lock screen that is the lock screen, and proves nothing.
        if self.locked:
            debug(f"{app_id} never took the focus - the phone is locked")
            return False
        self._step_back(f"{app_id} never took the focus")
        return False

    def _relay_running(self):
        """Lay the running apps' buttons out again although the windows have
        not changed - something else that decides which of them deserve one
        has (a page learning whose it is)."""
        running = getattr(self, "running", None)
        if running is None:
            return False
        self.running = None                 # _set_running answers only to a change
        self._set_running(running)
        return False

    def _set_running(self, running):
        """running: app_id -> minimized. Dots on favourites, buttons for the
        rest, in every strip and both halves of the grid."""
        if running == getattr(self, "running", None):
            return False
        self.running = running
        self.privacy.set_camera(any("camera" in app_id.lower() for app_id in running))
        favourites_ = set()
        for pane in self.panes.values():
            favourites_.update(pane.slab.buttons)
        for pane in self.panes.values():
            slab = pane.slab
            for app_id, button in slab.buttons.items():
                button.dot.set_visible(app_id in running)
            for child in slab.running.get_children():
                slab.running.remove(child)
            # A running app that is no favourite gets a button in the half
            # for the panel it was put on, wherever that half is right now.
            for app_id in sorted(running):
                if app_id in favourites_ or self.placed.get(app_id, "right") != slab.side:
                    continue
                # a window opened by another app to follow it (Follow) is
                # part of that app while it runs: GNOME Settings under the
                # port's Settings was a second gear beside the first
                if getattr(self, "follow", {}).get(app_id) in running:
                    continue
                info = self._info_for(app_id)
                if info is None:
                    continue
                button = self._app_button(info, slab.side, slab.size)
                button.dot.set_visible(True)
                slab.running.pack_start(button, False, False, 0)
                button.show_all()
        for app_id, buttons in self.grid_apps.items():
            for button in buttons:
                button.dot.set_visible(app_id in running)
        self._relayout()
        self._shape()              # a window came or went: the back button follows it
        return False

    def _relayout(self):
        """Ask for the layout pass outright, a frame from now.

        Queueing one was not enough: a button added to a strip stayed one
        pixel wide, and the strip at the width it had at startup, for as
        long as nothing else made the window lay itself out again. And
        asking synchronously from inside the change did nothing either -
        the tree is not marked yet at that point. A frame later, it works.
        A half that changed width is put back where it belongs by its
        size-allocate (see _on_pane_size_allocate).
        """
        def pass_():
            for pane in self.panes.values():
                pane.resize(1, 1)       # to the natural size: a toplevel does not shrink on its own
                pane.check_resize()
                pane.queue_draw()
            return False
        GLib.timeout_add(16, pass_)

    @staticmethod
    def _info_for(app_id):
        info = desktop_info(app_id + ".desktop")
        if info is not None:
            return info
        for candidate in Gio.AppInfo.get_all():
            if wayland_app_id(candidate) == app_id:
                return candidate
        return None

    def _close_app(self, app_id):
        subprocess.Popen(["wlrctl", "toplevel", "close", f"app_id:{app_id}"])
        self.placed.pop(app_id, None)
        self._save_placed()

    def _mode_for(self, grid_open, system=None):
        """Where the dock goes: the panel with nothing on it. A window the
        dock placed takes its panel, one it did not takes both - and the
        open grid takes the panel it is on, so the dock crosses to the other
        one just as it does for a window."""
        # A shade pulled down is what the hand is holding and the eye is on.
        # The dock goes out of sight under it - both halves, whichever panel
        # the shade is over - and comes back when it folds. It took no
        # touches there anyway (see _shape), so what was left was a bar
        # standing under a shade for nothing.
        if self._shade_over("left") or self._shade_over("right"):
            return "hidden"
        busy = set(getattr(self, "window_busy", set()))
        if grid_open:
            busy.add(self.grid_side)
        # the system screen takes the left panel as the grid takes its own -
        # from a little way out: a touch wakes it at a sliver (#111)
        if system is None:
            system = getattr(self, "system_progress", 0.0) >= SYSTEM_BUSY
        if system:
            busy.add("left")
        # the keyboard is a layer surface, not a window, and takes a panel
        # of its own (osk-patches/0001): while it is up that panel is taken
        if getattr(self, "osk_panel", None):
            busy.add(self.osk_panel)
        # a launch in flight takes its panel from the moment of the tap - the
        # dock is on its way before the window exists, not after it lands -
        # and the window it brings, spanning both panels until it is tiled,
        # is not a reason to hide: it is the launch's, headed for its panel
        launching = getattr(self, "launching", {})
        if launching:
            busy.discard("both")
            busy.update(launching.values())
        if not busy:
            return "both"
        if busy == {"left"}:
            return "right"
        if busy == {"right"}:
            return "left"
        return "hidden"

    def _apply_mode(self):
        """Put the dock where the windows and the grid say.

        While the grid is on its way - under a finger, or settling after one
        - the dock goes with it: the halves stand where the grid's progress
        says, between where they are with it closed and where they are with
        it open, and so a slow swipe moves them slowly and a flick sends
        them across, parking with the grid's own ease-out. Only once the
        grid is all the way up or down does the mode settle.
        """
        sp = getattr(self, "system_progress", 0.0)
        if SYSTEM_BUSY <= sp < 1.0 and self.progress <= 0.0:
            # the halves go with the system screen, a step per step, as they
            # go with the grid's finger
            self._place_clock()
            self._drive(self._mode_for(False, system=False), self._mode_for(False, system=True), sp)
            return False
        closed = self._mode_for(False)
        opened = self._mode_for(True)
        self._place_clock()
        closing = getattr(self, "grid_closing", False)
        in_motion = 0.0 < self.progress < 1.0 or (self.progress >= 1.0 and closing)
        if in_motion and closed != opened and closed != "hidden":
            self._drive(closed, opened, self.progress)
            return False
        self._set_mode(opened if self.progress > 0.0 and not getattr(self, "grid_closing", False)
                       else closed)
        return False

    def _drive(self, closed, opened, k):
        """The halves at k of the way from the `closed` layout to the
        `opened` one, by hand: the grid's finger is the clock."""
        mode = opened if not getattr(self, "grid_closing", False) else closed
        if self.move is not None:
            GLib.source_remove(self.move)
            self.move = None
        if mode != self.mode:
            debug("mode %s -> %s, with the grid" % (self.mode, mode))
            self.mode = mode
            self._style_for(mode)
            self._shape()
        a, b = self._pane_targets(closed), self._pane_targets(opened)
        if opened == "hidden":          # straight down from where it stands closed
            b = {side: (a[side][0], -DOCK_HEIGHT) for side in a}
        for side, pane in self.panes.items():
            (x0, y0), (x1, y1) = a[side], b[side]
            pane.move(x=x0 + (x1 - x0) * k, y=y0 + (y1 - y0) * k)
        self.driven = True

    def _settle_panes(self, mode):
        """Stand the halves where the mode puts them, if it still does."""
        if mode == self.mode and not getattr(self, "driven", False):
            targets = self._pane_targets(mode)
            for side, pane in self.panes.items():
                x, y = targets[side]
                pane.move(x=x, y=y)
                pane.move(settle=True)
            GLib.timeout_add(250, self._repaint_panes)
        return False

    def _repaint_panes(self):
        """One more frame of each half, once everything has stopped: phoc
        damages a moved layer surface and asks for a frame, and now and then
        that frame was not drawn until something else on the screen changed -
        the halves stood where the last driven frame had put them, a gap
        between them, for seconds (#104). A commit with a buffer asks again."""
        for pane in self.panes.values():
            pane.queue_draw()
        return False

    def _pane_targets(self, mode):
        """Where each half stands in a mode: its left margin on the screen.

        Across both panels each half stands at its panel's outer edge - the
        thumbs of two hands holding the open device rest there, and the
        hinge is the far reach (the halves hugged the hinge until 0.15.4;
        the owner moved them). On one panel the two stand side by side, the
        left half first, centred on the panel - unless together they are
        wider than it, in which case they start at its edge and the tail
        runs over the hinge (a dock of favourites and a few running apps at
        scale 3; rare).
        """
        left, right = self.panes["left"], self.panes["right"]
        if mode == "hidden":            # below the edge, wherever it stands
            return {s: (p.x, -DOCK_HEIGHT) for s, p in self.panes.items()}
        if mode == "both":
            return {"left": (EDGE_MARGIN, 0),
                    "right": (2 * self.half + self.gap - right.width - EDGE_MARGIN, 0)}
        start = max(0, (self.half - left.width - right.width) // 2)
        if mode == "right":
            start += self.half + self.gap
        return {"left": (start, 0), "right": (start + left.width, 0)}

    def _style_for(self, mode):
        """Square where the halves meet, rounded all round when apart."""
        for pane in self.panes.values():
            context = pane.slab.get_style_context()
            if mode == "both":
                context.remove_class("joined")
            else:
                context.add_class("joined")

    def _place_panes(self):
        """Put the halves where the mode says, now, no motion: after the
        display's size came in, or a half changed width."""
        if self.mode == "hidden":
            return
        self._style_for(self.mode)
        for side, (x, y) in self._pane_targets(self.mode).items():
            self.panes[side].move(x=x, y=y, settle=True)
        self._shape()

    def _set_mode(self, mode):
        """Move the dock to where it should be now, in a straight line.

        The halves slide - towards each other onto the free panel when one
        panel is taken, together across the hinge when the other is freed
        and this one taken - easing out, so they park rather than stop. A
        slide moves the surfaces and repaints nothing (see PaneWindow). Into
        "hidden" (both panels taken) they dip below the edge and stay there;
        out of it they rise where they are next wanted. The gesture bands
        along the bottom are this window's, and stay wherever the halves go.
        """
        if mode == self.mode:
            if getattr(self, "driven", False):
                # The grid's finger brought the halves here, and they stay
                # here: let gtk-layer-shell know. Here is where the mode
                # puts them, not where the last driven frame left them - that
                # frame comes a little before the grid is all the way up, and
                # the halves stood ~50 px apart on the other panel (#104).
                # Moved as a motion moves them, straight to the compositor -
                # gtk-layer-shell's margins reach it only with a repaint,
                # and a half is never repainted - then settled. Two frames
                # later, not now: this comes ~16 ms after the last driven
                # frame, and phoc, handed two positions within one frame,
                # now and then showed the first of them for seconds.
                self.driven = False
                GLib.timeout_add(2 * FRAME_MS + 2, self._settle_panes, mode)
            return False
        self.driven = False
        was_hidden = self.mode == "hidden"
        debug("mode %s -> %s (move running: %s)" % (self.mode, mode, self.move is not None))
        self.mode = mode
        if mode != "hidden":
            self._style_for(mode)           # one small repaint, at the start of the move
        if self.move is not None:
            GLib.source_remove(self.move)
            self.move = None
        panes = self.panes
        frames = []
        targets = self._pane_targets(mode)
        if was_hidden and mode != "hidden":
            # below the edge nothing shows: stand where the rise is due
            for side, pane in panes.items():
                pane.move(x=targets[side][0])
        start = {s: (p.x, p.y) for s, p in panes.items()}
        self._shape()          # the bands: a panel that is now busy, or free
        if all(start[s] == targets[s] for s in panes):
            # brought here by the grid's finger already: just settle
            for side, pane in panes.items():
                pane.move(settle=True)
            self.replace_when_still = False
            return False

        def step(t):
            frames.append(t)
            k = min(1.0, t / MOVE_MS)
            eased = 1.0 - (1.0 - k) ** 3            # ease-out cubic: parks, does not stop
            for side, pane in panes.items():
                (x0, y0), (x1, y1) = start[side], targets[side]
                pane.move(x=x0 + (x1 - x0) * eased, y=y0 + (y1 - y0) * eased,
                          settle=k >= 1.0)
            if k >= 1.0:
                self.move = None
                self._shape()
                if getattr(self, "replace_when_still", False):
                    # a half changed width while this was running: it was
                    # carried to where its old width said (_on_pane_size_allocate)
                    self.replace_when_still = False
                    self._place_panes()
                self._report("dock %s" % ("dipping" if mode == "hidden" else "crossing to " + mode), frames)
                return False
            return True

        self.move = animate(step)
        return False

    @staticmethod
    def _report(what, frames):
        """One line per animation: to the debug output, and always to
        $XDG_RUNTIME_DIR/sfduo-dock.perf, which sfduo-perfcheck reads."""
        if len(frames) <= 1:
            return
        gaps = [b - a for a, b in zip(frames, frames[1:])]
        line = "%s: %d frames over %.0f ms, %.1f ms/frame (max %.0f)" % (
            what, len(frames), frames[-1], sum(gaps) / len(gaps), max(gaps))
        debug(line)
        try:
            with open(PERF_LOG, "a") as fp:
                fp.write("%.3f %s\n" % (time.time(), line))
        except OSError:
            pass

    # ---- the grid's motion ------------------------------------------------

    @property
    def grid_open(self):
        return self.progress >= 1.0

    def _set_progress(self, progress):
        """Put the grid where a progress of 0..1 says, and the strip with it."""
        was_open = self.progress > 0.0
        self.progress = max(0.0, min(1.0, progress))
        self.grids[self.grid_side].place(self.progress)
        if hasattr(self, "mode"):
            # the grid takes or frees its panel: the dock goes with it, a
            # step per step (see _apply_mode); the input region follows once
            self._apply_mode()
            if (self.progress > 0.0) != was_open:
                self._shape()
        debug("progress %.2f grid h=%d" % (self.progress, self.grids[self.grid_side].get_allocated_height()))

    def _shape(self):
        """Where this window takes touches: the strip of a free panel, less
        the halves standing on it (their touches are their own windows'), and
        the band along the bottom of a busy one. Everything else falls
        through to what is underneath."""
        win = self.get_window()
        if win is None:
            return
        half, gap = self.half, self.gap
        region = cairo.Region()
        if not self.locked:                 # locked: the lock screen's touches are its own
            for side, x in (("left", 0), ("right", half + gap)):
                if self._shade_over(side):
                    continue                        # the shade owns this panel
                elif self.progress > 0.0 and side == self.grid_side:
                    continue                        # the grid window takes this panel
                elif self.mode in ("both", side):   # the dock is here
                    region.union(cairo.RectangleInt(x, 0, half, DOCK_HEIGHT))
                else:                               # a window is here
                    region.union(cairo.RectangleInt(x, DOCK_HEIGHT - EDGE, half, EDGE))
            if self.mode != "hidden":
                for pane in self.panes.values():
                    region.subtract(cairo.RectangleInt(pane.x, 0, pane.width, DOCK_HEIGHT))
        win.input_shape_combine_region(region, 0, 0)
        # GTK hands the region to the compositor with the next commit, and
        # this window draws nothing to commit: without a frame the strip kept
        # its old region, and an open shade lost its bottom 84 px to it. One
        # pixel's frame carries it: the whole strip redrawn, 2784x168, was
        # drawn in software and uploaded again inside a step of the grid's
        # slide, which lost a frame to it (#148).
        self.queue_draw_area(0, 0, 1, 1)
        # the outer edges swipe back where the bottom band swipes the window,
        # and the outer corner of the same panel carries the arrow for it
        for side, strip in getattr(self, "back_strips", {}).items():
            # by the windows alone: the grid rising over a panel took it busy
            # and back, and each strip shown again uploaded its buffer inside
            # the grid's slide (#148); under the grid it takes no touch anyway
            on = (not self.locked and not self._shade_over(side)
                  and self._mode_for(False, system=False) not in ("both", side))
            strip.set_active(on)
            button = getattr(self, "back_buttons", {}).get(side)
            if button is not None:
                button.set_active(on and self._back_offered(side))
        for pane in self.panes.values():
            pane.passthrough(self._shade_over(self._panel_of_pane(pane)))
        # the swipes from anywhere: over a free panel's desktop, and kept
        # under a finger that is already on one
        # - and over the right one while the system screen is out, which a
        # swipe left there takes back, as a swipe right there brought it
        system = getattr(self, "system_progress", 0.0)
        for side, catcher in getattr(self, "catchers", {}).items():
            # Not taken away for the grid: it lies above them and takes the
            # touches itself, and a catcher shown again uploaded its whole
            # 1350x1584 buffer as the grid came down (#148).
            catcher.set_active(getattr(self, "catching", None) == side or (
                not self.locked and not self._shade_over(side)
                and self._mode_for(False, system=False) in ("both", side)
                and (system <= 0.0 or (side == "right" and system >= 1.0))))

    def _animate_to(self, target):
        """Finish the journey from wherever the grid is, easing out."""
        self._stop_animation()
        # The dock's crossing runs alongside the grid's slide, both ways:
        # a grid on its way down has already given its panel back.
        self.grid_closing = target <= 0.0
        self._apply_mode()
        start = self.progress
        if abs(target - start) < 0.001:
            self._set_progress(target)
            return
        # The remaining distance takes a proportional share of the time, so
        # a grid released near its destination does not crawl the last bit.
        duration = SLIDE_MS * abs(target - start)
        frames = []

        def step(t):
            frames.append(t)
            k = min(1.0, t / duration) if duration > 0 else 1.0
            eased = 1.0 - (1.0 - k) ** 3               # ease-out cubic
            self._set_progress(start + (target - start) * eased)
            if k >= 1.0:
                self.animation = None
                self._report("grid slide to %.0f" % target, frames)
                return False
            return True

        self.animation = animate(step)

    def _stop_animation(self):
        if self.animation is not None:
            GLib.source_remove(self.animation)
            self.animation = None

    def _toggle_grid(self, open_=None):
        if open_ is None:
            open_ = not self.grid_open
        self._animate_to(1.0 if open_ else 0.0)

    # ---- the finger -------------------------------------------------------

    # ---- back from the edge (#80) --------------------------------------------

    def _back_begin(self, strip, y):
        self.back_y = BACK_TOP + y
        self.back_travel = 0
        self.back_armed = False
        self.back_claimed = False

    def _back_update(self, strip, dx):
        travel = max(0.0, dx if strip.side == "left" else -dx)
        if not self.back_claimed and travel >= SWIPE_PX:
            self.back_claimed = True
            strip.drag.set_state(Gtk.EventSequenceState.CLAIMED)
        self.back_travel = travel
        arrow = self.back_arrows[strip.side]
        # out of the edge with the finger, a little slower than it, until
        # all but a sliver of it is out: the arrow shows, the finger decides
        arrow.move(self.back_y, min(travel * 0.7, BACK_SIZE * 0.9) - BACK_SIZE)
        armed = travel >= BACK_ARM
        if armed != self.back_armed:
            self.back_armed = armed
            arrow.set_armed(armed)

    def _back_end(self, strip):
        arrow = self.back_arrows[strip.side]
        arrow.set_armed(False)
        arrow.move(self.back_y, -BACK_SIZE)
        if getattr(self, "back_armed", False):
            self.back_armed = False
            threading.Thread(target=self._go_back, args=(strip.side,), daemon=True).start()

    def _back_cancel(self, strip):
        self.back_armed = False
        self._back_end(strip)

    # ---- the shell's accent ------------------------------------------------

    def _follow_accent(self):
        """Wear the accent colour chosen in Settings, and keep wearing it.

        GNOME 47 gave the desktop nine named accents
        (`org.gnome.desktop.interface accent-color`); Appearance is where
        one is picked. The corner's back button is the port's own furniture
        sitting over somebody else's window, so it takes the colour the rest
        of the system is wearing rather than inventing one."""
        self.accent_css = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), self.accent_css,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
        try:
            self.interface = Gio.Settings.new("org.gnome.desktop.interface")
        except GLib.Error:
            self.interface = None
            return
        self.interface.connect("changed::accent-color", lambda *_a: self._accent_css())
        self._accent_css()

    def _accent_css(self):
        if self.interface is None:
            return
        try:
            name = self.interface.get_string("accent-color")
        except (GLib.Error, TypeError):
            name = "blue"
        rgb = ACCENTS.get(name, ACCENTS["blue"])
        debug(f"accent: {name}")
        # The bar takes a wash of the same colour rather than the colour
        # itself: it lies under everything the eye is actually looking at,
        # and a bar in full accent would be the brightest thing on a dark
        # screen. The dot under a running app is the accent outright - it
        # is small, and saying "this one is open" is its whole job.
        wash = ",".join(str(round(base * (1 - ACCENT_WASH) + accent * ACCENT_WASH))
                        for base, accent in zip(DOCK_BASE, (int(v) for v in rgb.split(","))))
        self.accent_css.load_from_data((
            ".corner-back { color: rgb(%s); }"
            ".dock-pane { background-color: rgba(%s,0.92); }"
            ".running-dot { color: rgb(%s); }"
            % (rgb, wash, rgb)).encode())

    def _back_tapped(self, side):
        """The corner arrow: the same thing the edge swipe ends in."""
        debug(f"back button on the {side} panel")
        threading.Thread(target=self._go_back, args=(side,), daemon=True).start()

    def _back_target(self, panel):
        """The window that would hear Alt+Left on that panel: the one on top
        when there are two - a page Settings opened over itself (Follow) is
        the follower - or nothing when the panel is empty."""
        running = getattr(self, "running", {})
        here = [a for a, p in self.placed.items()
                if p == panel and a in running and not running[a]]
        followers = [a for a in here if a in getattr(self, "follow", {})]
        return (followers or here or [None])[-1]

    def _back_offered(self, panel):
        """Whether to draw the corner button: only where back leads somewhere
        (see BACK_APPS). The swipe is offered everywhere regardless."""
        target = self._back_target(panel)
        return target is not None and (target in BACK_APPS
                                       or target in getattr(self, "follow", {}))

    def _go_back(self, panel):
        """Alt+Left to the window on that panel: back, to libadwaita and to
        Firefox."""
        target = self._back_target(panel)
        if target in TERMINALS:
            debug(f"back on the {panel} panel: {target} is a terminal, nothing sent")
            return
        if target is not None:
            subprocess.run(["wlrctl", "toplevel", "focus", f"app_id:{target}"], check=False)
            time.sleep(0.05)
        debug(f"back on the {panel} panel: {target or 'the active window'}")
        subprocess.run(["wtype", "-M", "alt", "-k", "Left", "-m", "alt"], check=False)

    def _panel_at(self, x):
        """The panel under an x of this window, which spans the display."""
        return "left" if x < self.half else "right"

    def _panel_of_pane(self, pane):
        """The panel a half of the dock is on right now."""
        return self.mode if self.mode in ("left", "right") else pane.side

    def _begin_drag(self, panel):
        # A shade pulled down over this panel owns every gesture on it. The
        # dock is a layer above, so its strip along the bottom edge is still
        # in front of the shade and still takes the finger - and the swipe
        # that closes a shade is a swipe up, the same one that raises the
        # grid. The grid was coming out from under the shade instead.
        self.drag_blocked = self._shade_over(panel)
        if self.drag_blocked:
            debug("drag on the %s panel ignored: its shade is down" % panel)
            self.drag_claimed = False
            self.drag_app = None
            self.drag_on_grid = False
            return
        debug("drag begin on the %s panel, mode=%s" % (panel, self.mode))
        self._stop_animation()
        self.drag_on_grid = False
        self.drag_start = self.progress
        self.drag_claimed = False
        self.drag_last = (GLib.get_monotonic_time(), 0.0)
        self.drag_velocity = 0.0
        # A swipe that starts over a panel with a window on it is about that
        # window, not the grid: up puts it away, however far it goes.
        self.drag_app = None
        if self.progress <= 0.0 and self.mode not in ("both", panel):
            self.drag_app = next((a for a, p in self.placed.items() if p == panel), None)
            if self.drag_app is None:
                # A window the dock did not place spans both panels; the
                # one under the finger is the active one.
                self.drag_app = "state:active"
        elif self.progress <= 0.0:
            # A swipe up on a free panel raises the grid on that panel.
            self._show_grid_on(panel)
            self.grid_closing = False

    def _on_grid_drag_begin(self, _gesture, x, y):
        """A drag that starts on the open grid: down closes it."""
        self.drag_blocked = False
        debug("grid drag begin x=%.0f y=%.0f" % (x, y))
        self._stop_animation()
        self.drag_on_grid = True
        self.drag_start = self.progress
        self.drag_claimed = False
        self.drag_last = (GLib.get_monotonic_time(), 0.0)
        self.drag_velocity = 0.0
        self.drag_app = None

    def _on_drag_update(self, gesture, _dx, dy):
        if getattr(self, "drag_blocked", False):
            return
        # The offset GTK reports is relative to the window the drag is on.
        # The grid's window moves under the finger as the finger drives it,
        # so on it the offset shrinks as the grid follows - a slow swipe
        # down came out as a wobble around zero, the grid never moved and
        # the release was a click on the icon under it (#47). Add back what
        # the window has travelled since the drag began: that is the
        # finger's path on the screen.
        if getattr(self, "drag_on_grid", False):
            dy += STAGE_HEIGHT * (self.drag_start - self.progress)
        # Once it is a swipe, it is ours: the button it started over does
        # not also fire.
        if not self.drag_claimed:
            if abs(dy) < SWIPE_PX:
                return
            self.drag_claimed = True
            gesture.set_state(Gtk.EventSequenceState.CLAIMED)
        if self.drag_app is not None:
            self.drag_last = (GLib.get_monotonic_time(), dy)
            return
        now = GLib.get_monotonic_time()
        then, last_dy = self.drag_last
        if now > then:
            self.drag_velocity = (dy - last_dy) / ((now - then) / 1000.0)  # px/ms
        self.drag_last = (now, dy)
        # A finger going up raises the grid, faster than it moves: a full
        # swipe of the stage is a stretch, half of it is a gesture.
        self._set_progress(self.drag_start - dy / (STAGE_HEIGHT * GRID_TRAVEL))

    def _on_drag_cancel(self, _gesture, _sequence):
        if getattr(self, "drag_blocked", False):
            self.drag_blocked = False
            return
        debug("drag cancelled at %.2f" % self.progress)
        if getattr(self, "drag_claimed", False) and getattr(self, "drag_app", None) is None:
            self._animate_to(1.0 if self.progress >= GRID_COMMIT else 0.0)
        self.drag_claimed = False

    def _on_drag_end(self, _gesture, _dx, dy):
        if getattr(self, "drag_blocked", False):
            self.drag_blocked = False
            return
        debug("drag end dy=%.0f claimed=%s velocity=%.2f progress=%.2f"
              % (dy, self.drag_claimed, self.drag_velocity, self.progress))
        if not self.drag_claimed:
            return
        # The button under the finger still hears the release as a click:
        # GTK's buttons take the pointer GDK emulates from the touch, a
        # sequence of its own that our claim does not deny. So the click
        # handlers ask whether a swipe was just claimed (#47); the flag is
        # lifted once this release has been dispatched.
        self.swiped = True
        GLib.idle_add(self._unswipe)
        if self.drag_app is not None:
            # However far it goes, a swipe over a window puts it away. It
            # used to close the window past a length of travel, which is one
            # gesture standing for two things that cannot be taken back the
            # same way - a window swiped a finger too far was gone. Closing
            # is the far shade's list of windows and the application's own.
            if dy >= -SWIPE_PX:
                return
            target = self.drag_app if self.drag_app.startswith("state:") else f"app_id:{self.drag_app}"
            subprocess.Popen(["wlrctl", "toplevel", "minimize", target])
            return
        # A flick decides by direction; a slow release, by which side of
        # halfway the grid was left on.
        if self.drag_velocity < -FLICK:
            target = 1.0
        elif self.drag_velocity > FLICK:
            target = 0.0
        else:
            target = 1.0 if self.progress >= GRID_COMMIT else 0.0
        self._animate_to(target)

    # ---- the system screen (#109, #111) ------------------------------------------

    SYSTEM_NAME = "org.sfduo.SystemScreen"
    SYSTEM_PATH = "/org/sfduo/SystemScreen"

    def _system_call(self, method, args=None):
        self.session_bus.call(self.SYSTEM_NAME, self.SYSTEM_PATH, self.SYSTEM_NAME, method, args,
                              None, Gio.DBusCallFlags.NO_AUTO_START, 1000, None, None)

    def _follow_system(self):
        """The system screen says its progress as it moves; the clock and the
        dock's left half move with it."""
        self.session_bus.signal_subscribe(
            self.SYSTEM_NAME, "org.freedesktop.DBus.Properties", "PropertiesChanged",
            self.SYSTEM_PATH, None, Gio.DBusSignalFlags.NONE,
            lambda _c, _s, _p, _i, _sig, params: self._on_system_changed(params.unpack()[1]))
        # and when it comes or goes: a system screen that went away open, and
        # the one started after it, left the dock thinking it still was - the
        # new one's first word came before the dock knew it was the owner
        self.session_bus.signal_subscribe(
            "org.freedesktop.DBus", "org.freedesktop.DBus", "NameOwnerChanged",
            "/org/freedesktop/DBus", self.SYSTEM_NAME, Gio.DBusSignalFlags.NONE,
            lambda *_a: self._read_system())

    def _read_system(self):
        def got(bus, result):
            try:
                progress = bus.call_finish(result).unpack()[0]
            except GLib.Error:
                progress = 0.0                    # nobody: nothing is out
            self._on_system_changed({"Progress": float(progress)})
        self.session_bus.call(self.SYSTEM_NAME, self.SYSTEM_PATH, "org.freedesktop.DBus.Properties",
                              "Get", GLib.Variant("(ss)", (self.SYSTEM_NAME, "Progress")), None,
                              Gio.DBusCallFlags.NO_AUTO_START, 1000, None, got)

    def _on_system_changed(self, changed):
        if "Progress" in changed:
            self.system_progress = float(changed["Progress"])
            self.clock.slide(self.system_progress if self.system_progress >= SYSTEM_BUSY else 0.0)
            self._apply_mode()
            self._shape()

    # ---- a swipe from anywhere on an empty panel (#135) -------------------------

    def _system_free(self):
        """Whether the system screen may come: the left panel it takes has no
        window on it (#111)."""
        return self._mode_for(False, system=False) in ("both", "left")

    def _on_catch_begin(self, side):
        debug(f"touch on the {side} panel's desktop")
        self.catching = side
        self.catch_kind = None
        self.catch_system_out = self.system_progress >= 1.0
        if not self.catch_system_out and self._system_free():
            self._on_system_drag_begin(None, 0, 0)       # it wakes at the touch

    def _on_catch_update(self, side, gesture, dx, dy):
        """The first SWIPE_PX of travel decide what the finger is doing; from
        then on it is that gesture's, as if it had started where that one
        does."""
        if self.catch_kind is None:
            if abs(dy) >= SWIPE_PX and abs(dy) > abs(dx):
                # down is the shade's: phoc drags it and takes the touch
                # from here once it is a drag
                self.catch_kind = "grid" if dy < 0 else "shade"
            elif abs(dx) >= SWIPE_PX:
                if self.catch_system_out:
                    # the system screen is out: left takes it back
                    self.catch_kind = "system" if dx < 0 else "none"
                    if dx < 0:
                        self._on_system_drag_begin(None, 0, 0, back=True)
                else:
                    self.catch_kind = "system" if dx > 0 and self._system_free() else "none"
            else:
                return
            if self.catch_kind == "grid" and self.catch_system_out:
                self.catch_kind = "none"                 # no grid beside it
            debug(f"swipe on the {side} panel's desktop: {self.catch_kind}")
            if self.catch_kind != "system" and self.system_dragging:
                self._on_system_drag_end(None, 0, 0)     # the wake-up sliver goes again
            if self.catch_kind == "grid":
                self._begin_drag(side)
            elif self.catch_kind in ("shade", "none"):
                gesture.set_state(Gtk.EventSequenceState.DENIED)
        if self.catch_kind == "system":
            self._on_system_drag_update(gesture, dx, dy)
        elif self.catch_kind == "grid":
            self._on_drag_update(gesture, dx, dy)

    def _on_catch_end(self, side, gesture, dx, dy):
        kind, self.catching, self.catch_kind = self.catch_kind, None, None
        if kind == "system":
            self._on_system_drag_end(gesture, dx, dy)
        elif kind == "grid":
            self._on_drag_end(gesture, dx, dy)
        elif self.system_dragging:
            self._on_system_drag_end(None, 0, 0)
        self._shape()

    def _on_catch_cancel(self, side):
        """The touch was taken: phoc dragging the shade, or the shell."""
        kind, self.catching, self.catch_kind = self.catch_kind, None, None
        if kind == "grid":
            self._on_drag_cancel(None, None)
        elif kind == "system" or self.system_dragging:
            self._on_system_drag_end(None, 0, 0)
        self._shape()

    def _on_system_drag_begin(self, _gesture, _x, _y, back=False):
        """A finger on the free left panel: wake the system screen now, so
        that its first frames - ~80 ms after idle - are ready by the time
        the finger has moved (#110). Or, `back`, a finger taking an open
        one back from the right panel (#135): it goes the other way, and is
        up already."""
        self.system_dragging = True
        self.sys_claimed = False
        self.sys_back = back
        self.sys_last = (GLib.get_monotonic_time(), 0.0)
        self.sys_velocity = 0.0
        if not back:
            self._system_call("Begin")

    def _on_system_drag_update(self, gesture, dx, dy):
        if not self.sys_claimed:
            if abs(dy) >= SWIPE_PX and abs(dy) > abs(dx):
                gesture.set_state(Gtk.EventSequenceState.DENIED)
                self._on_system_drag_end(None, 0, 0)
                return
            if (-dx if self.sys_back else dx) < SWIPE_PX:
                return
            self.sys_claimed = True
            gesture.set_state(Gtk.EventSequenceState.CLAIMED)
            debug("system screen: swipe claimed")
        now = GLib.get_monotonic_time()
        then, last = self.sys_last
        if now > then:
            self.sys_velocity = (dx - last) / ((now - then) / 1000.0)      # px/ms
        self.sys_last = (now, dx)
        p = max(0.001, min(1.0, (1.0 if self.sys_back else 0.0) + dx / max(1, self.half)))
        self._system_call("SetProgress", GLib.Variant("(d)", (p,)))

    def _on_system_drag_end(self, _gesture, dx, _dy):
        claimed = getattr(self, "sys_claimed", False)
        back = getattr(self, "sys_back", False)
        self.sys_claimed = False
        self.system_dragging = False
        if not claimed:
            # a touch that was not the swipe: the wake-up sliver goes again,
            # and an open one taken back stays
            self._system_call("Open" if back else "SetProgress",
                              None if back else GLib.Variant("(d)", (0.0,)))
            self._shape()
            return
        p = (1.0 if back else 0.0) + dx / max(1, self.half)
        if self.sys_velocity > FLICK:
            method = "Open"
        elif self.sys_velocity < -FLICK:
            method = "Close"
        else:
            method = "Open" if p >= (SYSTEM_KEEP if back else SYSTEM_COMMIT) else "Close"
        debug("system screen: release at %.2f, %.2f px/ms: %s" % (p, self.sys_velocity, method))
        self._system_call(method)
        self._shape()

    def _follow_lockscreen(self):
        """Get out of the way while the phone is locked.

        The dock is on the overlay layer, which is above the lock screen as
        well as above everything else, so it has to be told.

        logind's LockedHint on the seat's session is the source. phosh's
        org.gnome.ScreenSaver answers false while its lock screen is on the
        display - "active" there means blanked, not locked - so it is asked
        only as a second opinion: either one saying "locked" is enough.

        The hint has a hole of its own. phosh comes up locked, and 0.49 as
        packaged does not tell logind until the first unlock; the port's phosh
        is patched to (phosh-patches/0001). The dock does not paper over an
        unpatched one: 0.13.0 set the hint itself when it started beside a
        young shell, and a dock that starts after a quick unlock - twenty
        seconds into a boot, it usually does - then marked an unlocked phone
        as locked, for good, and hid. A dock over the first lock screen is the
        smaller harm. Until phosh owns org.gnome.ScreenSaver the hint means
        nothing either way, and the dock stays out of sight.

        The session has to be found rather than assumed: `self` is whichever
        session the process was started from, which for anything launched over
        ssh is not the one with the screen. The seat session is the wayland
        one attached to a seat.
        """
        self.system_bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        self.session_bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        self.session_path = None
        self.session_bus.signal_subscribe(
            None, "org.gnome.ScreenSaver", "ActiveChanged",
            "/org/gnome/ScreenSaver", None, Gio.DBusSignalFlags.NONE,
            lambda *a: self._read_locked())

        # Any session's property change; which session is decided on read,
        # because the one that owns the screen is not there yet when the
        # dock starts two seconds behind the shell, and is a different one
        # after every restart of the shell.
        # logind's sessions only, picked by the interface named in the
        # signal's first argument - not by sender, which drops signals (see
        # the README). Subscribed to every PropertiesChanged on the system
        # bus this ran a dozen times a second: the modem, the battery and
        # the network never stop changing.
        self.system_bus.signal_subscribe(
            None, "org.freedesktop.DBus.Properties",
            "PropertiesChanged", None, "org.freedesktop.login1.Session",
            Gio.DBusSignalFlags.NONE, lambda *a: self._read_locked())
        # A signal that never comes is indistinguishable from a phone that is
        # simply not locked, so ask as well.
        GLib.timeout_add_seconds(2, self._read_locked)
        self._read_locked()

    # ---- the keyboard ------------------------------------------------------

    OSK_PANEL = "right"       # where the patched phosh-osk-stub puts itself in landscape

    def _follow_keyboard(self):
        """Know when the on-screen keyboard is up: it stood under the dock
        otherwise (#51). phosh-osk-stub publishes sm.puri.OSK0 with a Visible
        property that emits changes; the dock reads it and counts the
        keyboard's panel as taken while it is true."""
        self.osk_panel = None
        self.session_bus.signal_subscribe(
            None, "org.freedesktop.DBus.Properties", "PropertiesChanged",
            "/sm/puri/OSK0", "sm.puri.OSK0", Gio.DBusSignalFlags.NONE,
            lambda _c, _s, _p, _i, _sig, params: self._on_osk_changed(params[1]))
        # and when the keyboard process comes or goes
        self.session_bus.signal_subscribe(
            "org.freedesktop.DBus", "org.freedesktop.DBus", "NameOwnerChanged",
            "/org/freedesktop/DBus", "sm.puri.OSK0", Gio.DBusSignalFlags.NONE,
            lambda *_a: self._read_osk())
        self._read_osk()

    def _on_osk_changed(self, changed):
        if "Visible" in changed.keys():
            self._set_osk(bool(changed["Visible"]))

    def _read_osk(self):
        try:
            value = self.session_bus.call_sync(
                "sm.puri.OSK0", "/sm/puri/OSK0",
                "org.freedesktop.DBus.Properties", "Get",
                GLib.Variant("(ss)", ("sm.puri.OSK0", "Visible")),
                None, Gio.DBusCallFlags.NONE, 500, None)
            visible = bool(value[0])
        except GLib.Error:
            visible = False
        self._set_osk(visible)
        return False

    def _set_osk(self, visible):
        panel = self.OSK_PANEL if visible else None
        if panel == getattr(self, "osk_panel", None):
            return
        debug("keyboard %s" % ("up on the %s panel" % panel if panel else "down"))
        self.osk_panel = panel
        self._apply_mode()

    # ---- the notification shade --------------------------------------------

    SHADE_NAME = "org.sfduo.Shade"
    SHADE_PATH = "/org/sfduo/Shade"

    def _follow_windows(self):
        """Look at the windows as soon as the shell says one came or went,
        rather than at the next half-second beat (#75). The port's phosh says
        so on org.sfduo.Shade: WindowsChanged("opened", "changed" or
        "closed"). On a stock phosh nothing comes, and the beat is all."""
        self.session_bus.signal_subscribe(
            None, self.SHADE_NAME, "WindowsChanged", self.SHADE_PATH, None,
            Gio.DBusSignalFlags.NONE,
            lambda _c, _s, _p, _i, _sig, params: GLib.timeout_add(
                WINDOW_GONE_MS.get(params[0], 0), lambda: self.watch_wake.set() or False))
        # The beat started two wlrctl processes a second, and more with every
        # window open, whether anyone could see the result or not: 2-3 % of a
        # core all night with the phone closed (#168). While the display is
        # off it stops; lit again, the windows are looked at at once. phosh
        # says which: PowerSaveMode on org.gnome.Mutter.DisplayConfig, 0 on.
        self.dark = False
        self.session_bus.signal_subscribe(
            "org.gnome.Mutter.DisplayConfig", "org.freedesktop.DBus.Properties",
            "PropertiesChanged", "/org/gnome/Mutter/DisplayConfig", None,
            Gio.DBusSignalFlags.NONE,
            lambda _c, _s, _p, _i, _sig, params: self._display_changed(
                params.unpack()[1].get("PowerSaveMode")))

    def _display_changed(self, mode):
        if mode is None:
            return
        self.dark = mode != 0
        if not self.dark:
            self.watch_wake.set()

    def _follow_shade(self):
        """Know which half has its shade pulled down.

        The dock is on the overlay layer and the shade on the one below, so
        the dock's strip along the bottom edge is in front of an open shade
        and its swipe still works. Closing the shade is a swipe up from the
        bottom, and that was raising the grid instead.

        The port's phosh says which half is open on the session bus
        (phosh-patches/0004): org.sfduo.Shade, one property, "none", "left",
        "right" or "both". On a stock shell nobody owns the name, the read
        fails, and the dock behaves as it always did.
        """
        self.shade = "none"
        self.session_bus.signal_subscribe(
            None, "org.freedesktop.DBus.Properties", "PropertiesChanged",
            self.SHADE_PATH, self.SHADE_NAME, Gio.DBusSignalFlags.NONE,
            lambda _c, _s, _p, _i, _sig, params: self._on_shade_changed(params[1]))
        # and when the shell comes or goes
        self.session_bus.signal_subscribe(
            "org.freedesktop.DBus", "org.freedesktop.DBus", "NameOwnerChanged",
            "/org/freedesktop/DBus", self.SHADE_NAME, Gio.DBusSignalFlags.NONE,
            lambda *_a: self._read_shade())
        self._read_shade()

    def _on_shade_changed(self, changed):
        if "Open" in changed.keys():
            self._set_shade(str(changed["Open"]))

    def _read_shade(self):
        try:
            value = self.session_bus.call_sync(
                self.SHADE_NAME, self.SHADE_PATH,
                "org.freedesktop.DBus.Properties", "Get",
                GLib.Variant("(ss)", (self.SHADE_NAME, "Open")),
                None, Gio.DBusCallFlags.NONE, 500, None)
            self._set_shade(str(value[0]))
        except GLib.Error:
            self._set_shade("none")
        return False

    def _set_shade(self, open_):
        if open_ == getattr(self, "shade", None):
            return
        debug("shade open on: %s" % open_)
        self.shade = open_
        self._shape()
        self._apply_mode()          # under an open shade the dock dips away

    def _shade_over(self, panel):
        """Is a shade down over this panel?"""
        return getattr(self, "shade", "none") in (panel, "both")

    def _seat_session(self):
        """The path of the session that owns the screen."""
        try:
            sessions = self.system_bus.call_sync(
                "org.freedesktop.login1", "/org/freedesktop/login1",
                "org.freedesktop.login1.Manager", "ListSessions", None, None,
                Gio.DBusCallFlags.NONE, 2000, None)
        except GLib.Error:
            return None
        for _sid, _uid, _user, seat, path in sessions[0]:
            if seat and self._session_property(path, "Type") == "wayland":
                return path
        return None

    def _session_property(self, path, name):
        if path is None:
            return None
        try:
            value = self.system_bus.call_sync(
                "org.freedesktop.login1", path,
                "org.freedesktop.DBus.Properties", "Get",
                GLib.Variant("(ss)", ("org.freedesktop.login1.Session", name)),
                None, Gio.DBusCallFlags.NONE, 2000, None)
        except GLib.Error:
            return None
        return value[0]

    def _set_locked(self, locked):
        """Step down a layer while the phone is locked - and stay there.

        The window used to be hidden outright, and a hidden layer surface is
        a destroyed one: shown again at the unlock it took a few frames to
        come back, and whatever it meant to cover - a window still across
        both panels - had been seen by then. Waiting for the unlock at all is
        too late: the signal arrives after the lock screen has gone.

        So while locked the dock moves from the overlay layer to the top one.
        The lock screen is on the overlay layer and covers everything beneath
        it, the dock included, which is all "hidden" ever had to mean - and a
        curtain raised down there, over a window nobody has placed yet, is
        already in place when the lock screen comes off it.
        """
        if locked == self.locked:
            return
        self.locked = locked
        if locked:
            if self.progress > 0.0:
                self._stop_animation()
                self._set_progress(0.0)
            if getattr(self, "system_progress", 0.0) > 0.0:
                self._system_call("SetProgress", GLib.Variant("(d)", (0.0,)))
            for w in self._windows():
                GtkLayerShell.set_layer(w, GtkLayerShell.Layer.TOP)
            self._cover_strangers()
            self._dip()
        else:
            for w in self._windows():
                GtkLayerShell.set_layer(w, GtkLayerShell.Layer.OVERLAY)
            # The lock screen fades away over 300 ms on the same layer and
            # in front: a rise started now played out behind it, and the
            # dock seemed simply to be there. It starts as the fade ends.
            GLib.timeout_add(RISE_DELAY_MS, lambda: (self.locked or self._rise()) and False)
            if self.curtain_up:
                # held until now; from here it is an ordinary curtain, lifted
                # by the adoption on the next beat or by the clock
                self.curtain_timer = GLib.timeout_add_seconds(
                    WAIT_TIMEOUT + 2, self._lift_curtain)
        self._shape()

    def _offstage(self, side, pane):
        """Where a half waits beyond its own side of the display."""
        return -pane.width if side == "left" else SCREEN_WIDTH

    def _dip(self):
        """Out past the sides, at once: the lock screen is over it, and this
        is where the unlock brings the halves in from (see _rise)."""
        if self.move is not None:
            GLib.source_remove(self.move)
            self.move = None
        for side, pane in self.panes.items():
            pane.move(x=self._offstage(side, pane), settle=True)

    def _rise(self):
        """After an unlock the halves come in from the sides, each from its
        own edge, rather than being there already: the desktop is given back,
        not swapped in. (They came up from the bottom first; from the sides
        reads as the two halves of the device closing in on the hinge.) The
        unlock is heard after the lock screen has gone, so this plays on the
        desktop it belongs to."""
        if self.mode == "hidden":
            return                      # both panels taken: it stays below
        targets = self._pane_targets(self.mode)
        start = {s: (self._offstage(s, p), targets[s][1]) for s, p in self.panes.items()}
        if self.move is not None:
            GLib.source_remove(self.move)
        frames = []

        def step(t):
            frames.append(t)
            k = min(1.0, t / RISE_MS)
            eased = 1.0 - (1.0 - k) ** 3            # ease-out cubic, as every move here
            for side, pane in self.panes.items():
                (x0, y0), (x1, y1) = start[side], targets[side]
                pane.move(x=x0 + (x1 - x0) * eased, y=y1, settle=k >= 1.0)
            if k >= 1.0:
                self.move = None
                self._shape()
                self._report("dock coming in after the unlock", frames)
                return False
            return True

        self.move = animate(step)

    def _windows(self):
        """Every layer surface of the dock's: this one, the halves, the
        curtains and the grids."""
        return ([self] + list(self.panes.values()) + list(self.curtains.values())
                + list(self.grids.values()))

    def _cover_strangers(self):
        """Locked, with a window on the screen that nobody has placed: keep
        the curtain over it, under the lock screen, until the unlock."""
        ids = getattr(self, "last_ids", [])
        if self.locked and not self.curtain_up and self.shell_places is not False and \
                any(a not in self.placed and a not in self.adopted for a in ids):
            self._raise_curtain(hold=True)
        return False

    def _shell_is_up(self):
        """True once phosh owns org.gnome.ScreenSaver - see above."""
        try:
            value = self.session_bus.call_sync(
                "org.freedesktop.DBus", "/org/freedesktop/DBus",
                "org.freedesktop.DBus", "NameHasOwner",
                GLib.Variant("(s)", ("org.gnome.ScreenSaver",)), None,
                Gio.DBusCallFlags.NONE, 500, None)
        except GLib.Error:
            return False
        return bool(value[0])

    def _screen_saver_active(self):
        """What phosh itself says. False when it cannot be asked - the shell
        restarting is not the phone being locked."""
        try:
            value = self.session_bus.call_sync(
                "org.gnome.ScreenSaver", "/org/gnome/ScreenSaver",
                "org.gnome.ScreenSaver", "GetActive", None, None,
                Gio.DBusCallFlags.NONE, 500, None)
        except GLib.Error:
            return False
        return bool(value[0])

    def _read_locked(self):
        """Hide while the seat's session says it is locked.

        Nothing in here may raise: an exception out of a GLib callback is
        printed once and the timeout is dropped for good, after which the
        dock keeps whatever state it had - which is how it came to sit over
        the lock screen for an hour with no error visible on the screen.
        """
        try:
            if self.session_path is None:
                self.session_path = self._seat_session()
            locked = None
            if self.session_path is not None:
                locked = self._session_property(self.session_path, "LockedHint")
            if locked is None:
                # The session is gone - the shell was restarted and logind
                # opened a new one - or is not there yet. Look again.
                self.session_path = self._seat_session()
                if self.session_path is not None:
                    locked = self._session_property(self.session_path,
                                                    "LockedHint")
            if not self._shell_is_up():
                locked = True
            elif self._screen_saver_active():
                locked = True
            if locked is not None:
                self._set_locked(bool(locked))
        except Exception as err:          # noqa: BLE001 - see docstring
            print(f"sfduo-dock: lock state: {err}", file=sys.stderr)
        return True

    def _pane(self, side, items):
        """Half of the dock: its buttons in a slab that is square on the
        side facing the other half and rounded on the outer one, so that
        across the bezel - or side by side on one panel - the two read as
        one bar rather than as two slabs that happen to be near each other.
        """
        outer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        outer.set_valign(Gtk.Align.CENTER)
        outer.get_style_context().add_class("dock-pane")
        outer.get_style_context().add_class(side)
        size = (BUTTON_SIZE, ICON_SIZE)

        outer.buttons = {}
        for info in items:
            button = self._app_button(info, side, size)
            outer.buttons[wayland_app_id(info)] = button
            outer.pack_start(button, False, False, 0)
        # Whatever is running and is not a favourite goes here, after them,
        # so that a hidden window can always be found again.
        outer.running = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        outer.pack_start(outer.running, False, False, 0)
        outer.side = side
        outer.size = size
        return outer

    def _unswipe(self):
        self.swiped = False
        return False

    def _on_pane_clicked(self, button, info, pane_side):
        """A tap on a half opens onto the panel that half is on now: its
        own when the dock is across both, the free one otherwise."""
        if getattr(self, "swiped", False):
            debug("click after a swipe, ignored: %s" % info.get_id())
            return
        side = self.mode if self.mode in ("left", "right") else pane_side
        self._on_clicked(button, info, side)

    def _app_button(self, info, side, size):
        """A dock button for an app, with a dot under it while it runs and
        a long press to close it."""
        button = self._icon_button(info.get_icon(), info.get_display_name(),
                                   self._on_pane_clicked, info, side, size=size)
        dot = Gtk.Label(label="●")
        dot.get_style_context().add_class("running-dot")
        dot.set_valign(Gtk.Align.END)
        dot.set_halign(Gtk.Align.CENTER)
        dot.set_no_show_all(True)
        image = button.get_child()
        button.remove(image)
        overlay = Gtk.Overlay()
        overlay.add(image)
        overlay.add_overlay(dot)
        overlay.set_overlay_pass_through(dot, True)
        button.add(overlay)
        overlay.show()
        button.dot = dot
        button.app_id = wayland_app_id(info)
        press = Gtk.GestureLongPress.new(button)
        press.set_touch_only(True)
        press.connect("pressed", lambda g, *_a: self._close_app(button.app_id))
        button.long_press = press                  # keep it alive
        return button

    def _build_grid(self):
        """Every application, on the panel that was swiped.

        Alphabetical, all of it on one panel, four to a row at the dock's
        icon size; the other panel keeps what it was showing and stays
        touchable. Both panels have a pane, because the geometry is easier
        kept that way; only the swiped one is shown. Tapping launches onto
        the panel the grid is on, as on the dock.
        """
        apps = sorted((a for a in Gio.AppInfo.get_all() if a.should_show()),
                      key=lambda a: a.get_display_name().casefold())

        self.grid_left = self._grid_pane("left", apps)
        self.grid_right = self._grid_pane("right", apps)
        self.grid_side = "right"
        return None

    def _show_grid_on(self, side):
        """The grid rises on `side`; the other panel's is parked below."""
        if side != self.grid_side and self.progress > 0.0:
            self.grids[self.grid_side].place(0.0)
        self.grid_side = side

    def _grid_pane(self, side, apps):
        flow = Gtk.FlowBox()
        flow.set_selection_mode(Gtk.SelectionMode.NONE)
        flow.set_homogeneous(True)
        flow.set_min_children_per_line(GRID_COLUMNS)
        flow.set_max_children_per_line(GRID_COLUMNS)
        flow.set_column_spacing(6)
        flow.set_row_spacing(6)
        flow.set_valign(Gtk.Align.START)
        flow.get_style_context().add_class("grid-pane")

        for info in apps:
            button = Gtk.Button()
            button.get_style_context().add_class("grid-app")
            button.set_relief(Gtk.ReliefStyle.NONE)
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            image = Gtk.Image()
            image.set_pixel_size(GRID_ICON)
            image.set_from_gicon(info.get_icon() or Gio.ThemedIcon.new("application-x-executable"),
                                 Gtk.IconSize.INVALID)
            label = Gtk.Label(label=info.get_display_name())
            label.set_ellipsize(3)                  # END
            label.set_max_width_chars(14)
            label.set_justify(Gtk.Justification.CENTER)
            box.pack_start(image, False, False, 0)
            box.pack_start(label, False, False, 0)
            button.add(box)
            dot = Gtk.Label(label="●")
            dot.get_style_context().add_class("running-dot")
            dot.set_no_show_all(True)
            box.pack_start(dot, False, False, 0)
            button.dot = dot
            button.connect("clicked", self._on_grid_app, info, side)
            self.grid_apps = getattr(self, "grid_apps", {})
            self.grid_apps.setdefault(wayland_app_id(info), []).append(button)
            flow.add(button)

        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        # A scrolled window captures every touch press to decide whether it
        # is a scroll: a finger that moves slowly is handed to the button
        # under it after a hold, the dock's own drag never hears of it, and
        # the release is a click - a slow swipe down to close the grid
        # launched whatever it started on (#47). The dock's gesture is the
        # only one that reads the finger here; the wheel still scrolls.
        scroller.set_capture_button_press(False)
        scroller.set_kinetic_scrolling(False)
        scroller.get_style_context().add_class("grid-pane")   # black to the bottom, not just behind the icons
        scroller.add(flow)
        return scroller

    def _on_grid_app(self, button, info, side):
        if getattr(self, "swiped", False):
            debug("click after a swipe, ignored: %s" % info.get_id())
            return
        debug("grid app clicked: %s" % info.get_id())
        self._animate_to(0.0)
        self._on_clicked(button, info, side)

    @staticmethod
    def _icon_button(icon, tooltip, callback, *args, size=(BUTTON_SIZE, ICON_SIZE)):
        """One dock button: same box, same glyph size, whatever the icon is.

        Both halves matter. Themed icons come in whatever sizes the theme
        happens to carry - 16, 48, 256, scalable - so asking for a named size
        gets one app a 64px bitmap and the next a 32px one; and a button sized
        to its child makes the row ragged even once the glyphs match.
        """
        button = Gtk.Button()
        button.get_style_context().add_class("dock-button")
        button.set_relief(Gtk.ReliefStyle.NONE)
        button.set_tooltip_text(tooltip)
        button.set_size_request(size[0], size[0])

        image = Gtk.Image()
        image.set_pixel_size(size[1])
        image.set_from_gicon(icon, Gtk.IconSize.INVALID)
        image.set_halign(Gtk.Align.CENTER)
        image.set_valign(Gtk.Align.CENTER)
        button.add(image)

        button.connect("clicked", callback, *args)
        return button

    def _on_size_allocate(self, _widget, allocation):
        """The display's width, from the one window that spans it: where the
        hinge is, how wide a panel is. The grids and the curtains are given
        a panel's width outright; the halves are put in their places."""
        width = allocation.width
        span = max(width, allocation.height)
        gap = max(1, round(span * HINGE_FRACTION))
        half = max(1, (width - gap) // 2)
        if (half, gap) == (self.half, self.gap):
            return
        self.half, self.gap = half, gap
        self._place_clock()
        for grid in self.grids.values():
            grid.set_size_request(half, STAGE_HEIGHT)
        for catcher in self.catchers.values():
            catcher.set_size_request(half, -1)
        # the whole panel, top to bottom: STAGE_HEIGHT stops at phosh's top
        # bar, which is gone (#96), and the strip above it showed whatever
        # window lay under the curtain through the launch (#181)
        for curtain in self.curtains.values():
            curtain.set_size_request(half, SCREEN_HEIGHT)
            curtain.park()
        if self.move is None:
            self._place_panes()

    def _on_pane_size_allocate(self, pane, allocation):
        """A half that changed width - a running app got a button, or lost
        it - stands where its new width says.

        On its way it cannot: the crossing is driving both halves, frame by
        frame, from the widths they had when it began. But the new width has
        to be answered once it arrives, or the two stand as far apart as the
        old width said and the bar has a black slit down it where they
        should meet - six pixels of it, measured, when a running app's
        button went while the dock was crossing.
        """
        if allocation.width != getattr(pane, "placed_width", None):
            pane.placed_width = allocation.width
            debug("%s half: window %d, slab natural %d, slab allocated %d"
                  % (pane.side, allocation.width, pane.slab.get_preferred_width()[1],
                     pane.slab.get_allocated_width()))
            if self.half <= 1:
                return
            if self.move is None:
                self._place_panes()
            else:
                self.replace_when_still = True


    def _launch_from_file(self):
        path = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "sfduo-launch")
        try:
            with open(path) as fp:
                desktop_id, side = fp.read().split()[:2]
            info = desktop_info(desktop_id)
        except (OSError, ValueError, TypeError) as err:
            print(f"sfduo-dock: {path}: {err}", file=sys.stderr)
            return
        if info is not None and side in ("left", "right"):
            self._on_clicked(None, info, side)

    def _on_clicked(self, _button, info, side):
        app_id = wayland_app_id(info)
        if app_id in getattr(self, "running", {}):
            # It has a window: bring that back rather than start another.
            # Tapped on the other panel's dock, it comes to that panel - the
            # dock was there because the panel was free, and the hand is
            # there - with the windows that follow it (a page Settings has
            # open over itself); the dock then takes the panel it left.
            where = self.placed.get(app_id)
            if where in ("left", "right") and where != side:
                group = [app_id] + [a for a, leader in getattr(self, "follow", {}).items()
                                    if leader == app_id and self.placed.get(a) == where
                                    and a in self.running]
                debug(f"{app_id} called to the {side} panel from the {where}")
                threading.Thread(target=self._move_group, args=(group, side),
                                 daemon=True).start()
                return
            self._present(app_id)
            return
        # The curtain first: it is the tap's answer. Asking which windows
        # there are (a wlrctl run) and starting the app came before it, 70-90
        # ms of the main loop the curtain's first frame waited for (#180);
        # they go to the thread that places the window.
        if self.shell_places is not False:
            self._raise_curtain(info, side)
        self.placing += 1
        self.launching = getattr(self, "launching", {})
        self.launching[app_id] = side
        self._apply_mode()
        threading.Thread(target=self._launch_and_place,
                         args=(info, app_id, side), daemon=True).start()

    def _launch_and_place(self, info, app_id, side):
        self._expect(app_id, side)
        before = toplevel_ids()
        try:
            # An app that is already running is raised rather than started
            # again; either way the window we want ends up focused.
            info.launch([], None)
        except GLib.Error as err:
            print(f"sfduo-dock: {info.get_id()}: {err.message}", file=sys.stderr)
            self.placing -= 1
            self.launching.pop(app_id, None)
            GLib.idle_add(self._lift_curtain)
            return
        self._place_and_reveal(info, app_id, side, before)

    # ---- the launch curtain ------------------------------------------------
    #
    # A new window maps at its own size, across both panels, and is tiled only
    # once it has the focus: for most of a second it is in the wrong place.
    # phoc has no way to say where a window should open, so the dock - which
    # is above everything - covers the stage for that second and lifts when
    # the window is where it belongs.

    def _raise_curtain(self, info=None, side=None, hold=False, quiet=False):
        """Cover the panel an app is being launched onto (both, for a window
        nobody launched and nobody has placed yet). Quiet: the colour of a
        window, no icon - for a window following another onto its panel."""
        sides = ("left", "right") if side is None else (side,)
        for where in sides:
            self.curtains[where].raise_(info.get_icon() if info is not None else None, quiet)
        self.curtain_up = True
        # Whatever happens to the launch, the curtain does not stay - unless
        # it is being held under the lock screen, where nobody can see it and
        # the unlock takes over.
        if self.curtain_timer is not None:
            GLib.source_remove(self.curtain_timer)
            self.curtain_timer = None
        if not hold:
            self.curtain_timer = GLib.timeout_add_seconds(WAIT_TIMEOUT + 2, self._lift_curtain)

    def _on_shown(self, app_id):
        """phoc has a new window on its panel, drawn in full."""
        self.shown[app_id] = time.monotonic()
        if self.curtain_up and self.awaiting_shown == app_id:
            debug(f"{app_id} shown: the curtain lifts")
            self._lift_curtain()

    def _await_shown(self, app_id, since):
        """Lift the curtain when phoc shows the launched window - at once if
        it already has - and at the latest after CURTAIN_SHOWN_CAP.

        The curtain used to lift CURTAIN_SETTLE after the window was placed,
        on a timer. phoc holds a new window out of sight until its client has
        stopped drawing (phoc-patches/0010), and a client still drawing was
        held past the timer: the curtain went and the panel showed whatever
        lay under the window - another app, or the desktop - for up to half
        a second (#182); a window let go after the timer grew or moved in
        sight, and one ready long before it waited under the curtain for
        nothing (#183)."""
        if self.shown.get(app_id, 0) >= since:
            self._lift_curtain()
            return False
        self.awaiting_shown = app_id
        if self.curtain_timer is not None:
            GLib.source_remove(self.curtain_timer)
        self.curtain_timer = GLib.timeout_add(CURTAIN_SHOWN_CAP, self._lift_curtain)
        return False

    def _lift_curtain(self):
        self.awaiting_shown = None
        if self.curtain_timer is not None:
            GLib.source_remove(self.curtain_timer)
            self.curtain_timer = None
        if not self.curtain_up:
            return False
        self.curtain_up = False
        for curtain in self.curtains.values():
            curtain.lower()
        return False

    def _place_and_reveal(self, info, app_id, side, before):
        since = time.monotonic()
        self.placed_as = app_id
        try:
            placed = self._place(info, app_id, side, before)
        except Exception as err:          # noqa: BLE001 - the curtain must lift
            print(f"sfduo-dock: placing {info.get_id()}: {err}", file=sys.stderr)
            placed = False
        waits = placed and self.compositor_holds
        if waits:
            # set before the launch is over, or the window beat takes the
            # curtain for one held for nothing and lifts it (_adopt_strangers)
            self.awaiting_shown = self.placed_as
        self.placing -= 1
        self.launching.pop(app_id, None)
        if waits:
            # the window as it is really called, which _place learned
            GLib.idle_add(self._await_shown, self.placed_as, since)
        else:
            # A tiled window needs a moment to lay itself out at its new size.
            GLib.timeout_add(CURTAIN_SETTLE if placed else 0, self._lift_curtain)

    def _place(self, info, app_id, side, before):
        """Wait for the window, then hand it to the panel it was asked for.

        The window is whichever one appears that was not there before the
        launch - that is how its real name is learned - and failing that,
        the one the desktop file suggested.
        """
        deadline = time.monotonic() + WAIT_TIMEOUT
        found = None
        while time.monotonic() < deadline:
            new = toplevel_ids() - before
            if new:
                found = sorted(new)[0]
                break
            if app_id in before and subprocess.run(
                    ["wlrctl", "toplevel", "find", f"app_id:{app_id}", "state:active"],
                    check=False).returncode == 0:
                found = app_id            # already running, now raised
                break
            time.sleep(0.1)
        if found is None:
            print(f"sfduo-dock: no window for {info.get_id()}", file=sys.stderr)
            return False
        if found != app_id:
            learn_app_id(info, found)
        app_id = found
        self.placed_as = found
        # The port's phoc places it outright, a frame after the window
        # appears - and it holds the window out of sight until then, so the
        # placing is never seen. Waiting for the window to take the focus
        # first, as the chord needs, took half a second of that hold.
        if self._tile(app_id, side):
            return True
        if not self._take_focus(app_id):
            # No chord reaches the window from here; it stays across both
            # panels, and the dock hides as for any such window.
            return False
        # The chord is a toggle: sending it to a window already on that side
        # would push it back to full width. Remember where each app was put.
        if self.placed.get(app_id) == side:
            return True
        key = "Left" if side == "left" else "Right"
        if subprocess.run(["wtype", "-M", "logo", "-k", key, "-m", "logo"],
                          check=False).returncode == 0:
            self.placed[app_id] = side
            self._save_placed()
            return True
        return False

    @staticmethod
    def _wait_for_window(app_id):
        """True once the app has a toplevel and the compositor has focused it.

        `wlrctl toplevel find` is a question, not a wait - asking it on a
        tenth-of-a-second beat is what the wait actions in wlrctl are not.
        Focus matters because the chord goes to whatever is focused, so the
        window has to have arrived before it is sent. The window is mapped by
        now, so the wait is short: the focus comes within the second or not
        at all (see _take_focus), and every second here is a black one.
        """
        deadline = time.monotonic() + FOCUS_TIMEOUT
        while time.monotonic() < deadline:
            found = subprocess.run(
                ["wlrctl", "toplevel", "find",
                 f"app_id:{app_id}", "state:active"], check=False)
            if found.returncode == 0:
                time.sleep(0.3)   # let it settle before resizing it
                return True
            time.sleep(0.1)
        return False


def only_one():
    """Refuse to be the second dock.

    The session autostarts one, and the shell restarting autostarts another
    while the first is still up - two docks, and the older one holds a stale
    idea of the session and sits over the lock screen. An abstract socket is
    the cheapest lock that dies with the process, however it dies.
    """
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        sock.bind("\0sfduo-dock")
    except OSError:
        return None
    return sock


def main():
    # `sfduo-shell --stock`: the packaged phosh gives no window the focus, so
    # nothing launched from here could be placed - its own home is the way in
    if os.path.exists("/etc/sfduo/phosh-stock"):
        print("sfduo-dock: the packaged phosh is kept (/etc/sfduo/phosh-stock) - "
              "no dock; `sudo sfduo-shell --duo` brings the two-panel shell back",
              file=sys.stderr)
        return

    lock = only_one()
    if lock is None:
        print("sfduo-dock: already running", file=sys.stderr)
        return

    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), provider,
        Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    Dock().connect("destroy", Gtk.main_quit)
    Gtk.main()


if __name__ == "__main__":
    main()
