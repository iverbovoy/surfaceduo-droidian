def output_size():
    """The output's logical size, asked of the compositor: 928x600 at phoc's
    scale 3, 1113x720 at 2.5. Every other number here is logical too, and
    the shell's furniture (the 32 px top bar, this dock's 84 px strip) keeps
    its logical size across scales, so only the span has to be asked for.
    Landscape is assumed, like everywhere else in this file."""
    display = Gdk.Display.get_default()
    monitor = None
    if display is not None:
        monitor = display.get_primary_monitor() or display.get_monitor(0)
    if monitor is None:
        return 928, 600
    geometry = monitor.get_geometry()
    return geometry.width, geometry.height


