class PaneWindow(Gtk.Window):
    """Half of the dock: a layer surface the size of its buttons, put where
    it belongs by its left margin, moved and never redrawn.

    The dock used to be one window across both panels with three strips in
    it - across both panels, on the left alone, on the right alone - and the
    crossing was a dip below the edge, a swap while nothing showed and a rise
    on the other panel: the only way to get a row of buttons from one panel
    to the other in GTK3 without repainting it on every frame. Two windows
    that never change what they hold can simply travel: from both panels to
    one the halves slide towards each other until they meet, from one panel
    to the other they slide together across the hinge, in a straight line,
    and the compositor moves the same pixels somewhere else, nothing is
    rendered or uploaded. Only "hidden" - both panels taken - is still a dip
    below the edge, which is where a thing that has no room goes.

    Anchored to the bottom and the left edge with no width of its own, so it
    is as wide as its buttons and its left margin is its position on the
    screen. A negative bottom margin is the dip.
    """

    def __init__(self, dock, side, slab):
        super().__init__()
        self.dock = dock
        self.side = side
        self.slab = slab
        self.x = 0                  # left margin: where on the screen it is
        self.y = 0                  # bottom margin: 0 up, -DOCK_HEIGHT dipped
        self.get_style_context().add_class("sfduo-pane")
        screen = Gdk.Screen.get_default()
        visual = screen.get_rgba_visual()
        if visual is not None:
            self.set_visual(visual)
        self.set_app_paintable(True)
        self.set_size_request(-1, DOCK_HEIGHT)
        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_namespace(self, "sfduo-dock")
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.BOTTOM, True)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.LEFT, True)
        GtkLayerShell.set_exclusive_zone(self, -1)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.NONE)
        slab.set_valign(Gtk.Align.END)
        self.add(slab)
        # A finger going up from a button is a swipe for the grid, on the
        # panel this half is on right now (see Dock._panel_of_pane).
        self.drag = Gtk.GestureDrag.new(self)
        self.drag.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        self.drag.set_touch_only(True)
        self.drag.connect("drag-begin", lambda g, x, y: dock._begin_drag(dock._panel_of_pane(self)))
        self.drag.connect("drag-update", dock._on_drag_update)
        self.drag.connect("drag-end", dock._on_drag_end)
        self.drag.connect("cancel", dock._on_drag_cancel)

    def passthrough(self, on):
        """Take no touches at all, or take them across the whole half.

        A shade pulled down over this panel owns it, and the dock is a layer
        above the shade: without this the dock's buttons and its swipe sit in
        front of an open shade, and the swipe that should close the shade
        raised the grid instead. An empty input region lets the finger
        through to the shade, which is what it was aimed at."""
        win = self.get_window()
        if win is None:
            return
        if on:
            region = cairo.Region()
        else:
            region = cairo.Region(cairo.RectangleInt(0, 0, max(1, self.width), DOCK_HEIGHT))
        win.input_shape_combine_region(region, 0, 0)
        self.queue_draw()          # the region travels with a commit - see Dock._shape

    @property
    def width(self):
        """The slab's natural width - not the window's allocation, which a
        GTK3 toplevel keeps after its content shrank (a running app's button
        gone) until told to shrink (see Dock._relayout)."""
        return self.slab.get_preferred_width()[1]

    def move(self, x=None, y=None, settle=False):
        """Put the window at x (left margin) and y (bottom margin, <= 0).

        Between the ends of a motion the margins go straight to the
        compositor; at rest (`settle`) they go through gtk-layer-shell too,
        so that what it believes is true whenever it next commits on its own.
        """
        if x is not None:
            self.x = int(round(x))
        if y is not None:
            self.y = int(round(y))
        if settle or not self.get_mapped():
            GtkLayerShell.set_margin(self, GtkLayerShell.Edge.LEFT, self.x)
            GtkLayerShell.set_margin(self, GtkLayerShell.Edge.BOTTOM, self.y)
            return
        raw_margins(self, bottom=self.y, left=self.x)


class DesktopClock(Gtk.Window):
    """The time on the desktop, with no status bar to carry it (#96, #98).

    One clock, not one per panel: two alike a hinge apart read as one thing
    said twice, as the bar did before it was split. It stands on the free
    panel - the right one, under the thumb as on the lock screen, when both
    are free - and is gone when neither is (Dock._place_clock).

    A layer surface on the bottom layer: under the windows, over the
    wallpaper. It was on the top layer while phosh's home - a top-layer
    surface as large as the display - was the desktop's black, and a clock
    under it stood unseen; the home is not shown on a display with a seam
    any more (phosh-patches/0016). Above the windows, the clock was drawn
    over one for the 100-300 ms the dock took to learn a window had come to
    its panel, and it blinked there (#154). Under them, a window simply
    covers it until it moves. It goes where the dock goes - the dock's own
    panel is by definition the free one, with a launch in flight, the
    keyboard and a pulled-down shade already taken into account. It takes no touches. It changes panels by its margin - the compositor moves the same
    pixels - and redraws once a minute, when the figures change; each time it
    also steps a few pixels from its place, so no pixel of it is lit in the
    same spot for long.
    """
    SHIFT = 12                # px: the furthest it strays from its place
    TOP = 0.2                 # its place: this far down the panel

    def __init__(self):
        super().__init__()
        self.get_style_context().add_class("sfduo-clock")
        screen = Gdk.Screen.get_default()
        visual = screen.get_rgba_visual()
        if visual is not None:
            self.set_visual(visual)
        self.set_app_paintable(True)
        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_namespace(self, "sfduo-clock")
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.BOTTOM)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.TOP, True)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.LEFT, True)
        GtkLayerShell.set_exclusive_zone(self, -1)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.NONE)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.time = Gtk.Label()
        self.time.get_style_context().add_class("sfduo-clock-time")
        self.date = Gtk.Label()
        self.date.get_style_context().add_class("sfduo-clock-date")
        box.add(self.time)
        box.add(self.date)
        self.weather = Gtk.Box(spacing=8, halign=Gtk.Align.CENTER)
        self.weather.get_style_context().add_class("sfduo-clock-weather")
        self.weather.set_no_show_all(True)
        self.sky = Gtk.Image()
        self.sky.set_pixel_size(20)
        self.forecast = Gtk.Label()
        self.weather.add(self.sky)
        self.weather.add(self.forecast)
        self.sky.show()
        self.forecast.show()
        box.add(self.weather)
        self.add(box)
        self.connect("map", lambda *_a: self.get_window().input_shape_combine_region(
            cairo.Region(), 0, 0))
        try:
            self.interface = Gio.Settings.new("org.gnome.desktop.interface")
            self.interface.connect("changed::clock-format", lambda *_a: self._show())
        except (GLib.Error, TypeError):
            self.interface = None
        self.x = self.y = 0       # where it stands, before the step aside
        self.dx = self.dy = 0     # the step aside
        self._show()
        self._tick_at_minute()
        self.info = None
        self._follow_weather()

    WEATHER_EVERY = 30 * 60   # s: how often the weather is asked for again

    def _follow_weather(self):
        """The weather in the first city chosen in GNOME Weather - where a
        city is chosen on this phone - asked for every half hour. No city, no
        library or no answer, and the line is simply not there (#101 is the
        design this is a first plain step towards)."""
        if GWeather is None:
            return
        try:
            self.weather_settings = Gio.Settings.new("org.gnome.Weather")
        except (GLib.Error, TypeError):
            return
        self.weather_settings.connect("changed::locations", lambda *_a: self._weather_city())
        self._weather_city()
        GLib.timeout_add_seconds(self.WEATHER_EVERY, self._weather_update)

    def _weather_city(self):
        cities = self.weather_settings.get_value("locations")
        if cities.n_children() == 0:
            self.info = None
            self.weather.hide()
            return
        location = GWeather.Location.get_world().deserialize(
            cities.get_child_value(0).get_variant())
        if location is None:
            return
        self.city = location.get_city_name() or location.get_name()
        self.info = GWeather.Info.new(location)
        self.info.set_application_id("org.sfduo.Dock")
        self.info.set_contact_info("https://github.com/iverbovoy/surfaceduo-droidian")
        # GWeather's own default is METAR and IWIN: an airport's report, often
        # empty (Kyiv's was), and a service for the United States only. met.no
        # is what GNOME Weather asks as well.
        self.info.set_enabled_providers(GWeather.Provider.METAR | GWeather.Provider.MET_NO)
        self.info.connect("updated", self._on_weather)
        self.info.update()

    def _weather_update(self):
        if self.info is not None:
            self.info.update()
        return True

    def _on_weather(self, info):
        if not info.is_valid():
            debug("weather: no answer")
            return              # the last one shown stays until one comes
        self.sky.set_from_icon_name(info.get_symbolic_icon_name(), Gtk.IconSize.MENU)
        self.sky.set_pixel_size(20)
        self.forecast.set_text(f"{info.get_temp_summary()}  {self.city}")
        self.weather.show()

    def _show(self):
        now = GLib.DateTime.new_now_local()
        twelve = self.interface is not None and self.interface.get_string("clock-format") == "12h"
        self.time.set_text(now.format("%l:%M").strip() if twelve else now.format("%H:%M"))
        self.date.set_text(now.format("%A, %B %e").replace("  ", " "))

    def _tick_at_minute(self):
        now = GLib.DateTime.new_now_local()
        ms = (60 - now.get_second()) * 1000 - now.get_microsecond() // 1000
        GLib.timeout_add(max(ms, 50), self._tick)

    def _tick(self):
        self._show()
        self.dx = random.randint(-self.SHIFT, self.SHIFT)
        self.dy = random.randint(-self.SHIFT, self.SHIFT)
        self._move()
        self._tick_at_minute()
        return False

    def place(self, left, width):
        """Stand on the panel starting at `left`, `width` wide; None: nowhere.
        Asked on every change the dock sees - twice a second while it polls
        the windows - so it does something only when the place changes: each
        move is a commit, and the compositor has work of its own to do."""
        if (left, width) == getattr(self, "placed_at", None):
            return
        self.placed_at = (left, width)
        if left is None:
            self.hide()
            return
        self.set_size_request(width, -1)
        self.x, self.y = left, int(SCREEN_HEIGHT * self.TOP)
        self._move()
        self.show_all()

    def slide(self, p):
        """Slide off the right edge as the system screen comes in over the
        left panel (#111): at p=1 the clock is gone, the system screen shows
        the time itself. On the left panel it stays where it is and the
        system screen covers it."""
        dx = int(round(p * (SCREEN_WIDTH - self.x))) if self.x > 0 else 0
        if dx != getattr(self, "slide_dx", 0):
            self.slide_dx = dx
            self._move()

    def _move(self):
        x, y = self.x + self.dx + getattr(self, "slide_dx", 0), max(0, self.y + self.dy)
        if not raw_margins(self, top=y, left=x):
            GtkLayerShell.set_margin(self, GtkLayerShell.Edge.TOP, y)
            GtkLayerShell.set_margin(self, GtkLayerShell.Edge.LEFT, x)


