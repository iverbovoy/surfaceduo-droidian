class BackButton(Gtk.Window):
    """Back where the thumb already is: a small arrow at the bottom outer
    corner of a panel that has a window on it (#88).

    The swipe in from the outer edge (#80) is the same thing with nothing to
    aim at, and a hand that has not been told about it finds nothing. This is
    its visible half. It stands at the *outer* corner - the left of the left
    panel, the right of the right one - so it is under the thumb of the hand
    holding that side, and it is on whichever panel has a window, so it
    follows a window across the hinge without knowing anything about windows.

    Another program's back arrow is at the top left of its own header, which
    on the right panel is the corner nearest the hinge: the far reach of the
    other hand. This one is the port's answer for every application, not only
    for the ones whose window it rewrites.
    """

    def __init__(self, dock, side):
        super().__init__()
        self.dock = dock
        self.side = side
        self.active = None
        screen = Gdk.Screen.get_default()
