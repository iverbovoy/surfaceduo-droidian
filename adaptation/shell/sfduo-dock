def favourites():
    """The apps on the dock: our own list if there is one, else the shell's."""
    try:
        with open(CONFIG) as fp:
            ids = json.load(fp)["apps"]
    except (OSError, ValueError, KeyError):
        ids = list(Gio.Settings.new("sm.puri.phosh").get_strv("favorites"))

    apps = []
    for app_id in ids:
        info = Gio.DesktopAppInfo.new(app_id)
        if info is not None:
            apps.append(info)
    return apps


def wayland_app_id(info):
    """What the toplevel will call itself. Apps that say so are believed."""
    declared = info.get_string("StartupWMClass")
    if declared:
        return declared
    return info.get_id().removesuffix(".desktop")


class Stage(Gtk.Viewport):
    """A viewport that asks for the stage's height and no more.

    A bare viewport asks for its child's height, and this one's child is
    twice the stage - a spacer and the grid - so the window grew to twice
    the display and, being anchored at the bottom, put the grid on screen.
    The height is the stage's, whatever is inside.
    """

    def do_get_preferred_height(self):
        return STAGE_HEIGHT, STAGE_HEIGHT

    def do_get_preferred_height_for_width(self, _width):
        return STAGE_HEIGHT, STAGE_HEIGHT


class Dock(Gtk.Window):
    def __init__(self):
        super().__init__()
        self.get_style_context().add_class("sfduo-dock")

        # Transparent where it is nothing, and it is nothing almost
        # everywhere: the window is as tall as the space between phosh's
        # bars, so that the grid can be laid out once and left standing just
        # below the bottom edge, ready to be dragged up. Growing the window
        # at the moment of opening is what made opening stutter - a round
        # trip to the compositor, a relayout and the first paint of forty
        # icons, all on the first frame of the gesture.
        screen = Gdk.Screen.get_default()
        visual = screen.get_rgba_visual()
        if visual is not None:
            self.set_visual(visual)
        self.set_app_paintable(True)
        self.set_size_request(-1, STAGE_HEIGHT)

        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_namespace(self, "sfduo-dock")
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        for edge in (GtkLayerShell.Edge.LEFT,
                     GtkLayerShell.Edge.RIGHT,
                     GtkLayerShell.Edge.BOTTOM):
            GtkLayerShell.set_anchor(self, edge, True)
        # Nothing is reserved. The dock lives on whichever panel has no
        # window, so a window never needs room made for it: on the Duo an
        # application fills its panel to the bottom edge, and the dock is on
        # the other one - or gone, when both are taken.
        GtkLayerShell.set_exclusive_zone(self, 0)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.NONE)

        # One dock, cut in half by the bezel rather than two docks side by
        # side: the buttons are dealt out across the two panels, each app
        # appearing once, and the halves are pushed against the seam so the
        # bar reads as a single thing with the hinge lying across it. Which
        # half an app sits in is therefore which panel it opens on.
        # No all-apps button: the swipe up across the strip is the way to
        # the grid, and without the button the dock fits a panel whole.
        items = favourites()
        cut = (len(items) + 1) // 2

        # Three strips, one per place the dock can be: across both panels
        # when nothing is open, or on the left or the right alone when the
        # other panel has a window. They are stacked in the same place and
        # cross-faded, which is the only way a row of buttons moves smoothly
        # in GTK3 - reflowing them would jump. Which strip is showing
        # decides which panel a tap opens onto.
        self.rows = {
            "both": self._row(("left", items[:cut]), ("right", items[cut:])),
            "left": self._row(("left", items, True), ("right", [])),
            "right": self._row(("left", []), ("right", items, True)),
        }
        self.row = self.rows["both"]
        self.mode = "both"

        # The grid stands on a stage below the visible edge and is moved,
        # not revealed: its position is a number, the finger sets it while
        # it is down and a frame-clock animation finishes the journey after.
        # The grid is scrolled into view, not moved: a viewport the height of
        # the stage holds a transparent spacer with the grid beneath it, and
        # the scroll position is the grid's position. Scrolling a viewport
        # shifts its window without laying anything out again, which is what
        # makes following a finger cheap. (A GtkFixed grows to hold whatever
        # is put in it; a GtkLayout hands children their natural size; an
        # overlay clamps a margin so the child fits. None will park a widget
        # below the edge.)
        self.grid = self._build_grid()
        self.grid.set_size_request(-1, STAGE_HEIGHT)
        spacer = Gtk.Box()
        spacer.set_size_request(-1, STAGE_HEIGHT)
        column = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        column.pack_start(spacer, False, False, 0)
        column.pack_start(self.grid, False, False, 0)
        self.scroll = Gtk.Adjustment(value=0, lower=0, upper=2 * STAGE_HEIGHT,
                                     step_increment=1, page_increment=STAGE_HEIGHT,
                                     page_size=STAGE_HEIGHT)
        viewport = Stage(vadjustment=self.scroll)
        viewport.set_shadow_type(Gtk.ShadowType.NONE)
        viewport.add(column)

        self.stage = Gtk.Overlay()
        self.stage.add(viewport)
        for row in self.rows.values():
            row.set_valign(Gtk.Align.END)
            self.stage.add_overlay(row)
        self.add(self.stage)

        self.progress = 0.0       # 0 closed .. 1 open
        self.animation = None     # tick id of the grid's motion
        self.move = None          # tick id of the dock's crossing
        self.placed = self._load_placed()   # app_id -> the panel it was sent to
        self.connect("size-allocate", self._on_size_allocate)
        self.connect("map", lambda *_a: self._shape())
        self.show_all()
        for name, row in self.rows.items():
            if name != "both":
                row.set_opacity(0.0)
                row.set_visible(False)
        self._follow_lockscreen()
        threading.Thread(target=self._watch_windows, daemon=True).start()

        # The finger drives the grid. In the capture phase, so that the
        # sequence can be claimed once it is a swipe and taken away from the
        # button it started on; touch only, so a stylus or a pointer keeps
        # clicking things.
        self.drag = Gtk.GestureDrag.new(self)
        self.drag.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        self.drag.set_touch_only(True)
        self.drag.connect("drag-begin", self._on_drag_begin)
        self.drag.connect("drag-update", self._on_drag_update)
        self.drag.connect("drag-end", self._on_drag_end)
        # `pkill -USR1 -f sfduo-dock` toggles the grid: a keybinding can be
        # pointed at it, and so can a test that has no finger.
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1,
                             lambda: self._toggle_grid() or True)

    @staticmethod
    def _load_placed():
        """Which panel each app was put on, remembered across a restart of
        the dock - it is the only record there is. The compositor will say
        which windows exist but not where they are."""
        try:
            with open(PLACED) as fp:
                return {k: v for k, v in json.load(fp).items() if v in ("left", "right")}
        except (OSError, ValueError):
            return {}

    def _save_placed(self):
        try:
            with open(PLACED, "w") as fp:
                json.dump(self.placed, fp)
        except OSError as err:
            print(f"sfduo-dock: {PLACED}: {err}", file=sys.stderr)

    def _row(self, left, right):
        """One strip: a pane per panel, either of which may hold nothing."""
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        row.get_style_context().add_class("dock-row")
        row.set_size_request(-1, DOCK_HEIGHT)
        row.pane_left = self._pane(*left)
        row.seam = Gtk.Box()
        row.pane_right = self._pane(*right)
        row.pack_start(row.pane_left, True, True, 0)
        row.pack_start(row.seam, False, False, 0)
        row.pack_start(row.pane_right, True, True, 0)
        return row

    # ---- where the dock is ------------------------------------------------

    def _watch_windows(self):
        """Ask, on a beat, which panels have a window on them."""
        while True:
            try:
                out = subprocess.run(["wlrctl", "toplevel", "list"],
                                     capture_output=True, text=True,
                                     check=False).stdout
                ids = [line.split(":", 1)[0].strip()
                       for line in out.splitlines() if ":" in line]
                busy = set()
                for app_id in ids:
                    minimized = subprocess.run(
                        ["wlrctl", "toplevel", "find", f"app_id:{app_id}",
                         "state:minimized"], check=False).returncode == 0
                    if minimized:
                        continue
                    # A window we placed is on the panel we put it on; one
                    # we did not is assumed to span both.
                    busy.add(self.placed.get(app_id, "both"))
                if not busy:
                    mode = "both"
                elif busy == {"left"}:
                    mode = "right"
                elif busy == {"right"}:
                    mode = "left"
                else:
                    mode = "hidden"
                GLib.idle_add(self._set_mode, mode)
            except Exception as err:      # noqa: BLE001 - keep the beat going
                print(f"sfduo-dock: windows: {err}", file=sys.stderr)
            time.sleep(WATCH_MS / 1000)

    def _set_mode(self, mode):
        """Cross-fade the dock to where it should be now."""
        if mode == self.mode:
            return False
        self.mode = mode
        if self.move is not None:
            self.remove_tick_callback(self.move)
            self.move = None

        target = self.rows.get(mode)            # None when hidden
        fading_in = [] if target is None else [target]
        fading_out = [r for r in self.rows.values() if r is not target and r.get_visible()]
        for row in fading_in:
            row.set_visible(True)
        starts = {r: r.get_opacity() for r in fading_in + fading_out}
        t0 = self.get_frame_clock().get_frame_time()

        def tick(_widget, clock):
            k = min(1.0, (clock.get_frame_time() - t0) / 1000.0 / MOVE_MS)
            eased = 1.0 - (1.0 - k) ** 3
            for r in fading_in:
                r.set_opacity(starts[r] + (1.0 - starts[r]) * eased)
            for r in fading_out:
                r.set_opacity(starts[r] * (1.0 - eased))
            if k >= 1.0:
                for r in fading_out:
                    r.set_visible(False)
                self.row = target if target is not None else self.row
                self.move = None
                self._shape()
                return GLib.SOURCE_REMOVE
            return GLib.SOURCE_CONTINUE

        self.row = target if target is not None else self.row
        self._shape()
        self.move = self.add_tick_callback(tick)
        return False

    # ---- the grid's motion ------------------------------------------------

    @property
    def grid_open(self):
        return self.progress >= 1.0

    def _set_progress(self, progress):
        """Put the grid where a progress of 0..1 says, and the strip with it."""
        self.progress = max(0.0, min(1.0, progress))
        y = round(STAGE_HEIGHT * (1.0 - self.progress))
        self.scroll.set_value(STAGE_HEIGHT - y)
        # The strip fades as the grid rises over it; the grid is the
        # launcher then, and the room is better spent on a fifth row.
        if self.mode != "hidden" and self.move is None:
            self.row.set_opacity(1.0 - self.progress)
            self.row.set_visible(self.progress < 1.0)
        for button in getattr(self, "grid_buttons", []):
            ctx = button.get_style_context()
            ctx.add_class("open") if self.grid_open else ctx.remove_class("open")
        self._shape()

    def _shape(self):
        """Where the window takes touches: the strip when closed, all of it
        otherwise. Everything else falls through to what is underneath."""
        win = self.get_window()
        if win is None:
            return
        width = self.get_allocated_width()
        gap = max(1, round(width * HINGE_FRACTION))
        half = (width - gap) // 2
        top = STAGE_HEIGHT - DOCK_HEIGHT
        if self.progress > 0.0:
            rect = cairo.RectangleInt(0, 0, width, STAGE_HEIGHT)
        elif self.mode == "both":
            rect = cairo.RectangleInt(0, top, width, DOCK_HEIGHT)
        elif self.mode == "left":
            rect = cairo.RectangleInt(0, top, half, DOCK_HEIGHT)
        elif self.mode == "right":
            rect = cairo.RectangleInt(half + gap, top, half, DOCK_HEIGHT)
        else:
            rect = cairo.RectangleInt(0, 0, 0, 0)
        win.input_shape_combine_region(cairo.Region(rect), 0, 0)

    def _animate_to(self, target):
        """Finish the journey from wherever the grid is, easing out."""
        self._stop_animation()
        start = self.progress
        if abs(target - start) < 0.001:
            self._set_progress(target)
            return
        # The remaining distance takes a proportional share of the time, so
        # a grid released near its destination does not crawl the last bit.
        duration = SLIDE_MS * abs(target - start)
        t0 = self.get_frame_clock().get_frame_time()

        def tick(_widget, clock):
            t = (clock.get_frame_time() - t0) / 1000.0
            k = min(1.0, t / duration) if duration > 0 else 1.0
            eased = 1.0 - (1.0 - k) ** 3               # ease-out cubic
            self._set_progress(start + (target - start) * eased)
            if k >= 1.0:
                self.animation = None
                return GLib.SOURCE_REMOVE
            return GLib.SOURCE_CONTINUE

        self.animation = self.add_tick_callback(tick)

    def _stop_animation(self):
        if self.animation is not None:
            self.remove_tick_callback(self.animation)
            self.animation = None

    def _toggle_grid(self, open_=None):
        if open_ is None:
            open_ = not self.grid_open
        self._animate_to(1.0 if open_ else 0.0)

    # ---- the finger -------------------------------------------------------

    def _on_drag_begin(self, _gesture, _x, y):
        self._stop_animation()
        self.drag_start = self.progress
        self.drag_claimed = False
        self.drag_last = (GLib.get_monotonic_time(), 0.0)
        self.drag_velocity = 0.0

    def _on_drag_update(self, gesture, _dx, dy):
        # Once it is a swipe, it is ours: the button it started over does
        # not also fire.
        if not self.drag_claimed:
            if abs(dy) < SWIPE_PX:
                return
            self.drag_claimed = True
            gesture.set_state(Gtk.EventSequenceState.CLAIMED)
        now = GLib.get_monotonic_time()
        then, last_dy = self.drag_last
        if now > then:
            self.drag_velocity = (dy - last_dy) / ((now - then) / 1000.0)  # px/ms
        self.drag_last = (now, dy)
        # A finger going up raises the grid by exactly as much.
        self._set_progress(self.drag_start - dy / STAGE_HEIGHT)

    def _on_drag_end(self, _gesture, _dx, _dy):
        if not self.drag_claimed:
            return
        # A flick decides by direction; a slow release, by which side of
        # halfway the grid was left on.
        if self.drag_velocity < -FLICK:
            target = 1.0
        elif self.drag_velocity > FLICK:
            target = 0.0
        else:
            target = 1.0 if self.progress >= 0.5 else 0.0
        self._animate_to(target)

    def _follow_lockscreen(self):
        """Get out of the way while the phone is locked.

        The dock is on the overlay layer, which is above the lock screen as
        well as above everything else, so it has to be told.

        logind's LockedHint on the seat's own session is the one source that
        is right in every case. phosh's org.gnome.ScreenSaver answers false
        while its lock screen is on the display - closing the device shows it
        without the screen saver ever going active - and the Lock signal only
        fires for the path `loginctl lock-sessions` takes. The hint is set for
        all of them.

        The session has to be found rather than assumed: `self` is whichever
        session the process was started from, which for anything launched over
        ssh is not the one with the screen. The seat session is the wayland
        one attached to a seat.
        """
        self.system_bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        self.session_path = None

        # Any session's property change; which session is decided on read,
        # because the one that owns the screen is not there yet when the
        # dock starts two seconds behind the shell, and is a different one
        # after every restart of the shell.
        self.system_bus.signal_subscribe(
            None, "org.freedesktop.DBus.Properties", "PropertiesChanged",
            None, None, Gio.DBusSignalFlags.NONE,
            lambda *a: self._read_locked())
        # A signal that never comes is indistinguishable from a phone that is
        # simply not locked, so ask as well.
        GLib.timeout_add_seconds(2, self._read_locked)
        self._read_locked()

    def _seat_session(self):
        """The path of the session that owns the screen."""
        try:
            sessions = self.system_bus.call_sync(
                "org.freedesktop.login1", "/org/freedesktop/login1",
                "org.freedesktop.login1.Manager", "ListSessions", None, None,
                Gio.DBusCallFlags.NONE, 2000, None)
        except GLib.Error:
            return None
        for _sid, _uid, _user, seat, path in sessions[0]:
            if seat and self._session_property(path, "Type") == "wayland":
                return path
        return None

    def _session_property(self, path, name):
        if path is None:
            return None
        try:
            value = self.system_bus.call_sync(
                "org.freedesktop.login1", path,
                "org.freedesktop.DBus.Properties", "Get",
                GLib.Variant("(ss)", ("org.freedesktop.login1.Session", name)),
                None, Gio.DBusCallFlags.NONE, 2000, None)
        except GLib.Error:
            return None
        return value[0]

    def _read_locked(self):
        """Hide while the seat's session says it is locked.

        Nothing in here may raise: an exception out of a GLib callback is
        printed once and the timeout is dropped for good, after which the
        dock keeps whatever state it had - which is how it came to sit over
        the lock screen for an hour with no error visible on the screen.
        """
        try:
            if self.session_path is None:
                self.session_path = self._seat_session()
            locked = None
            if self.session_path is not None:
                locked = self._session_property(self.session_path, "LockedHint")
            if locked is None:
                # The session is gone - the shell was restarted and logind
                # opened a new one - or is not there yet. Look again.
                self.session_path = self._seat_session()
                if self.session_path is not None:
                    locked = self._session_property(self.session_path,
                                                    "LockedHint")
            if locked is not None:
                self.set_visible(not locked)
        except Exception as err:          # noqa: BLE001 - see docstring
            print(f"sfduo-dock: lock state: {err}", file=sys.stderr)
        return True

    def _pane(self, side, items, alone=False):
        """Half of the dock, pushed up against the seam - or nothing at all,
        when the dock is on the other panel.

        The half that ends at the hinge is rounded only on its outer side, so
        that across the bezel the two halves read as one bar rather than as
        two slabs that happen to be near each other.
        """
        if not items:
            return Gtk.Box()
        outer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        outer.set_halign(Gtk.Align.END if side == "left" else Gtk.Align.START)
        outer.set_valign(Gtk.Align.CENTER)
        outer.get_style_context().add_class("dock-pane")
        outer.get_style_context().add_class(side)
        if alone:
            outer.get_style_context().add_class("alone")
            outer.set_halign(Gtk.Align.CENTER)
        size = (BUTTON_SIZE - 8, ICON_SIZE - 6) if alone else (BUTTON_SIZE, ICON_SIZE)

        for info in items:
            if info is None:
                button = self._icon_button(
                    Gio.ThemedIcon.new("view-app-grid-symbolic"), "All apps",
                    lambda _b: self._toggle_grid(), size=size)
                self.grid_buttons = getattr(self, "grid_buttons", []) + [button]
            else:
                button = self._icon_button(
                    info.get_icon(), info.get_display_name(),
                    self._on_clicked, info, side, size=size)
            outer.pack_start(button, False, False, 0)

        wrapper = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        wrapper.pack_start(outer, True, True, 0)
        return wrapper

    def _build_grid(self):
        """Every application, dealt across the two panels.

        Alphabetical, the first half on the left and the second on the right,
        so a name is found by which panel it would be on. Each half scrolls
        on its own. Tapping launches onto the panel tapped, as on the dock.
        """
        apps = sorted((a for a in Gio.AppInfo.get_all() if a.should_show()),
                      key=lambda a: a.get_display_name().casefold())
        cut = (len(apps) + 1) // 2

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        self.grid_left = self._grid_pane("left", apps[:cut])
        self.grid_seam = Gtk.Box()
        self.grid_right = self._grid_pane("right", apps[cut:])
        row.pack_start(self.grid_left, True, True, 0)
        row.pack_start(self.grid_seam, False, False, 0)
        row.pack_start(self.grid_right, True, True, 0)

        # A tap on nothing closes it. Buttons take their own presses, so the
        # event box only ever hears about the space between them.
        backdrop = Gtk.EventBox()
        backdrop.get_style_context().add_class("grid-stage")
        backdrop.add(row)
        backdrop.connect("button-release-event",
                         lambda *_a: self._toggle_grid(False) or False)
        return backdrop

    def _grid_pane(self, side, apps):
        flow = Gtk.FlowBox()
        flow.set_selection_mode(Gtk.SelectionMode.NONE)
        flow.set_homogeneous(True)
        flow.set_min_children_per_line(GRID_COLUMNS)
        flow.set_max_children_per_line(GRID_COLUMNS)
        flow.set_column_spacing(6)
        flow.set_row_spacing(6)
        flow.set_valign(Gtk.Align.START)
        flow.get_style_context().add_class("grid-pane")

        for info in apps:
            button = Gtk.Button()
            button.get_style_context().add_class("grid-app")
            button.set_relief(Gtk.ReliefStyle.NONE)
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            image = Gtk.Image()
            image.set_pixel_size(GRID_ICON)
            image.set_from_gicon(info.get_icon() or Gio.ThemedIcon.new("application-x-executable"),
                                 Gtk.IconSize.INVALID)
            label = Gtk.Label(label=info.get_display_name())
            label.set_ellipsize(3)                  # END
            label.set_max_width_chars(14)
            label.set_justify(Gtk.Justification.CENTER)
            box.pack_start(image, False, False, 0)
            box.pack_start(label, False, False, 0)
            button.add(box)
            button.connect("clicked", self._on_grid_app, info, side)
            flow.add(button)

        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroller.add(flow)
        return scroller

    def _on_grid_app(self, button, info, side):
        self._animate_to(0.0)
        self._on_clicked(button, info, side)

    @staticmethod
    def _icon_button(icon, tooltip, callback, *args, size=(BUTTON_SIZE, ICON_SIZE)):
        """One dock button: same box, same glyph size, whatever the icon is.

        Both halves matter. Themed icons come in whatever sizes the theme
        happens to carry - 16, 48, 256, scalable - so asking for a named size
        gets one app a 64px bitmap and the next a 32px one; and a button sized
        to its child makes the row ragged even once the glyphs match.
        """
        button = Gtk.Button()
        button.get_style_context().add_class("dock-button")
        button.set_relief(Gtk.ReliefStyle.NONE)
        button.set_tooltip_text(tooltip)
        button.set_size_request(size[0], size[0])

        image = Gtk.Image()
        image.set_pixel_size(size[1])
        image.set_from_gicon(icon, Gtk.IconSize.INVALID)
        image.set_halign(Gtk.Align.CENTER)
        image.set_valign(Gtk.Align.CENTER)
        button.add(image)

        button.connect("clicked", callback, *args)
        return button

    def _on_size_allocate(self, _widget, allocation):
        """Keep the gap between the two halves over the hinge, at any rotation.

        Both halves are given the width outright. Letting the box hand out the
        space instead puts the gap in the wrong place: GtkBox divides the
        *surplus* equally, not the width, so the half with one more button
        ends up that much wider and the seam slides off the hinge - 32 px off,
        in the arrangement this was first noticed with.
        """
        width = allocation.width
        span = max(width, allocation.height)
        gap = max(1, round(span * HINGE_FRACTION))
        half = max(1, (width - gap) // 2)
        if (self.grid_seam.get_size_request().width != gap
                or self.grid_left.get_size_request().width != half):
            for row in self.rows.values():
                row.seam.set_size_request(gap, 1)
                row.pane_left.set_size_request(half, -1)
                row.pane_right.set_size_request(half, -1)
            self.grid_seam.set_size_request(gap, 1)
            self.grid_left.set_size_request(half, -1)
            self.grid_right.set_size_request(half, -1)


    def _on_clicked(self, _button, info, side):
        app_id = wayland_app_id(info)
        try:
            # An app that is already running is raised rather than started
            # again; either way the window we want ends up focused.
            info.launch([], None)
        except GLib.Error as err:
            print(f"sfduo-dock: {info.get_id()}: {err.message}", file=sys.stderr)
            return
        threading.Thread(target=self._place, args=(app_id, side),
                         daemon=True).start()

    def _place(self, app_id, side):
        """Wait for the window, then hand it to the panel it was asked for."""
        if not self._wait_for_window(app_id):
            print(f"sfduo-dock: no window for {app_id}", file=sys.stderr)
            return
        # The chord is a toggle: sending it to a window already on that side
        # would push it back to full width. Remember where each app was put.
        if self.placed.get(app_id) == side:
            return
        key = "Left" if side == "left" else "Right"
        if subprocess.run(["wtype", "-M", "logo", "-k", key, "-m", "logo"],
                          check=False).returncode == 0:
            self.placed[app_id] = side
            self._save_placed()

    @staticmethod
    def _wait_for_window(app_id):
        """True once the app has a toplevel and the compositor has focused it.

        `wlrctl toplevel find` is a question, not a wait - asking it on a
        tenth-of-a-second beat is what the wait actions in wlrctl are not.
        Focus matters because the chord goes to whatever is focused, so the
        window has to have arrived before it is sent.
        """
        deadline = time.monotonic() + WAIT_TIMEOUT
        while time.monotonic() < deadline:
            found = subprocess.run(
                ["wlrctl", "toplevel", "find",
                 f"app_id:{app_id}", "state:active"], check=False)
            if found.returncode == 0:
                time.sleep(0.3)   # let it settle before resizing it
                return True
            time.sleep(0.1)
        return False


def only_one():
    """Refuse to be the second dock.

    The session autostarts one, and the shell restarting autostarts another
    while the first is still up - two docks, and the older one holds a stale
    idea of the session and sits over the lock screen. An abstract socket is
    the cheapest lock that dies with the process, however it dies.
    """
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        sock.bind("\0sfduo-dock")
    except OSError:
        return None
    return sock


def main():
    lock = only_one()
    if lock is None:
        print("sfduo-dock: already running", file=sys.stderr)
        return

    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), provider,
        Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    Dock().connect("destroy", Gtk.main_quit)
    Gtk.main()


if __name__ == "__main__":
    main()
