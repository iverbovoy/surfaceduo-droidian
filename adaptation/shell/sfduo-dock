#!/usr/bin/python3
# sfduo-dock: a dock that spans both panels, and launches onto the one you
# touched.
#
# The Duo's two panels are a single Wayland output with a hidden column down
# the middle, so a bar anchored across the bottom is really two bars with a
# dead strip between them. This one carries the same apps on each side; which
# side you tap decides where the window goes.
#
# Placement is phoc's own: it tiles the focused window to half the output on
# <Super>Left / <Super>Right (org.gnome.mutter.keybindings). So a launch is
#
#   start the app  ->  wait for its toplevel  ->  send the chord for that side
#
# The waiting is `wlrctl toplevel find` asked on a beat, because the chord has
# to arrive after the window is mapped and focused, and it is a toggle: sent
# twice it undoes itself. Nothing here talks to the compositor directly;
# everything is a protocol phoc already speaks.
#
# The halves phoc tiles are exactly half the output, which is 14 logical
# pixels into the hinge on each inner edge. Living with that is deliberate for
# now - the alternative is a patch to phoc's view_arrange_tiled to read the
# same gmobile cutout the shell CSS is built around.

import json
import os
import signal
import socket
import subprocess
import sys
import threading
import time

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
import cairo  # noqa: E402
from gi.repository import Gdk, Gio, GLib, Gtk, GtkLayerShell  # noqa: E402

# The hinge as a fraction of the panel span: 84 physical pixels of 2784. Taken
# as a fraction on purpose - the logical size changes with rotation and with
# the output scale, and this does not.
HINGE_FRACTION = 84 / 2784

ICON_SIZE = 48            # logical px, the glyph itself
BUTTON_SIZE = 64          # the box it sits in - equal for every app
DOCK_HEIGHT = 84          # the strip the dock reserves along the bottom
CONFIG = os.path.expanduser("~/.config/sfduo/dock.json")
PLACED = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "sfduo-placed.json")
PANEL_HEIGHT = 32         # phosh's top bar
HOME_BAR_HEIGHT = 15      # phosh's home bar, under the dock
SCREEN_HEIGHT = 600       # logical, landscape - like every other number here
STAGE_HEIGHT = SCREEN_HEIGHT - PANEL_HEIGHT - HOME_BAR_HEIGHT   # what is ours
GRID_ICON = 64            # the app grid's icons, phosh's own size
GRID_COLUMNS = 3          # per panel: 450px gives three of ~140
SLIDE_MS = 220            # the grid settling after the finger lets go
SWIPE_PX = 12             # how far a finger travels before it is a swipe
FLICK = 0.6               # px/ms: faster than this and the direction decides
MOVE_MS = 240             # the dock crossing to the other panel
WATCH_MS = 500            # how often to ask which windows are open
WAIT_TIMEOUT = 20         # seconds to wait for a window before giving up

