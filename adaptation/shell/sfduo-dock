def favourites():
    """The apps on the dock: our own list if there is one, else the shell's."""
    try:
        with open(CONFIG) as fp:
            ids = json.load(fp)["apps"]
    except (OSError, ValueError, KeyError):
        ids = list(Gio.Settings.new("sm.puri.phosh").get_strv("favorites"))

    apps = []
    for app_id in ids:
        info = desktop_info(app_id)
        if info is not None:
            apps.append(info)
    return apps


def load_app_ids():
    try:
        with open(APP_IDS) as fp:
            return dict(json.load(fp))
    except (OSError, ValueError):
        return {}


LEARNED = load_app_ids()


def wayland_app_id(info):
    """What the toplevel will call itself.

    A window learned once is remembered: the desktop file's name is only a
    guess at it. Settings is org.gnome.Settings.desktop and its window is
    gnome-control-center, and a dock waiting for the wrong name never tiled
    it, so it opened across both panels with no way to close it.
    """
    learned = LEARNED.get(info.get_id())
    if learned:
        return learned
    declared = info.get_string("StartupWMClass")
    if declared:
        return declared
    return info.get_id().removesuffix(".desktop")


def learn_app_id(info, app_id):
    if LEARNED.get(info.get_id()) == app_id:
        return
    LEARNED[info.get_id()] = app_id
    try:
        os.makedirs(os.path.dirname(APP_IDS), exist_ok=True)
        with open(APP_IDS, "w") as fp:
            json.dump(LEARNED, fp, indent=1, sort_keys=True)
    except OSError as err:
        print(f"sfduo-dock: {APP_IDS}: {err}", file=sys.stderr)


def toplevel_ids():
    out = subprocess.run(["wlrctl", "toplevel", "list"], capture_output=True,
                         text=True, check=False).stdout
    return {line.split(":", 1)[0].strip() for line in out.splitlines() if ":" in line}


# Straight to the protocol, for one request: gtk-layer-shell's set_margin
# queues a resize, and GTK repaints the whole window for it - a buffer the
# compositor then copies into a texture, 30 ms of it on this device - although
# nothing in the window changed. A zwlr_layer_surface_v1.set_margin followed by
# a wl_surface.commit with no buffer attached moves the surface and repaints
# nothing. Opcodes from the protocol XML: set_margin is the fourth request of
# zwlr_layer_surface_v1, commit the seventh of wl_surface.
_WL = ctypes.CDLL("libwayland-client.so.0")
_GDK = ctypes.CDLL("libgdk-3.so.0")
_WL.wl_proxy_marshal.restype = None
_WL.wl_display_flush.argtypes = [ctypes.c_void_p]
_GDK.gdk_wayland_window_get_wl_surface.restype = ctypes.c_void_p
_GDK.gdk_wayland_window_get_wl_surface.argtypes = [ctypes.c_void_p]
_GDK.gdk_wayland_display_get_wl_display.restype = ctypes.c_void_p
_GDK.gdk_wayland_display_get_wl_display.argtypes = [ctypes.c_void_p]
ctypes.pythonapi.PyCapsule_GetPointer.restype = ctypes.c_void_p
ctypes.pythonapi.PyCapsule_GetPointer.argtypes = [ctypes.py_object, ctypes.c_char_p]
ZWLR_LAYER_SURFACE_SET_MARGIN = 3
WL_SURFACE_COMMIT = 6


def gpointer(obj):
    """The C pointer behind a PyGObject wrapper."""
    return ctypes.pythonapi.PyCapsule_GetPointer(obj.__gpointer__, None)


def raw_margins(window, top=0, right=0, bottom=0, left=0):
    """Move a mapped layer-shell window by its margins without a repaint.
    Falls back to gtk-layer-shell (a repaint) when the window is not mapped.
    Returns True when it went to the protocol."""
    layer = GtkLayerShell.get_zwlr_layer_surface_v1(window) if window.get_mapped() else 0
    surface = _GDK.gdk_wayland_window_get_wl_surface(gpointer(window.get_window())) if layer else 0
    if not layer or not surface:
        for edge, margin in ((GtkLayerShell.Edge.TOP, top), (GtkLayerShell.Edge.RIGHT, right),
                             (GtkLayerShell.Edge.BOTTOM, bottom), (GtkLayerShell.Edge.LEFT, left)):
            GtkLayerShell.set_margin(window, edge, margin)
        return False
    _WL.wl_proxy_marshal(ctypes.c_void_p(layer), ctypes.c_uint32(ZWLR_LAYER_SURFACE_SET_MARGIN),
                         ctypes.c_int32(top), ctypes.c_int32(right), ctypes.c_int32(bottom), ctypes.c_int32(left))
    _WL.wl_proxy_marshal(ctypes.c_void_p(surface), ctypes.c_uint32(WL_SURFACE_COMMIT))
    _WL.wl_display_flush(_GDK.gdk_wayland_display_get_wl_display(gpointer(Gdk.Display.get_default())))
    return True


def raw_margin_bottom(window, margin):
    raw_margins(window, bottom=margin)


FRAME_MS = 16             # the animations' own clock (see animate)


def animate(step):
    """Run `step(t_ms)` every frame until it returns False.

    Not a GTK tick callback: GDK's frame clock only advances when the
    compositor sends the window a frame callback, and a layer surface that
    has slid below the screen edge is not drawn and gets none - the dock's
    return from "hidden" stalled for 300 ms on that. A timer does not care
    where the window is. Returns the source id.
    """
    t0 = GLib.get_monotonic_time()

    def tick():
        return bool(step((GLib.get_monotonic_time() - t0) / 1000.0))
    return GLib.timeout_add(FRAME_MS, tick)


class GridPanel(Gtk.Window):
    """The app grid of one panel: its own layer surface, moved, never redrawn.

    The grid used to live inside the dock's window and be scrolled into view,
    which meant repainting half the display per frame - at scale 3 that is
    3 Mpx through pixman and a 13 MB damage upload for the compositor, and it
    came to 8 frames a second. A layer surface of its own costs nothing to
    move: the slide is a change of its bottom margin, the compositor puts the
    same pixels somewhere else, and nothing is rendered or uploaded at all.
    It is what phosh does with its own sliding surfaces.

    Anchored to the bottom and to its panel's outer edge, one panel wide and
    the stage tall; parked below the screen with a negative margin when
    closed. It stays mapped there once it has been shown: unmapped, every
    opening drew it whole again and uploaded 1350x1736 in its first frame,
    and the end of each slide, set through gtk-layer-shell, redrew it whole
    too - both inside the slide, frames lost to them (#148).
    """

    def __init__(self, dock, side, pane):
        super().__init__()
        self.dock = dock
        self.side = side
        self.get_style_context().add_class("sfduo-grid")
        screen = Gdk.Screen.get_default()
        visual = screen.get_rgba_visual()
        if visual is not None:
            self.set_visual(visual)
        self.set_app_paintable(True)
        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_namespace(self, "sfduo-grid")
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.BOTTOM, True)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.LEFT if side == "left"
                                 else GtkLayerShell.Edge.RIGHT, True)
        # -1: placed within the whole output, not inside what phosh's home bar
        # leaves free - with 0 the grid stood 15 px into the top bar
        GtkLayerShell.set_exclusive_zone(self, -1)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.NONE)
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.BOTTOM, -STAGE_HEIGHT)
        # a tap on nothing closes the grid; buttons take their own presses
        backdrop = Gtk.EventBox()
        backdrop.get_style_context().add_class("grid-stage")
        backdrop.add(pane)
        backdrop.connect("button-release-event",
                         lambda *_a: dock._toggle_grid(False) or False)
        self.add(backdrop)
        # a finger going down takes the grid with it
        self.drag = Gtk.GestureDrag.new(self)
        self.drag.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        self.drag.set_touch_only(True)
        self.drag.connect("drag-begin", dock._on_grid_drag_begin)
        self.drag.connect("drag-update", dock._on_drag_update)
        self.drag.connect("drag-end", dock._on_drag_end)
        self.drag.connect("cancel", dock._on_drag_cancel)

    SETTLE_MS = 600                     # after the last step: every motion is over

    def place(self, progress):
        """Where the grid is: 0 parked below the screen, 1 all the way up.

        Every step goes straight to the compositor and repaints nothing. What
        gtk-layer-shell believes about the margin is set a few frames after a
        slide stops at an end - so that it is true whenever it next commits on
        its own - and not at the end itself: setting it redraws the window.
        """
        margin = -round(STAGE_HEIGHT * (1.0 - progress))
        settle = getattr(self, "settle", None)
        if settle is not None:
            GLib.source_remove(settle)          # still moving: not yet
            self.settle = None
        if not self.get_mapped():
            GtkLayerShell.set_margin(self, GtkLayerShell.Edge.BOTTOM, margin)
            if progress > 0.0 and not self.get_visible():
                self.show_all()                 # the first time only; parked after
            return
        raw_margin_bottom(self, margin)
        if progress <= 0.0 or progress >= 1.0:
            def settle_now():
                self.settle = None
                GtkLayerShell.set_margin(self, GtkLayerShell.Edge.BOTTOM, margin)
                return False
            self.settle = GLib.timeout_add(self.SETTLE_MS, settle_now)


class CurtainPanel(Gtk.Window):
    """The launch curtain of one panel: black, the app's icon in the middle.

    A window of its own, one panel wide and the screen tall, up for the
    moment a new window spends being placed. Only the panel the app was
    launched onto is covered; the other stays what it was and stays
    touchable.

    It stays mapped, parked below the screen, and is raised and lowered by
    its margin - moved, not drawn. Shown from unmapped, as it used to be,
    it was realized and drawn whole for every launch, 1350x1800 in
    software: 80-100 ms between the tap and its first frame (#180). The
    icon is drawn when the curtain is already up, a frame later, and
    cleared when it is down again, out of sight.
    """

    PARKED = -(SCREEN_HEIGHT + 16)          # its bottom margin when down

    def __init__(self, side):
        super().__init__()
        self.side = side
        self.get_style_context().add_class("sfduo-curtain")
        screen = Gdk.Screen.get_default()
        visual = screen.get_rgba_visual()
        if visual is not None:
            self.set_visual(visual)
        self.set_app_paintable(True)
        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_namespace(self, "sfduo-curtain")
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.BOTTOM, True)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.LEFT if side == "left"
                                 else GtkLayerShell.Edge.RIGHT, True)
        GtkLayerShell.set_exclusive_zone(self, -1)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.NONE)
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.BOTTOM, self.PARKED)
        box = Gtk.Box()
        box.get_style_context().add_class("curtain")
        self.box = box
        self.icon = Gtk.Image()
        self.icon.set_pixel_size(CURTAIN_ICON)
        self.icon.set_halign(Gtk.Align.CENTER)
        self.icon.set_valign(Gtk.Align.CENTER)
        box.pack_start(self.icon, True, True, 0)
        self.add(box)

    def raise_(self, gicon, quiet=False):
        for widget in (self, self.box):
            context = widget.get_style_context()
            if quiet:
                context.add_class("quiet")
            else:
                context.remove_class("quiet")
        if quiet:
            gicon = None
        if gicon is not None:
            self.icon.set_from_gicon(gicon, Gtk.IconSize.DIALOG)
        else:
            self.icon.clear()
        if self.get_mapped():
            raw_margin_bottom(self, 0)
        else:                               # not parked yet: the old way
            GtkLayerShell.set_margin(self, GtkLayerShell.Edge.BOTTOM, 0)
            self.show_all()

    def park(self):
        """Mapped below the screen, ready to be raised."""
        if not self.get_mapped():
            GtkLayerShell.set_margin(self, GtkLayerShell.Edge.BOTTOM, self.PARKED)
            self.show_all()

    def lower(self):
        if self.get_mapped():
            raw_margin_bottom(self, self.PARKED)
            self.icon.clear()               # drawn where nobody sees it
        else:
            self.hide()


class BackStrip(Gtk.Window):
    """The outer edge of one panel, where a swipe in means "back" (#80).

    A layer surface as narrow as a thumb's edge, the panel's height less the
    bar above and the dock's band below, transparent and taking touches only
    while a window is on that panel. The finger's travel inwards drives a
    BackArrow; letting go past BACK_ARM sends the window Alt+Left.
    """

    def __init__(self, dock, side):
        super().__init__()
        self.dock = dock
        self.side = side
        self.active = None
        screen = Gdk.Screen.get_default()
        visual = screen.get_rgba_visual()
        if visual is not None:
            self.set_visual(visual)
        self.set_app_paintable(True)
        self.set_size_request(BACK_STRIP, -1)
        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_namespace(self, "sfduo-back")
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        for edge in (GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.BOTTOM,
                     GtkLayerShell.Edge.LEFT if side == "left" else GtkLayerShell.Edge.RIGHT):
            GtkLayerShell.set_anchor(self, edge, True)
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.TOP, BACK_TOP)
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.BOTTOM, DOCK_HEIGHT)
        GtkLayerShell.set_exclusive_zone(self, -1)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.NONE)
        self.add(Gtk.Box())
        self.drag = Gtk.GestureDrag.new(self)
        self.drag.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        self.drag.set_touch_only(True)
        self.drag.connect("drag-begin", lambda g, x, y: dock._back_begin(self, y))
        self.drag.connect("drag-update", lambda g, dx, dy: dock._back_update(self, dx))
        self.drag.connect("drag-end", lambda g, dx, dy: dock._back_end(self))
        self.drag.connect("cancel", lambda g, s: dock._back_cancel(self))
        self.connect("map", lambda *_a: self._apply())
        self.show_all()

    def set_active(self, on):
        """Take touches, or let every one through to the window beneath."""
        # Dock._shape asks at every turn of the dock; a strip told what it
        # already was sent a frame all the same, both strips together, and
        # the grid's slide lost a frame each time the dock crossed (#148)
        if on == self.active:
            return
        self.active = on
        self._apply()

    def _apply(self):
        on = bool(self.active)
        win = self.get_window()
        if win is None:
            return
        if on:
            region = cairo.Region(cairo.RectangleInt(0, 0, BACK_STRIP, 10000))
        else:
            region = cairo.Region()
        win.input_shape_combine_region(region, 0, 0)
        self.queue_draw_area(0, 0, 1, 1)   # the region travels with a commit - see Dock._shape


