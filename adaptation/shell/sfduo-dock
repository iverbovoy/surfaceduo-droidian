# The hinge as a fraction of the panel span: 84 physical pixels of 2784. Taken
# as a fraction on purpose - the logical size changes with rotation and with
# the output scale, and this does not.
HINGE_FRACTION = 84 / 2784

ICON_SIZE = 48            # logical px, the glyph itself
BUTTON_SIZE = 64          # the box it sits in - equal for every app
DOCK_HEIGHT = 84          # the strip the dock reserves along the bottom
CONFIG = os.path.expanduser("~/.config/sfduo/dock.json")
PLACED = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "sfduo-placed.json")
APP_IDS = os.path.expanduser("~/.config/sfduo/app-ids.json")   # desktop id -> what its window is called
PANEL_HEIGHT = 32         # phosh's top bar
HOME_BAR_HEIGHT = 15      # phosh's home bar, under the dock


def output_size():
    """The output's logical size, asked of the compositor: 928x600 at phoc's
    scale 3, 1113x720 at 2.5. Every other number here is logical too, and
    the shell's furniture (the 32 px top bar, this dock's 84 px strip) keeps
    its logical size across scales, so only the span has to be asked for.
    Landscape is assumed, like everywhere else in this file."""
    display = Gdk.Display.get_default()
    monitor = None
    if display is not None:
        monitor = display.get_primary_monitor() or display.get_monitor(0)
    if monitor is None:
        return 928, 600
    geometry = monitor.get_geometry()
    return geometry.width, geometry.height


SCREEN_WIDTH, SCREEN_HEIGHT = output_size()
STAGE_HEIGHT = SCREEN_HEIGHT - PANEL_HEIGHT   # everything below the top bar
EDGE = 22                 # the gesture band along the bottom of a busy panel
CLOSE_PX = 220            # a swipe this long over an app closes it, not just hides it
GRID_ICON = ICON_SIZE     # the app grid's icons: the dock's size, not phosh's 64
GRID_COLUMNS = 4          # on one panel: 540px at scale 2.5 gives four of ~130
SLIDE_MS = 220            # the grid settling after the finger lets go
SWIPE_PX = 12             # how far a finger travels before it is a swipe
FLICK = 0.6               # px/ms: faster than this and the direction decides
MOVE_MS = 240             # the dock crossing to the other panel
WATCH_MS = 500            # how often to ask which windows are open
WAIT_TIMEOUT = 20         # seconds to wait for a window before giving up
FOCUS_TIMEOUT = 4         # seconds a mapped window gets to take the focus
CURTAIN_ICON = 96         # the app's icon on the launch curtain
CURTAIN_SETTLE = 250      # ms between the tiling chord and lifting the curtain

# The shell's binary and the patched one the package carries: same file, and
# windows can be placed; see Dock._shell_places.
SHELL_BIN = "/usr/libexec/phosh"
PATCHED_PHOSH = "/usr/lib/sfduo/phosh/phosh"

