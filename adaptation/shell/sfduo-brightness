#!/usr/bin/python3
# sfduo-brightness: put the brightness back after the panels are powered on.
#
# Closing the device powers the two DSI panels down, and bringing them back up
# leaves each one's backlight at the driver's default, which is full. The
# shell keeps its own idea of the level and has no reason to write it again,
# so the screen comes back at 100% every time the device is opened - measured:
# panel0 and panel1 both at 255 while gnome-settings-daemon still said 60%.
#
# So: watch the panels. When one is at full while the shell thinks it should
# be lower, write the shell's level back. A level of 100% is left alone, which
# is what makes this safe - at 100% there is nothing to restore, and every
# other value is a disagreement only the panel reset could have caused.
#
# Watched, not asked after. `actual_brightness` in sysfs wakes a poll() with
# POLLPRI the moment the driver changes it (checked on this device), so the
# level is put back within a frame or two of the panel coming up. Asking once
# a second, as this did, meant the screen was at full for up to a second every
# time the device was opened - long enough to be the first thing seen. The
# beat stays as a net underneath, slow, for whatever the notification misses.
#
# The restoring is done twice over. The panels themselves first, written
# straight away - the session user is in `video` and a udev rule gives that
# group the two backlights - because the level that matters is the one the
# panel lights at, and it is written while the panel is still dark: the
# level goes to full a moment before the light comes on, so put back at once
# there is nothing to see at all. Then the shell is handed back its own
# number, which makes gnome-settings-daemon write the hardware too and keeps
# its idea of the level and the hardware's the same. Going through the shell
# alone was a bus round trip that landed after the panel had lit.

import os
import sys

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gio, GLib  # noqa: E402

SCREEN = "org.gnome.SettingsDaemon.Power.Screen"
PANELS = ("panel0-backlight", "panel1-backlight")
SYSFS = "/sys/class/backlight/%s/%s"
POLL_MS = 2000          # the net under the watch, not the way it usually works
# The level a new user starts at. Left alone it came out of whatever
# systemd-backlight saved at the first-boot reboot - 2 of 255 on one clean
# install, the screen all but dark - and differed from install to install.
DEFAULT_PERCENT = 40
DEFAULT_DONE = os.path.expanduser("~/.local/state/sfduo/brightness-default")
# What the root side reads when the device is opened: the panels are set to
# full before they are lit, and only root can answer that early (#87). The
# panels' own numbers, not the shell's percentage - the two are not a
# straight line (37% is 48 of 255 here), and what has to be put back is
# exactly what the panels were showing.
LEVEL = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "sfduo-brightness")


def write(panel, value):
    """Straight to the panel. Nothing here is lost if it fails - the shell is
    asked for the same thing a moment later."""
    try:
        with open(SYSFS % (panel, "brightness"), "w") as fp:
            fp.write(str(value))
        return True
    except OSError:
        return False


def read(panel, attr):
    try:
        with open(SYSFS % (panel, attr)) as fp:
            return int(fp.read().strip())
    except (OSError, ValueError):
        return None


class Keeper:
    def __init__(self):
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        self.props = Gio.DBusProxy.new_sync(
            bus, Gio.DBusProxyFlags.NONE, None,
            "org.gnome.SettingsDaemon.Power",
            "/org/gnome/SettingsDaemon/Power",
            "org.freedesktop.DBus.Properties", None)

        GLib.timeout_add(POLL_MS, self.check)
        self.watch_panels()
        self.default_tries = 30
        if not os.path.exists(DEFAULT_DONE):
            GLib.timeout_add_seconds(2, self.first_default)

    def first_default(self):
        """Once per user: start at DEFAULT_PERCENT. Tried until the settings
        daemon answers, then never again - the level is the user's."""
        try:
            self.props.call_sync(
                "Set",
                GLib.Variant("(ssv)", (SCREEN, "Brightness",
                                       GLib.Variant("i", DEFAULT_PERCENT))),
                Gio.DBusCallFlags.NONE, 2000, None)
        except GLib.Error:
            self.default_tries -= 1
            return self.default_tries > 0      # the daemon is still starting
        os.makedirs(os.path.dirname(DEFAULT_DONE), exist_ok=True)
        with open(DEFAULT_DONE, "w") as fp:
            fp.write(f"{DEFAULT_PERCENT}\n")
        return False

    def watch_panels(self):
        """Wake on the driver's own word that a panel's level changed."""
        self.watched = []
        for panel in PANELS:
            try:
                fp = open(SYSFS % (panel, "actual_brightness"))
            except OSError as err:
                print(f"sfduo-brightness: {panel}: {err}", file=sys.stderr)
                continue
            fp.read()               # sysfs wants the value read before it notifies
            channel = GLib.IOChannel.unix_new(fp.fileno())
            GLib.io_add_watch(channel, GLib.PRIORITY_HIGH,
                              GLib.IOCondition.PRI | GLib.IOCondition.ERR,
                              self.on_panel_changed)
            self.watched.append((fp, channel))

    def on_panel_changed(self, channel, condition):
        try:
            os.lseek(channel.unix_get_fd(), 0, os.SEEK_SET)
            os.read(channel.unix_get_fd(), 32)
        except OSError:
            pass
        self.check()
        return True

    @staticmethod
    def remember(levels):
        """Leave the panels' own levels where the lid daemon can find them."""
        try:
            with open(LEVEL, "w") as fp:
                fp.write(" ".join(str(v) for v in levels) + "\n")
        except OSError:
            pass

    @staticmethod
    def recall():
        try:
            with open(LEVEL) as fp:
                return [int(v) for v in fp.read().split()]
        except (OSError, ValueError):
            return []

    def wanted(self):
        """The level the shell believes it is at, as a percentage."""
        try:
            value = self.props.call_sync(
                "Get",
                GLib.Variant("(ss)", (SCREEN, "Brightness")),
                Gio.DBusCallFlags.NONE, 2000, None)
        except GLib.Error:
            return None
        return value[0]

    def check(self):
        percent = self.wanted()
        if percent is None or percent < 0:
            return True

        levels = [read(p, "brightness") for p in PANELS]
        tops = [read(p, "max_brightness") for p in PANELS]
        reset = any(level == top for level, top in zip(levels, tops))
        if not reset:
            if percent < 100 and all(levels):
                self.remember(levels)     # what to put back next time
            return True
        if percent >= 100:
            return True

        # The panels first, with what they were showing before: whatever is
        # about to light them has just set them to full, and this is written
        # while they are still dark.
        for panel, level in zip(PANELS, self.recall()):
            write(panel, level)

        try:
            self.props.call_sync(
                "Set",
                GLib.Variant("(ssv)", (SCREEN, "Brightness",
                                       GLib.Variant("i", percent))),
                Gio.DBusCallFlags.NONE, 2000, None)
        except GLib.Error as err:
            print(f"sfduo-brightness: {err.message}", file=sys.stderr)
        return True


if __name__ == "__main__":
    Keeper()
    GLib.MainLoop().run()
