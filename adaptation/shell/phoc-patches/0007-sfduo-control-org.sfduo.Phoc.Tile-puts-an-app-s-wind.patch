diff --git a/src/sfduo-control.c b/src/sfduo-control.c
new file mode 100644
index 0000000..ac3861f
--- /dev/null
+++ b/src/sfduo-control.c
@@ -0,0 +1,164 @@
+/*
+ * Copyright (C) 2026 The Surface Duo port
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#define G_LOG_DOMAIN "phoc-sfduo-control"
+
+#include "phoc-config.h"
+
+#include "desktop.h"
+#include "server.h"
+#include "sfduo-control.h"
+#include "view.h"
+#include "view-ghost.h"
+
+#include <gio/gio.h>
+
+/*
+ * org.sfduo.Phoc on the session bus: what the port's dock needs the
+ * compositor to do for it, done directly.
+ *
+ * Tile(app_id, side) puts the windows of an app on one half of the output.
+ * The dock used to do it as a user would: give the window the focus, wait
+ * for it, send the tiling chord - half a second a window, and with two
+ * windows of a pair (a page over the list it came from) each was raised in
+ * turn, so the one underneath came up over the other, jumped, and the
+ * other jumped after it. Here nothing is focused or raised: the stacking
+ * stays as it was, and each window slides across instead of jumping
+ * (phoc_view_ghost_move).
+ */
+
+#define SFDUO_BUS_NAME "org.sfduo.Phoc"
+#define SFDUO_OBJECT_PATH "/org/sfduo/Phoc"
+
+static const char introspection_xml[] =
+  "<node>"
+  "  <interface name='org.sfduo.Phoc'>"
+  "    <method name='Tile'>"
+  "      <arg name='app_id' type='s' direction='in'/>"
+  "      <arg name='side' type='s' direction='in'/>"
+  "      <arg name='tiled' type='u' direction='out'/>"
+  "    </method>"
+  "  </interface>"
+  "</node>";
+
+
+static void
+tile_view (PhocView *view, PhocViewTileDirection dir)
+{
+  struct wlr_surface *surface = view->wlr_surface;
+  struct wlr_box from, to, tiled, geom;
+  float scale = 1.0;
+
+  if (phoc_view_is_tiled (view) && phoc_view_get_tile_direction (view) == dir)
+    return;
+
+  /* The surface's box, where it is and where it is going: the tile's box
+   * is the window's geometry, the surface sits geom.x/y before it. */
+  if (surface && phoc_view_get_tiled_box (view, dir, NULL, &tiled)) {
+    struct wlr_box box;
+
+    phoc_view_get_box (view, &box);
+    if (view->box.width > 0)
+      scale = (float)box.width / view->box.width;
+    phoc_view_get_geometry (view, &geom);
+    from = (struct wlr_box) {
+      .x = view->box.x, .y = view->box.y,
+      .width = surface->current.width * scale, .height = surface->current.height * scale,
+    };
+    to = from;
+    to.x = tiled.x - geom.x / scale;
+    to.y = tiled.y - geom.y / scale;
+    phoc_view_tile (view, dir, NULL);
+    phoc_view_ghost_move (view, &from, &to);
+    return;
+  }
+
+  phoc_view_tile (view, dir, NULL);
+}
+
+
+static void
+handle_method_call (GDBusConnection       *connection,
+                    const char            *sender,
+                    const char            *object_path,
+                    const char            *interface_name,
+                    const char            *method_name,
+                    GVariant              *parameters,
+                    GDBusMethodInvocation *invocation,
+                    gpointer               user_data)
+{
+  PhocDesktop *desktop = phoc_server_get_desktop (phoc_server_get_default ());
+  const char *app_id, *side;
+  PhocViewTileDirection dir;
+  guint tiled = 0;
+
+  if (g_strcmp0 (method_name, "Tile") != 0) {
+    g_dbus_method_invocation_return_error (invocation, G_DBUS_ERROR, G_DBUS_ERROR_UNKNOWN_METHOD,
+                                           "No method %s", method_name);
+    return;
+  }
+
+  g_variant_get (parameters, "(&s&s)", &app_id, &side);
+  if (g_strcmp0 (side, "left") == 0) {
+    dir = PHOC_VIEW_TILE_LEFT;
+  } else if (g_strcmp0 (side, "right") == 0) {
+    dir = PHOC_VIEW_TILE_RIGHT;
+  } else {
+    g_dbus_method_invocation_return_error (invocation, G_DBUS_ERROR, G_DBUS_ERROR_INVALID_ARGS,
+                                           "side is left or right, not %s", side);
+    return;
+  }
+
+  for (GList *l = phoc_desktop_get_views (desktop)->head; l; l = l->next) {
+    PhocView *view = PHOC_VIEW (l->data);
+
+    if (!phoc_view_is_mapped (view) || view->parent != NULL)
+      continue;
+    if (g_strcmp0 (phoc_view_get_app_id (view), app_id) != 0)
+      continue;
+    tile_view (view, dir);
+    tiled++;
+  }
+  g_debug ("Tile %s %s: %u", app_id, side, tiled);
+  g_dbus_method_invocation_return_value (invocation, g_variant_new ("(u)", tiled));
+}
+
+
+static const GDBusInterfaceVTable vtable = { handle_method_call, NULL, NULL, { 0 } };
+
+
+static void
+on_bus_acquired (GDBusConnection *connection, const char *name, gpointer data)
+{
+  g_autoptr (GDBusNodeInfo) node = NULL;
+  g_autoptr (GError) err = NULL;
+
+  node = g_dbus_node_info_new_for_xml (introspection_xml, &err);
+  if (node == NULL) {
+    g_warning ("Cannot describe %s: %s", SFDUO_BUS_NAME, err->message);
+    return;
+  }
+  if (g_dbus_connection_register_object (connection, SFDUO_OBJECT_PATH, node->interfaces[0],
+                                         &vtable, NULL, NULL, &err) == 0)
+    g_warning ("Cannot publish %s: %s", SFDUO_OBJECT_PATH, err->message);
+}
+
+
+/**
+ * phoc_sfduo_control_start:
+ *
+ * Put org.sfduo.Phoc on the session bus.
+ */
+void
+phoc_sfduo_control_start (void)
+{
+  static guint id;
+
+  if (id)
+    return;
+  id = g_bus_own_name (G_BUS_TYPE_SESSION, SFDUO_BUS_NAME, G_BUS_NAME_OWNER_FLAGS_NONE,
+                       on_bus_acquired, NULL, NULL, NULL, NULL);
+}
diff --git a/src/sfduo-control.h b/src/sfduo-control.h
new file mode 100644
index 0000000..79a7ea5
--- /dev/null
+++ b/src/sfduo-control.h
@@ -0,0 +1,15 @@
