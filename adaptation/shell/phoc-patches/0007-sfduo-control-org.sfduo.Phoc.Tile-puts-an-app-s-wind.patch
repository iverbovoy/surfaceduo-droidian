+void phoc_sfduo_control_start (void);
+
+G_END_DECLS
diff --git a/src/view-ghost.c b/src/view-ghost.c
index fa91b32..4c57212 100644
--- a/src/view-ghost.c
+++ b/src/view-ghost.c
@@ -23,6 +23,7 @@
 
 #define PHOC_ANIM_DURATION_WINDOW_CLOSE 200
 #define PHOC_ANIM_DURATION_WINDOW_MINIMIZE 280
+#define PHOC_ANIM_DURATION_WINDOW_MOVE 260
 #define PHOC_VIEW_GHOST_CLOSE_SCALE 0.92      /* a closed window shrinks a little */
 #define PHOC_VIEW_GHOST_MINIMIZE_SCALE 0.3    /* a minimized one goes down small */
 #define PHOC_VIEW_GHOST_MINIMIZE_GAP 12       /* ... and stops this far above the edge */
@@ -62,6 +63,9 @@ struct _PhocViewGhost {
   enum wl_output_transform  transform;
   PhocViewGhostKind         kind;
   float                     progress;   /* 0 as the window was .. 1 gone */
+  /* moving: where the window is going, and the window, hidden meanwhile */
+  struct wlr_box            to;
+  PhocView                 *view;
 };
 
 G_DEFINE_TYPE (PhocViewGhost, phoc_view_ghost, G_TYPE_OBJECT)
@@ -71,11 +75,20 @@ static GList *ghosts;
 static void on_output_destroyed (gpointer data, GObject *where_the_object_was);
 
 
+static void damage_box (PhocViewGhost *self, struct wlr_box box);
+
 static void
 damage (PhocViewGhost *self)
 {
-  struct wlr_box box = self->box;
+  damage_box (self, self->box);
+  if (self->kind == PHOC_VIEW_GHOST_MOVE)
+    damage_box (self, self->to);
+}
 
+
+static void
+damage_box (PhocViewGhost *self, struct wlr_box box)
+{
   if (self->output == NULL || self->output->wlr_output == NULL)
     return;
 
@@ -179,6 +192,15 @@ place (PhocViewGhost *self, struct wlr_box *out, float *alpha)
   cx = self->box.x + self->box.width / 2.0;
   cy = self->box.y + self->box.height / 2.0;
 
+  if (self->kind == PHOC_VIEW_GHOST_MOVE) {
+    out->x = self->box.x + (self->to.x - self->box.x) * p;
+    out->y = self->box.y + (self->to.y - self->box.y) * p;
+    out->width = self->box.width + (self->to.width - self->box.width) * p;
+    out->height = self->box.height + (self->to.height - self->box.height) * p;
+    *alpha = 1.0;
+    return;
+  }
+
   if (self->kind == PHOC_VIEW_GHOST_MINIMIZE) {
     float end_cy;
 
@@ -202,6 +224,13 @@ place (PhocViewGhost *self, struct wlr_box *out, float *alpha)
 static void
 on_animation_done (PhocViewGhost *self)
 {
+  if (self->view) {
+    /* the window is where the ghost arrived: show it again */
+    g_object_set (self->view, "alpha", 1.0f, NULL);
+    phoc_view_damage_whole (self->view);
+    g_object_remove_weak_pointer (G_OBJECT (self->view), (gpointer *) &self->view);
+    self->view = NULL;
+  }
   damage (self);
   ghosts = g_list_remove (ghosts, self);
   g_object_unref (self);
@@ -224,8 +253,45 @@ on_output_destroyed (gpointer data, GObject *where_the_object_was)
  * Leave a ghost of @view behind that fades and shrinks away. Call it
  * while the view is still mapped and its surface still has its buffer.
  */
+static PhocViewGhost *ghost_new (PhocView *view, PhocViewGhostKind kind,
+                                  const struct wlr_box *to);
+
 void
 phoc_view_ghost_leave (PhocView *view, PhocViewGhostKind kind)
+{
+  ghost_new (view, kind, NULL);
+}
+
+
+/**
+ * phoc_view_ghost_move:
+ * @view: A view that has just been told to go elsewhere
+ * @from: where its surface was, in layout coordinates
+ * @to: where its surface is going
+ *
+ * A window put on the other panel jumped there in a frame. Its last
+ * buffer slides from @from to @to instead, and the window itself is not
+ * drawn until the ghost has arrived.
+ */
+void
+phoc_view_ghost_move (PhocView *view, const struct wlr_box *from, const struct wlr_box *to)
+{
+  PhocViewGhost *self;
+
+  if (from->x == to->x && from->y == to->y)
+    return;
+  self = ghost_new (view, PHOC_VIEW_GHOST_MOVE, to);
+  if (self == NULL)
+    return;
+  self->box = *from;
+  self->view = view;
+  g_object_add_weak_pointer (G_OBJECT (view), (gpointer *) &self->view);
+  g_object_set (view, "alpha", 0.0f, NULL);
+}
+
+
+static PhocViewGhost *
+ghost_new (PhocView *view, PhocViewGhostKind kind, const struct wlr_box *to)
 {
   PhocDesktop *desktop = phoc_server_get_desktop (phoc_server_get_default ());
   g_autoptr (PhocTimedAnimation) anim = NULL;
@@ -236,14 +302,14 @@ phoc_view_ghost_leave (PhocView *view, PhocViewGhostKind kind)
   float scale;
 
   if (!phoc_desktop_get_enable_animations (desktop) || view->parent != NULL)
-    return;
+    return NULL;
   if (phoc_view_is_fullscreen (view))
-    return;
+    return NULL;
   if (surface == NULL || surface->buffer == NULL || surface->buffer->texture == NULL)
-    return;
+    return NULL;
   output = phoc_view_get_output (view);
   if (output == NULL)
-    return;
+    return NULL;
 
   self = g_object_new (PHOC_TYPE_VIEW_GHOST, NULL);
   self->kind = kind;
@@ -261,26 +327,31 @@ phoc_view_ghost_leave (PhocView *view, PhocViewGhostKind kind)
     .width = surface->current.width * scale,
     .height = surface->current.height * scale,
   };
+  if (to)
+    self->to = *to;
   ghosts = g_list_prepend (ghosts, self);
 
   /* closing eases out, it is over quickly; minimizing eases in and out,
    * a movement that starts and lands */
   easer = g_object_new (PHOC_TYPE_PROPERTY_EASER,
                         "target", self,
-                        "easing", kind == PHOC_VIEW_GHOST_MINIMIZE ?
-                                  PHOC_EASING_EASE_IN_OUT_CUBIC : PHOC_EASING_EASE_OUT_CUBIC,
+                        "easing", kind == PHOC_VIEW_GHOST_CLOSE ?
+                                  PHOC_EASING_EASE_OUT_CUBIC : PHOC_EASING_EASE_IN_OUT_CUBIC,
                         NULL);
   phoc_property_easer_set_props (easer, "progress", 0.0, 1.0, NULL);
   anim = g_object_new (PHOC_TYPE_TIMED_ANIMATION,
                        "animatable", output,
                        "duration", kind == PHOC_VIEW_GHOST_MINIMIZE ?
                                    PHOC_ANIM_DURATION_WINDOW_MINIMIZE :
+                                   kind == PHOC_VIEW_GHOST_MOVE ?
+                                   PHOC_ANIM_DURATION_WINDOW_MOVE :
                                    PHOC_ANIM_DURATION_WINDOW_CLOSE,
                        "property-easer", easer,
                        "dispose-on-done", TRUE,
                        NULL);
   g_signal_connect_swapped (anim, "done", G_CALLBACK (on_animation_done), self);
   phoc_timed_animation_play (anim);
+  return self;
 }
 
 
@@ -294,7 +365,8 @@ phoc_view_ghost_leave (PhocView *view, PhocViewGhostKind kind)
 void
 phoc_view_ghosts_render (PhocOutput *output, PhocRenderContext *ctx)
 {
-  for (GList *l = ghosts; l; l = l->next) {
+  /* oldest first, so the ghost of the window put last is on top */
+  for (GList *l = g_list_last (ghosts); l; l = l->prev) {
     PhocViewGhost *self = PHOC_VIEW_GHOST (l->data);
     struct wlr_output *wlr_output = output->wlr_output;
     struct wlr_box dst, clip;
diff --git a/src/view-ghost.h b/src/view-ghost.h
index de93bfa..71964fc 100644
--- a/src/view-ghost.h
+++ b/src/view-ghost.h
@@ -26,9 +26,11 @@ G_DECLARE_FINAL_TYPE (PhocViewGhost, phoc_view_ghost, PHOC, VIEW_GHOST, GObject)
 typedef enum {
   PHOC_VIEW_GHOST_CLOSE,
   PHOC_VIEW_GHOST_MINIMIZE,
+  PHOC_VIEW_GHOST_MOVE,
 } PhocViewGhostKind;
 
 void   phoc_view_ghost_leave      (PhocView *view, PhocViewGhostKind kind);
+void   phoc_view_ghost_move       (PhocView *view, const struct wlr_box *from, const struct wlr_box *to);
 void   phoc_view_ghosts_render    (PhocOutput *output, PhocRenderContext *ctx);
 
