new file mode 100644
index 0000000..228066e
--- /dev/null
+++ b/src/view-ghost.h
@@ -0,0 +1,23 @@
+/*
+ * Copyright (C) 2026 The Surface Duo port
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#pragma once
+
+#include "render.h"
+#include "view.h"
+
+#include <glib-object.h>
+
+G_BEGIN_DECLS
+
+#define PHOC_TYPE_VIEW_GHOST (phoc_view_ghost_get_type ())
+
+G_DECLARE_FINAL_TYPE (PhocViewGhost, phoc_view_ghost, PHOC, VIEW_GHOST, GObject)
+
+void   phoc_view_ghost_leave      (PhocView *view);
+void   phoc_view_ghosts_render    (PhocOutput *output, PhocRenderContext *ctx);
+
+G_END_DECLS
diff --git a/src/view.c b/src/view.c
index 022d02f..e9b81ff 100644
--- a/src/view.c
+++ b/src/view.c
@@ -22,6 +22,7 @@
 #include "subsurface.h"
 #include "utils.h"
 #include "timed-animation.h"
+#include "view-ghost.h"
 #include "view-child-private.h"
 #include "view-private.h"
 
@@ -1397,6 +1398,10 @@ phoc_view_unmap (PhocView *view)
 
   bool was_visible = phoc_desktop_view_check_visibility (desktop, view);
 
+  /* the window fades and shrinks away rather than vanishing in a frame */
+  if (was_visible)
+    phoc_view_ghost_leave (view);
+
   phoc_view_damage_whole (view);
 
   wl_list_remove (&priv->surface_new_subsurface.link);
