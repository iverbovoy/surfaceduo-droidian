   g_object_notify_by_pspec (G_OBJECT (self), props[PROP_IS_MAPPED]);
@@ -2642,6 +2636,34 @@ phoc_view_is_minimized (PhocView *view)
 }
 
 
+/*
+ * Whether another window lies under this one, waiting to be seen: what the
+ * eye follows when this one is put away is that window, and a copy of this
+ * one flying down over it is one motion too many.
+ */
+static gboolean
+view_is_over_another (PhocView *view)
+{
+  PhocDesktop *desktop = phoc_server_get_desktop (phoc_server_get_default ());
+  struct wlr_box box;
+
+  phoc_view_get_box (view, &box);
+  for (GList *l = phoc_desktop_get_views (desktop)->head; l; l = l->next) {
+    PhocView *other = PHOC_VIEW (l->data);
+    struct wlr_box other_box, overlap;
+
+    if (other == view || other->parent != NULL)
+      continue;
+    if (!phoc_view_is_mapped (other) || phoc_view_is_minimized (other))
+      continue;
+    phoc_view_get_box (other, &other_box);
+    if (wlr_box_intersection (&overlap, &box, &other_box))
+      return TRUE;
+  }
+  return FALSE;
+}
+
+
 /**
  * phoc_view_set_minimized:
  * @view: a view
@@ -2670,7 +2692,8 @@ phoc_view_set_minimized (PhocView *view, gboolean minimized)
     return;
 
   if (minimized && phoc_desktop_view_check_visibility (desktop, view))
-    phoc_view_ghost_leave (view, PHOC_VIEW_GHOST_MINIMIZE);
+    phoc_view_ghost_leave (view, view_is_over_another (view) ?
+                           PHOC_VIEW_GHOST_CLOSE : PHOC_VIEW_GHOST_MINIMIZE);
   phoc_view_damage_whole (view);
   priv->minimized = minimized;
   if (priv->toplevel_handle)
