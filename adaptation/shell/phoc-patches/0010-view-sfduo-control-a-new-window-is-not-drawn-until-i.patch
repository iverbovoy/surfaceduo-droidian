+++ b/src/sfduo-control.c
@@ -8,6 +8,8 @@
 
 #include "phoc-config.h"
 
+#include "anim/property-easer.h"
+#include "anim/timed-animation.h"
 #include "desktop.h"
 #include "seat.h"
 #include "server.h"
@@ -64,6 +66,8 @@
  * shown before in about 65 ms, and draws nothing meanwhile. */
 #define SFDUO_WAKE_QUIET_MS 110
 #define SFDUO_WAKE_CAP_MS 700      /* ... and this is as long as it is ever waited for */
+#define SFDUO_HOLD_CAP_MS 700      /* a new window is never held longer than this */
+#define SFDUO_HOLD_FADE_MS 150     /* ... and fades in when it is let go */
 
 static const char introspection_xml[] =
   "<node>"
@@ -81,6 +85,42 @@ static const char introspection_xml[] =
   "</node>";
 
 
+/* A window kept out of sight until it is worth seeing: one woken behind the
+ * scenes for a page it is about to show, or a new one that has not been put
+ * on a panel yet. */
+typedef struct {
+  PhocView          *view;
+  struct wl_listener commit;
+  guint              quiet_id;
+  guint              cap_id;
+  gint64             started;
+  guint              commits;
+  gboolean           focus_at_end;   /* woken: it is what the hand asked for */
+  gboolean           wait_placed;    /* new: shown once placed and drawn there */
+  gboolean           placed;
+  guint32            want_width;     /* ... at this size, which is the panel's */
+  guint32            want_height;
+  float              last_scale;     /* a window fitted into a panel settles over a frame or two */
+  gboolean           fade;
+} PhocWake;
+
+static GSList *waking;
+
+
+/* Whether this window is being held out of sight until it is placed. */
+static gboolean
+view_is_held (PhocView *view)
+{
+  for (GSList *l = waking; l; l = l->next) {
+    PhocWake *wake = l->data;
+
+    if (wake->view == view && wake->wait_placed)
+      return TRUE;
+  }
+  return FALSE;
+}
+
+
 static void
 tile_view (PhocView *view, PhocViewTileDirection dir)
 {
@@ -91,6 +131,15 @@ tile_view (PhocView *view, PhocViewTileDirection dir)
   if (phoc_view_is_tiled (view) && phoc_view_get_tile_direction (view) == dir)
     return;
 
+  /* A window still held out of sight has nothing to slide: what would
+   * travel is the frame it drew at its own size, before anything put it on
+   * a panel, and it would be seen growing into place - the very thing the
+   * hold is there to prevent. It is simply put where it belongs. */
+  if (view_is_held (view)) {
+    phoc_view_tile (view, dir, NULL);
+    return;
+  }
+
   /* The surface's box, where it is and where it is going: the tile's box
    * is the window's geometry, the surface sits geom.x/y before it. */
   if (surface && phoc_view_get_tiled_box (view, dir, NULL, &tiled)) {
@@ -136,15 +185,33 @@ views_of (const char *app_id)
 }
 
 
-/* A window woken behind the scenes, on its way to being shown. */
-typedef struct {
-  PhocView          *view;
-  struct wl_listener commit;
-  guint              quiet_id;
-  guint              cap_id;
-  gint64             started;
-  guint              commits;
-} PhocWake;
+
+
+static void
+show_view (PhocView *view, gboolean fade)
+{
+  g_autoptr (PhocTimedAnimation) anim = NULL;
+  g_autoptr (PhocPropertyEaser) easer = NULL;
+
+  if (!fade) {
+    g_object_set (view, "alpha", 1.0f, NULL);
+    phoc_view_damage_whole (view);
+    return;
+  }
+
+  easer = g_object_new (PHOC_TYPE_PROPERTY_EASER,
+                        "target", view,
+                        "easing", PHOC_EASING_EASE_OUT_QUAD,
+                        NULL);
+  phoc_property_easer_set_props (easer, "alpha", 0.0, 1.0, NULL);
+  anim = g_object_new (PHOC_TYPE_TIMED_ANIMATION,
+                       "animatable", phoc_view_get_output (view),
+                       "duration", SFDUO_HOLD_FADE_MS,
+                       "property-easer", easer,
+                       "dispose-on-done", TRUE,
+                       NULL);
+  phoc_timed_animation_play (anim);
+}
 
 
 static void
@@ -153,17 +220,20 @@ wake_finish (PhocWake *wake)
   g_clear_handle_id (&wake->quiet_id, g_source_remove);
   g_clear_handle_id (&wake->cap_id, g_source_remove);
   wl_list_remove (&wake->commit.link);
+  waking = g_slist_remove (waking, wake);
 
-  g_debug ("wake done: %u frames in %" G_GINT64_FORMAT " ms%s", wake->commits,
+  g_debug ("%s done: %u frames in %" G_GINT64_FORMAT " ms%s",
+           wake->wait_placed ? "hold" : "wake", wake->commits,
            (g_get_monotonic_time () - wake->started) / 1000,
            wake->view ? "" : " (the window went)");
 
   if (wake->view) {
-    PhocSeat *seat = phoc_server_get_last_active_seat (phoc_server_get_default ());
+    show_view (wake->view, wake->fade);
+    if (wake->focus_at_end) {
+      PhocSeat *seat = phoc_server_get_last_active_seat (phoc_server_get_default ());
 
-    g_object_set (wake->view, "alpha", 1.0f, NULL);
-    phoc_view_damage_whole (wake->view);
-    phoc_seat_set_focus_view (seat, wake->view);
+      phoc_seat_set_focus_view (seat, wake->view);
+    }
     g_object_remove_weak_pointer (G_OBJECT (wake->view), (gpointer *) &wake->view);
   }
   g_free (wake);
@@ -192,20 +262,87 @@ on_wake_cap (gpointer data)
 }
 
 
+/* Whether the window is drawn at the size of the panel it is on. */
+static gboolean
+view_fills_its_panel (PhocView *view)
+{
+  struct wlr_box tile;
+  float scale;
+  int width, height;
+
+  if (view == NULL)
+    return TRUE;
+  if (!phoc_view_is_tiled (view))
+    return TRUE;                 /* nobody gave it a panel to fill */
+  if (!phoc_view_get_tiled_box (view, phoc_view_get_tile_direction (view), NULL, &tile))
+    return TRUE;
+
+  scale = phoc_view_get_scale (view);
+  width = (int) (view->box.width * scale + 0.5);
+  height = (int) (view->box.height * scale + 0.5);
+  g_debug ("  drawn %dx%d (%dx%d at %.3f), panel %dx%d",
+           width, height, view->box.width, view->box.height, scale, tile.width, tile.height);
+  return ABS (width - tile.width) <= 2 && ABS (height - tile.height) <= 2;
+}
+
+
 static void
 on_wake_commit (struct wl_listener *listener, void *data)
 {
   PhocWake *wake = wl_container_of (listener, wake, commit);
 
-  /* still drawing: the page is on its way */
   wake->commits++;
-  g_debug ("wake frame %u at %" G_GINT64_FORMAT " ms", wake->commits,
-           (g_get_monotonic_time () - wake->started) / 1000);
+  g_debug ("%s frame %u at %" G_GINT64_FORMAT " ms%s: %dx%d scale %.3f",
+           wake->wait_placed ? "hold" : "wake", wake->commits,
+           (g_get_monotonic_time () - wake->started) / 1000,
+           wake->placed ? " (placed)" : "",
+           wake->view ? wake->view->box.width : 0,
+           wake->view ? wake->view->box.height : 0,
+           wake->view ? phoc_view_get_scale (wake->view) : 0.0);
+
+  /* A new window waits to be put on a panel and to draw itself at the size
+   * it was given there. The frame right after the placing is still the
+   * client's own size - it answers a configure a frame or two later - and
+   * showing that one is showing the jump this is here to avoid. */
+  if (wake->wait_placed) {
+    if (!wake->placed)
+      return;
+    /* Drawn as large as the panel it was put on. The size alone is not it:
+     * a window is scaled down to fit its panel, and the panel is shorter
+     * while the shell's bar is still on it - the bar moves to the free one
+     * once there is a window here - so the window was drawn small and grew
+     * as the bar left. Nor is that enough: a client answers the size first
+     * and lays its contents out for it over the frames after, which is a
+     * page visibly settling. So once it is the panel's size, it is waited
+     * on as a woken window is - until it stops drawing. */
+    if (!view_fills_its_panel (wake->view))
+      return;
+    wake->wait_placed = FALSE;
+  }
+
+  /* one woken for a page: still drawing, the page is on its way */
   g_clear_handle_id (&wake->quiet_id, g_source_remove);
   wake->quiet_id = g_timeout_add (SFDUO_WAKE_QUIET_MS, on_wake_quiet, wake);
 }
 
 
+static PhocWake *
+hold_view (PhocView *view, guint cap_ms)
+{
+  PhocWake *wake = g_new0 (PhocWake, 1);
+
+  wake->view = view;
+  wake->started = g_get_monotonic_time ();
+  g_object_add_weak_pointer (G_OBJECT (view), (gpointer *) &wake->view);
+  g_object_set (view, "alpha", 0.0f, NULL);
+  wake->commit.notify = on_wake_commit;
+  wl_signal_add (&view->wlr_surface->events.commit, &wake->commit);
+  wake->cap_id = g_timeout_add (cap_ms, on_wake_cap, wake);
+  waking = g_slist_prepend (waking, wake);
+  return wake;
+}
+
+
 static void
 wake_view (PhocView *view)
 {
@@ -216,19 +353,66 @@ wake_view (PhocView *view)
     return;
   }
 
-  wake = g_new0 (PhocWake, 1);
-  wake->view = view;
-  wake->started = g_get_monotonic_time ();
   g_debug ("waking %s", phoc_view_get_app_id (view));
-  g_object_add_weak_pointer (G_OBJECT (view), (gpointer *) &wake->view);
+  wake = hold_view (view, SFDUO_WAKE_CAP_MS);
+  wake->focus_at_end = TRUE;
   /* awake - its client starts drawing again - but with nothing to see yet */
-  g_object_set (view, "alpha", 0.0f, NULL);
   phoc_view_set_minimized (view, FALSE);
-  wake->commit.notify = on_wake_commit;
-  wl_signal_add (&view->wlr_surface->events.commit, &wake->commit);
-  /* nothing counted until it draws; the cap is what saves a client that
-   * never does */
-  wake->cap_id = g_timeout_add (SFDUO_WAKE_CAP_MS, on_wake_cap, wake);
+}
+
+
+/**
+ * phoc_sfduo_control_hold_new_view:
+ * @view: a view that has just been mapped
+ *
+ * Keep a new window out of sight until it is where it belongs.
+ *
+ * A window is mapped at whatever size its client asked for and placed
+ * afterwards - by the dock, a beat later - so it was drawn twice over: its
+ * own size and place first, the panel's second, with the client laying its
+ * contents out again in between. What that looks like is a window that
+ * appears, jumps and reflows. Held here, it appears once: at the first
+ * frame it draws after it has been put on a panel, fading in. A window
+ * nobody places is shown when the hold runs out.
+ */
+void
+phoc_sfduo_control_hold_new_view (PhocView *view)
+{
+  PhocWake *wake;
+
+  if (view->wlr_surface == NULL)
+    return;
+
+  g_debug ("holding %s", phoc_view_get_app_id (view));
+  wake = hold_view (view, SFDUO_HOLD_CAP_MS);
+  wake->wait_placed = TRUE;
+  wake->fade = TRUE;
+  wake->last_scale = -1.0f;         /* unknown until the first frame */
+}
+
+
+/**
+ * phoc_sfduo_control_view_placed:
+ * @view: a view that has just been put on a panel
+ *
+ * Told to a window being held: the frame after this is the one to show.
+ */
+void
+phoc_sfduo_control_view_placed (PhocView *view)
+{
+  for (GSList *l = waking; l; l = l->next) {
+    PhocWake *wake = l->data;
+
+    if (wake->view != view)
+      continue;
+    wake->placed = TRUE;
+    /* what the placing asked the client for; zero when it was already
+     * that size and there is nothing to wait for */
+    wake->want_width = view->pending_move_resize.width;
+    wake->want_height = view->pending_move_resize.height;
+    g_debug ("placed %s, waiting for %ux%u", phoc_view_get_app_id (view),
+             wake->want_width, wake->want_height);
+  }
 }
 
 
