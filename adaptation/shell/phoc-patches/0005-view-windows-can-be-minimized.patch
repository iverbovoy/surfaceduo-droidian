From f7d7ea2e6eeb7dc2cd12cd085d8572ca309491c6 Mon Sep 17 00:00:00 2001
From: Ivan Verbovoy <ivanverbovoy@gmail.com>
Date: Sat, 19 Sep 2026 23:08:46 +0300
Subject: [PATCH] view: windows can be minimized

phoc had no minimize: xdg_toplevel's set_minimized and a wlr-foreign-toplevel
minimize request were dropped, and xdg-toplevel said so to clients. A view
now has a minimized state: set by either request, reported on the foreign
toplevel handle, and advertised as a capability. A minimized view stays
mapped but is not drawn and takes no input (it is not visible to
phoc_desktop_view_check_visibility), fades away as a closed view does, and
hands the focus to the next view. Focusing it - which is what a foreign
toplevel activate request does - brings it back.
---
 src/desktop.c      |  2 +-
 src/seat.c         |  4 ++
 src/view.c         | 95 ++++++++++++++++++++++++++++++++++++++++++++++
 src/view.h         |  2 +
 src/xdg-toplevel.c | 16 +++++++-
 5 files changed, 117 insertions(+), 2 deletions(-)

diff --git a/src/desktop.c b/src/desktop.c
index 708772c..d65ef57 100644
--- a/src/desktop.c
+++ b/src/desktop.c
@@ -331,7 +331,7 @@ phoc_desktop_view_check_visibility (PhocDesktop *self, PhocView *view)
 
   priv = phoc_desktop_get_instance_private (self);
 
-  if (!phoc_view_is_mapped (view)) {
+  if (!phoc_view_is_mapped (view) || phoc_view_is_minimized (view)) {
     visible = FALSE;
     goto out;
   }
diff --git a/src/seat.c b/src/seat.c
index 1430454..77b086f 100644
--- a/src/seat.c
+++ b/src/seat.c
@@ -1419,6 +1419,10 @@ phoc_seat_set_focus_view (PhocSeat *seat, PhocView *view)
   if (view && !phoc_seat_allow_input (seat, view->wlr_surface->resource))
     return;
 
+  /* focusing a minimized view is bringing it back */
+  if (view && phoc_view_is_minimized (view))
+    phoc_view_set_minimized (view, FALSE);
+
   /* Make sure the view will be rendered on top of others, even if it's
    * already focused in this seat */
   if (view) {
diff --git a/src/view.c b/src/view.c
index e9b81ff..8cedfe5 100644
--- a/src/view.c
+++ b/src/view.c
@@ -70,6 +70,7 @@ typedef struct _PhocViewPrivate {
 
   gulong         notify_scale_to_fit_id;
   gboolean       scale_to_fit;
+  gboolean       minimized;
   char          *activation_token;
   int            activation_token_type;
   GSList        *blings; /* PhocBlings */
@@ -80,6 +81,7 @@ typedef struct _PhocViewPrivate {
   struct wl_listener toplevel_handle_request_activate;
   struct wl_listener toplevel_handle_request_fullscreen;
   struct wl_listener toplevel_handle_request_close;
+  struct wl_listener toplevel_handle_request_minimize;
   /* ext-foreign-toplevel-list */
   struct wlr_ext_foreign_toplevel_handle_v1 *ext_foreign_toplevel_v1_handle;
 
@@ -298,6 +300,17 @@ handle_toplevel_handle_request_fullscreen (struct wl_listener *listener, void *d
 }
 
 
+static void
+handle_toplevel_handle_request_minimize (struct wl_listener *listener, void *data)
+{
+  PhocViewPrivate *priv = wl_container_of (listener, priv, toplevel_handle_request_minimize);
+  PhocView *self = PHOC_VIEW_SELF (priv);
+  struct wlr_foreign_toplevel_handle_v1_minimized_event *event = data;
+
+  phoc_view_set_minimized (self, event->minimized);
+}
+
+
 static void
 handle_toplevel_handle_request_close (struct wl_listener *listener, void *data)
 {
@@ -336,6 +349,10 @@ view_create_foreign_toplevel_handle (PhocView *self)
   priv->toplevel_handle_request_close.notify = handle_toplevel_handle_request_close;
   wl_signal_add(&priv->toplevel_handle->events.request_close, &priv->toplevel_handle_request_close);
 
+  priv->toplevel_handle_request_minimize.notify = handle_toplevel_handle_request_minimize;
+  wl_signal_add(&priv->toplevel_handle->events.request_minimize,
+                &priv->toplevel_handle_request_minimize);
+
   priv->toplevel_handle->data = self;
 
   wlr_foreign_toplevel_handle_v1_set_title (priv->toplevel_handle, priv->title ?: "");
@@ -361,6 +378,7 @@ phoc_view_destroy_toplevel_handle (PhocView *self)
   wl_list_remove (&priv->toplevel_handle_request_activate.link);
   wl_list_remove (&priv->toplevel_handle_request_fullscreen.link);
   wl_list_remove (&priv->toplevel_handle_request_close.link);
+  wl_list_remove (&priv->toplevel_handle_request_minimize.link);
   wlr_foreign_toplevel_handle_v1_destroy (priv->toplevel_handle);
   priv->toplevel_handle = NULL;
 
@@ -2518,3 +2536,80 @@ phoc_view_set_visibility (PhocView *self, gboolean visibility)
 
   phoc_view_set_suspended (self, !visibility);
 }
+
+
+/**
+ * phoc_view_is_minimized:
+ * @view: a view
+ *
+ * Returns: whether the view is minimized: mapped, but put away
+ */
+gboolean
+phoc_view_is_minimized (PhocView *view)
+{
+  PhocViewPrivate *priv;
+
+  g_assert (PHOC_IS_VIEW (view));
+  priv = phoc_view_get_instance_private (view);
+
+  return priv->minimized;
+}
+
+
+/**
+ * phoc_view_set_minimized:
+ * @view: a view
+ * @minimized: whether to put it away or bring it back
+ *
+ * phoc had no minimize: xdg_toplevel's set_minimized and a
+ * wlr-foreign-toplevel minimize request were dropped, so a window could
+ * only be closed or covered. A minimized view stays mapped - its client
+ * carries on - but is not drawn and takes no input
+ * (phoc_desktop_view_check_visibility), and gives the focus to the next
+ * view. It fades away as a closed one does. Focusing it brings it back
+ * (phoc_seat_set_focus_view), which is what activating it through the
+ * foreign-toplevel handle does.
+ */
+void
+phoc_view_set_minimized (PhocView *view, gboolean minimized)
+{
+  PhocInput *input = phoc_server_get_input (phoc_server_get_default ());
+  PhocDesktop *desktop = phoc_server_get_desktop (phoc_server_get_default ());
+  PhocViewPrivate *priv;
+
+  g_assert (PHOC_IS_VIEW (view));
+  priv = phoc_view_get_instance_private (view);
+
+  if (priv->minimized == minimized || !phoc_view_is_mapped (view))
+    return;
+
+  if (minimized && phoc_desktop_view_check_visibility (desktop, view))
+    phoc_view_ghost_leave (view);
+  phoc_view_damage_whole (view);
+  priv->minimized = minimized;
+  if (priv->toplevel_handle)
+    wlr_foreign_toplevel_handle_v1_set_minimized (priv->toplevel_handle, minimized);
+  phoc_view_damage_whole (view);
+
+  if (!minimized)
+    return;
+
+  /* The focus goes to the next view that is still there, or nowhere */
+  for (GSList *elem = phoc_input_get_seats (input); elem; elem = elem->next) {
+    PhocSeat *seat = PHOC_SEAT (elem->data);
+    PhocView *next = NULL;
+
+    if (phoc_seat_get_focus_view (seat) != view)
+      continue;
+    for (GList *l = phoc_desktop_get_views (desktop)->head; l; l = l->next) {
+      PhocView *candidate = PHOC_VIEW (l->data);
+
+      if (candidate != view && phoc_view_is_mapped (candidate) &&
+          !phoc_view_is_minimized (candidate) && candidate->parent == NULL) {
+        next = candidate;
+        break;
+      }
+    }
+    phoc_seat_set_focus_view (seat, next);
+  }
+}
diff --git a/src/view.h b/src/view.h
index 22783a2..58d741a 100644
--- a/src/view.h
+++ b/src/view.h
@@ -151,6 +151,8 @@ void                  phoc_view_activate (PhocView *self, bool activate);
 void                  phoc_view_damage_whole (PhocView *view);
 gboolean              phoc_view_is_floating (PhocView *view);
 gboolean              phoc_view_is_maximized (PhocView *view);
+gboolean              phoc_view_is_minimized (PhocView *view);
+void                  phoc_view_set_minimized (PhocView *view, gboolean minimized);
 gboolean              phoc_view_is_tiled (PhocView *view);
 gboolean              phoc_view_is_fullscreen (PhocView *self);
 void                  phoc_view_update_decorated (PhocView *view, bool decorated);
diff --git a/src/xdg-toplevel.c b/src/xdg-toplevel.c
index c6c18c5..3416193 100644
--- a/src/xdg-toplevel.c
+++ b/src/xdg-toplevel.c
@@ -56,6 +56,7 @@ typedef struct _PhocXdgToplevel {
   struct wl_listener         request_move;
   struct wl_listener         request_resize;
   struct wl_listener         request_maximize;
+  struct wl_listener         request_minimize;
   struct wl_listener         request_fullscreen;
   struct wl_listener         set_title;
   struct wl_listener         set_app_id;
@@ -401,9 +402,10 @@ handle_surface_commit (struct wl_listener *listener, void *data)
                               output);
     phoc_view_auto_maximize (PHOC_VIEW (self));
     view_set_title (PHOC_VIEW (self), self->xdg_toplevel->title);
-    /* We don't do window menus or minimize */
+    /* We don't do window menus */
     phoc_xdg_toplevel_set_capabilities (self,
                                         WLR_XDG_TOPLEVEL_WM_CAPABILITIES_MAXIMIZE |
+                                        WLR_XDG_TOPLEVEL_WM_CAPABILITIES_MINIMIZE |
                                         WLR_XDG_TOPLEVEL_WM_CAPABILITIES_FULLSCREEN);
 
     if (self->decoration)
@@ -535,6 +537,15 @@ handle_request_resize (struct wl_listener *listener, void *data)
 }
 
 
+static void
+handle_request_minimize (struct wl_listener *listener, void *data)
+{
+  PhocXdgToplevel *self = wl_container_of (listener, self, request_minimize);
+
+  phoc_view_set_minimized (PHOC_VIEW (self), TRUE);
+}
+
+
 static void
 handle_request_maximize (struct wl_listener *listener, void *data)
 {
@@ -638,6 +649,8 @@ phoc_xdg_toplevel_constructed (GObject *object)
 
   self->request_maximize.notify = handle_request_maximize;
   wl_signal_add (&self->xdg_toplevel->events.request_maximize, &self->request_maximize);
+  self->request_minimize.notify = handle_request_minimize;
+  wl_signal_add (&self->xdg_toplevel->events.request_minimize, &self->request_minimize);
 
   self->request_fullscreen.notify = handle_request_fullscreen;
   wl_signal_add (&self->xdg_toplevel->events.request_fullscreen, &self->request_fullscreen);
@@ -668,6 +681,7 @@ phoc_xdg_toplevel_finalize (GObject *object)
   wl_list_remove (&self->request_move.link);
   wl_list_remove (&self->request_resize.link);
   wl_list_remove (&self->request_maximize.link);
+  wl_list_remove (&self->request_minimize.link);
   wl_list_remove (&self->request_fullscreen.link);
   wl_list_remove (&self->set_title.link);
   wl_list_remove (&self->set_app_id.link);
-- 
