#!/bin/sh
# sfduo-shell-setup: what the two-panel shell needs that a fresh Droidian
# image does not have. The adaptation package only recommends these - it is
# installed offline, with dpkg, before the device has ever seen a network -
# so this is the step to run once it has one.
set -e
[ "$(id -u)" = 0 ] || { echo "run as root: sudo $0" >&2; exit 1; }
apt-get update
apt-get install -y wlrctl wtype gir1.2-gtklayershell-0.1 python3-gi python3-gi-cairo \
    python3-cairo gir1.2-gtk-3.0 dconf-cli \
    gir1.2-gtk-4.0 gir1.2-adw-1 gir1.2-ecal-2.0 gir1.2-edataserver-1.2
# now that the dock can run, windows tile to a panel: the lock that holds
# phosh's auto-maximize off goes in with the patched phosh (sfduo-phosh-install
# leaves it out while the dock's dependencies are missing)
[ -x /usr/local/sbin/sfduo-phosh-install ] && /usr/local/sbin/sfduo-phosh-install || true
dconf update
echo "done - restart the shell (systemctl restart phosh) or reboot"
