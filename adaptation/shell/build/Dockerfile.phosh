# Build phosh the way this device's phosh was built.
#
# Droidian rolling, arm64, run through qemu on an x86 desk. The libraries have
# to be Droidian's own rather than Debian's: the binary is going to be dropped
# next to them, and phosh 0.49 wants a gmobile and a libcall-ui newer than
# Debian trixie ships.
#
# The repository is reached at its real address. The `droidian+http` apt
# transport on the device is a redirector - plain http to the root is 403, and
# what it actually fetches is /snapshots/current/.
FROM debian:trixie

RUN echo 'deb [trusted=yes] http://releases.droidian.org/snapshots/current/ rolling main' \
      > /etc/apt/sources.list.d/droidian.list \
 && printf 'Package: *\nPin: origin releases.droidian.org\nPin-Priority: 1001\n' \
      > /etc/apt/preferences.d/droidian \
 && apt-get update

# --allow-downgrades because the pin puts Droidian's packages above
# Debian's and some of them are older; that is the point of the pin.
RUN apt-get install -y --no-install-recommends --allow-downgrades \
      build-essential meson ninja-build pkg-config git ca-certificates \
      gsettings-desktop-schemas-dev libadwaita-1-dev libappstream-dev \
      libcallaudio-dev libevince-dev libgirepository1.0-dev libgmobile-dev \
      libjson-glib-dev libsecret-1-dev libsystemd-dev libfeedback-dev \
      libfribidi-dev libgcr-3-dev libgnome-bluetooth-3.0-dev libglib2.0-dev \
      libgnome-desktop-3-dev libgtk-3-dev libgtk-4-dev libgudev-1.0-dev \
      libhandy-1-dev libmm-glib-dev libnm-dev libpam0g-dev \
      libpolkit-agent-1-dev libpulse-dev libupower-glib-dev libwayland-dev \
      libxml2-utils python3-docutils valac gi-docgen \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# Every -dev package debian/control asks for, taken from the file rather than
# typed out: the first hand-written list missed libsoup and named the wrong
# evolution package, and each miss costs a full configure round under qemu.
# Phosh's own binary packages are filtered out - they are what this builds.
RUN apt-get update \
 && apt-get install -y --no-install-recommends --allow-downgrades \
      evolution-data-server-dev gsettings-desktop-schemas-dev libadwaita-1-dev libappstream-dev libcallaudio-dev libecal2.0-dev libevince-dev libfeedback-dev libfribidi-dev libgcr-3-dev libgirepository1.0-dev libglib2.0-dev libgmobile-dev libgnome-bluetooth-3.0-dev libgnome-desktop-3-dev libgtk-3-dev libgtk-4-dev libgudev-1.0-dev libhandy-1-dev libjson-glib-dev libmm-glib-dev libnm-dev libpam0g-dev libpolkit-agent-1-dev libpulse-dev libsecret-1-dev libsoup-3.0-dev libsystemd-dev libupower-glib-dev libwayland-dev  \
 && rm -rf /var/lib/apt/lists/*

# Tools debian/control lists without a -dev suffix, so the extraction above
# misses them: the translations, the .desktop check, glib's own helpers.
RUN apt-get update \
 && apt-get install -y --no-install-recommends --allow-downgrades \
      gettext desktop-file-utils libglib2.0-dev-bin xmlstarlet \
 && rm -rf /var/lib/apt/lists/*
