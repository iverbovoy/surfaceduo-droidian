        ("Top Bar", "What the status bar shows", "view-app-grid-symbolic", ("mobile", "topbar")),
        ("Lock Screen", "What shows while locked", "system-lock-screen-symbolic", ("mobile", "lockscreen")),
    ]),
    ("Sound and Notifications", [
        ("Sound", None, "audio-speakers-symbolic", ("gnome", "sound")),
        ("Notifications", None, "preferences-system-notifications-symbolic", ("gnome", "notifications")),
