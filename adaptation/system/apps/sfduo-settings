#!/usr/bin/python3
# sfduo-settings: one Settings for this device (#78).
#
# The device came with three settings programs and none of them fits it:
# GNOME Settings (22 pages, a fifth of them for hardware this phone does not
# have), Mobile Settings (the shell's knobs, on pages of their own), and the
# port's switches, which were files and scripts. GNOME Settings keeps its
# grouping in its code, so regrouping it would be a third patched binary to
# keep in step with its package. This is a list of our own instead: the
# pages grouped for a phone with two panels, each row opening the page it
# names in whichever program has it - `gnome-control-center <panel>`,
# `phosh-mobile-settings <panel>` - or a page of this one.
#
# Left out on purpose: Printers; NFC (nfcd does not start, there is no NFC
# device); Waydroid (not installed); Remote desktop; Thunderbolt and Device
# security; Mobile Settings' alerts (broken here: its schema is missing) and
# convergence (an external display, never tested); Displays - phosh applies a
# scale set there live, over phoc.ini's, and the dock and the shell's CSS
# are made for the scale in phoc.ini; Encryption, until it has been tried
# with this device's boot chain. The programs stay installed and can still
# be opened directly.
#
# On the Duo everything stays on the panel Settings was opened on: before a
# row opens its page the dock is asked to put that program's window where
# this one is (org.sfduo.Dock.Follow), so the page comes up over the list
# and the other panel is left as it was.

import os
import subprocess
import sys

import gi

# GNOME Settings has left the grid for this, so this must always open
# something: should GTK4 or libadwaita for Python be missing (a Droidian
# image ships both today; `sudo sfduo-shell-setup` installs them too), it
# opens GNOME Settings instead - the way to Wi-Fi, and so to getting online.
try:
    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    from gi.repository import Adw, Gio, GLib, Gtk  # noqa: E402
except (ValueError, ImportError) as err:
    print(f"sfduo-settings: {err} - opening GNOME Settings; "
          "`sudo sfduo-shell-setup` once online brings this one", file=sys.stderr)
    os.execvp("gnome-control-center", ["gnome-control-center"])

APP_ID = "org.sfduo.Settings"
GNOME = "gnome-control-center"
MOBILE = "phosh-mobile-settings"
APP_IDS = {GNOME: "org.gnome.Settings", MOBILE: "mobi.phosh.MobileSettings"}

