def follow_me(program):
    """Ask the dock to open the program's window on this one's panel."""
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        bus.call_sync("org.sfduo.Dock", "/org/sfduo/Dock", "org.sfduo.Dock", "Follow",
                      GLib.Variant("(ss)", (APP_IDS[program], APP_ID)),
                      None, Gio.DBusCallFlags.NO_AUTO_START, 1000, None)
    except GLib.Error:
        pass            # no dock, or an older one: the page goes where it goes


def run(argv):
    """Start a program and forget it: the pages are windows of their own."""
    if argv[0] in APP_IDS:
        follow_me(argv[0])
    try:
        subprocess.Popen(argv, start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError as err:
        print(f"sfduo-settings: {argv[0]}: {err}", file=sys.stderr)


def read(path):
    try:
        with open(path) as fp:
            return fp.read().strip()
    except OSError:
        return None


class DuoPage(Adw.NavigationPage):
    """What the port is, and what it changed. The switches come in #20."""

    def __init__(self):
        super().__init__(title="Surface Duo")
        page = Adw.PreferencesPage()

        about = Adw.PreferencesGroup(title="This Device")
        for title, value in (
            ("Port", self._package_version()),
            ("Kernel", os.uname().release),
            ("Shell", self._shell()),
            ("Output scale", self._scale()),
        ):
            row = Adw.ActionRow(title=title, subtitle=value or "unknown")
            row.add_css_class("property")
            about.add(row)
        page.add(about)

        later = Adw.PreferencesGroup(
            title="Switches",
            description="The two-panel shell, the dock, the fold effect and the "
                        "output scale will be switched here. Until then they are "
                        "changed with the sfduo-* commands.")
        page.add(later)

        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        view.set_content(page)
        self.set_child(view)

    @staticmethod
    def _package_version():
        try:
            out = subprocess.run(
                ["dpkg-query", "-W", "-f", "${Version}", "adaptation-droidian-surfaceduo"],
                capture_output=True, text=True, check=False).stdout.strip()
        except OSError:
            return None
        return out or None

    @staticmethod
    def _shell():
        if os.path.exists("/etc/sfduo/phosh-stock"):
            return "stock phosh (the port's shell restored away)"
        version = read("/usr/lib/sfduo/phosh/version")
        return "phosh with the port's patches" if version else "stock phosh"

    @staticmethod
    def _scale():
        text = read("/etc/phosh/phoc.ini") or ""
        for line in text.splitlines():
            key, _, value = line.partition("=")
            if key.strip() == "scale":
                return value.strip()
        return None


class Window(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Settings")
        self.set_default_size(420, 800)

        self.nav = Adw.NavigationView()
        page = Adw.PreferencesPage()
        for title, rows in BLOCKS:
            group = Adw.PreferencesGroup(title=title)
            for name, subtitle, icon, target in rows:
                group.add(self._row(name, subtitle, icon, target))
            page.add(group)

        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        view.set_content(page)
        self.nav.add(Adw.NavigationPage(title="Settings", child=view))
        self.set_content(self.nav)
        self.connect("notify::is-active", self._on_active)
        # Back at the list, the first page, goes nowhere in the navigation -
        # so it leaves: the window is minimized, as back from an app's first
        # screen does on a phone. The navigation view takes Alt+Left while
        # it can pop; only what it lets through reaches this, in the bubble
        # phase. Alt+Left is what the dock's swipe from the edge sends (#80).
        shortcuts = Gtk.ShortcutController()
        shortcuts.set_propagation_phase(Gtk.PropagationPhase.BUBBLE)
        shortcuts.add_shortcut(Gtk.Shortcut.new(
            Gtk.ShortcutTrigger.parse_string("<Alt>Left"),
            Gtk.CallbackAction.new(self._back_at_root)))
        self.add_controller(shortcuts)

    def _back_at_root(self, *_args):
        if self.nav.get_previous_page(self.nav.get_visible_page()) is not None:
            return False                # not the first page: the view's to handle
        self.minimize()
        return True

    def _row(self, name, subtitle, icon, target):
        row = Adw.ActionRow(title=name, activatable=True)
        if subtitle:
            row.set_subtitle(subtitle)
        row.add_prefix(Gtk.Image.new_from_icon_name(icon))
        row.add_suffix(Gtk.Image.new_from_icon_name("go-next-symbolic"))
        row.connect("activated", lambda _r: self._open(name, target))
        return row

    def _open(self, name, target):
        kind = target[0]
        if kind == "duo":
            self.nav.push(DuoPage())
            return
        # The page is another program's window, a second or so away on a
        # cold start. Answer the tap now, in this window's own motion: slide
        # in a page with the same title, and let the window land on it.
        self._wait(name)
        if kind == "gnome":
            run([GNOME, *target[1:]])
        elif kind == "mobile":
            run([MOBILE, target[1]])

    # ---- the page another program shows --------------------------------------
    #
    # A row that opens GNOME Settings or Mobile Settings pushes a stand-in
    # here first, titled as the page will be, and the program's window then
    # comes up over it on this panel (the dock's Follow). Back in that window
    # closes it (sfduo-one-column), this window is the active one again, and
    # the stand-in slides away: to the eye, one program going forward and
    # back. If the window never comes, the stand-in goes by itself.

    WAIT_SPINNER_MS = 500           # a spinner only if the wait is long enough to see
    WAIT_GIVE_UP_S = 8

    def _wait(self, title):
        self._end_wait()
        spinner = Adw.Spinner()
        spinner.set_size_request(32, 32)
        spinner.set_halign(Gtk.Align.CENTER)
        spinner.set_valign(Gtk.Align.CENTER)
        spinner.set_visible(False)
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        view.set_content(spinner)
        self.stand_in = Adw.NavigationPage(title=title, child=view)
        self.stand_in.connect("hidden", lambda page: self._stand_in_gone(page))
        self.left = False
        self.nav.push(self.stand_in)
        self.wait_timers = {
            "spinner": GLib.timeout_add(self.WAIT_SPINNER_MS, self._fired, "spinner",
                                        lambda: spinner.set_visible(True)),
            "give-up": GLib.timeout_add_seconds(self.WAIT_GIVE_UP_S, self._fired, "give-up",
                                                self._give_up),
        }

    def _fired(self, key, action):
        self.wait_timers.pop(key, None)
        action()
        return False

    def _on_active(self, *_args):
        stand_in = getattr(self, "stand_in", None)
        if stand_in is None:
            return
        if not self.is_active():
            self.left = True                # the program's window took over
            self._stop_timers()
        elif self.left:
            self.nav.pop_to_page(self.nav.get_previous_page(stand_in) or stand_in)

    def _give_up(self):
        if getattr(self, "stand_in", None) is not None and not self.left:
            self.nav.pop()

    def _stop_timers(self):
        for timer in getattr(self, "wait_timers", {}).values():
            GLib.source_remove(timer)
        self.wait_timers = {}

    def _stand_in_gone(self, page):
        if page is getattr(self, "stand_in", None):
            self._end_wait()

    def _end_wait(self):
        self._stop_timers()
        self.stand_in = None
        self.left = False


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID,
                         flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self):
        window = self.get_active_window() or Window(self)
        window.present()


def main():
    GLib.set_prgname(APP_ID)
    sys.exit(App().run(sys.argv))


if __name__ == "__main__":
    main()
