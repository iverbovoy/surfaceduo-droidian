_bus = None


def bus():
    global _bus
    if _bus is None:
        _bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    return _bus


def said(name, path, interface, method, args, flags=Gio.DBusCallFlags.NONE, then=None):
    """A call whose answer nobody waits for, and what to do once it comes.

    Everything here is said while a finger is still on the screen, and one
    of these - activating a program that is not running yet - takes the best
    part of a second to come back. Waiting for any of them would hold the
    list still for that long."""
    def done(conn, result):
        try:
            conn.call_finish(result)
        except GLib.Error as err:
            print(f"sfduo-settings: {method}: {err.message}", file=sys.stderr)
            return
        if then is not None:
            then()

    bus().call(name, path, interface, method, args, None, flags, 20000, None, done)


def follow_me(program):
    """Ask the dock to open the program's window on this one's panel."""
    said("org.sfduo.Dock", "/org/sfduo/Dock", "org.sfduo.Dock", "Follow",
         GLib.Variant("(ss)", (APP_IDS[program], APP_ID)),
         Gio.DBusCallFlags.NO_AUTO_START)


def is_running(program):
    """Whether the program holds its name on the bus - whether, that is,
    there is a window of it to switch rather than a program to start."""
    try:
        answer = bus().call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus",
                                 "org.freedesktop.DBus", "NameHasOwner",
                                 GLib.Variant("(s)", (APP_IDS[program],)), None,
                                 Gio.DBusCallFlags.NONE, 1000, None)
    except GLib.Error:
        return False
    return answer.unpack()[0]


def open_page(program, panel, extra=()):
    """Show a page of another settings program.

    The page is an action of that program: `launch-panel` for GNOME
    Settings, `set-panel` for Mobile Settings, both taking (panel, args).
    Running, it switches to the page in the window it has - a tenth of a
    second, and no window for the shell to place. Not running, the same
    call starts it through its D-Bus service (the port's, so the window is
    one column) and that takes about a second.

    A window put away by `back` is brought out by the compositor, and before
    the page is asked for, not after. A window put away is told it is
    suspended and its client stops drawing; the program brings its own
    window back when it gets the action, and then draws - so the eye caught
    the page it was put away on while the new one was still being built.
    Present (phoc-patches/0009) takes the window out of that sleep first but
    keeps it unseen, and shows it once its client has stopped drawing: by
    then it is the page that was asked for. It is said and waited for, so
    that it is in hand before the program hears about the page.
    """
    follow_me(program)
    try:
        bus().call_sync("org.sfduo.Phoc", "/org/sfduo/Phoc", "org.sfduo.Phoc", "Present",
                        GLib.Variant("(s)", (APP_IDS[program],)), None,
                        Gio.DBusCallFlags.NO_AUTO_START, 500, None)
    except GLib.Error:
        pass            # a stock phoc: the window comes back as it always did
    parameter = GLib.Variant("(sav)", (panel, [GLib.Variant("s", e) for e in extra]))
    said(APP_IDS[program], BUS_PATHS[program], "org.freedesktop.Application",
         "ActivateAction",
         GLib.Variant("(sava{sv})", (PAGE_ACTIONS[program], [parameter], {})))


def close_pages():
    """Tell the pages' programs to go when this one does.

    They are kept alive while this window is open so that the second page
    and every one after it is a switch rather than a cold start; GNOME
    Settings is 145 MB of that, which it should not be once nobody is in
    Settings at all."""
    for program in APP_IDS:
        if not is_running(program):
            continue
        try:
            # waited for: this runs as this program leaves, and a call with
            # nobody to finish it would never be written to the bus
            bus().call_sync(APP_IDS[program], BUS_PATHS[program],
                            "org.freedesktop.Application", "ActivateAction",
                            GLib.Variant("(sava{sv})", ("quit", [], {})), None,
                            Gio.DBusCallFlags.NO_AUTO_START, 1000, None)
        except GLib.Error as err:
            print(f"sfduo-settings: quit {program}: {err.message}", file=sys.stderr)


def read(path):
    try:
        with open(path) as fp:
            return fp.read().strip()
    except OSError:
        return None


class DuoPage(Adw.NavigationPage):
    """What the port is, and what it changed. The switches come in #20."""

    def __init__(self):
        super().__init__(title="Surface Duo")
        page = Adw.PreferencesPage()

        about = Adw.PreferencesGroup(title="This Device")
        for title, value in (
            ("Port", self._package_version()),
            ("Kernel", os.uname().release),
            ("Shell", self._shell()),
        ):
            row = Adw.ActionRow(title=title, subtitle=value or "unknown")
            row.add_css_class("property")
            about.add(row)
        page.add(about)

        page.add(self._shell_group())

        screen = Adw.PreferencesGroup(title="Screen")
        blank = self._blank_row()
        if blank:
            screen.add(blank)
            page.add(screen)

        view = Adw.ToolbarView()
        # no arrow at the top: the way back is the dock's, in the corner under
        # the thumb on either panel (#88) - at the top of the right panel an
        # arrow sits against the hinge
        view.add_top_bar(Adw.HeaderBar(show_back_button=False))
        view.set_content(page)
        self.set_child(view)

    # The shell and the scale are root's to change, so they go through
    # `pkexec sfduo-shell` (org.sfduo.shell.policy), the same command that
    # does it over ssh. Neither applies until the shell restarts, and a
    # restart closes every window - this one too - so it is a button of its
    # own that shows when something is waiting for it, not a side effect.
    SHELL_TOOL = "/usr/local/sbin/sfduo-shell"
    SCALES = [("2", "2"), ("2.5", "2.5"), ("3", "3")]

    def _shell_group(self):
        group = Adw.PreferencesGroup(title="Shell")
        state = self._shell_state()

        self._duo = Adw.SwitchRow(
            title="Two-panel shell",
            subtitle="The dock, a top bar per panel, a window on each. "
                     "Off: Droidian's own phone shell.")
        self._duo.set_active(state.get("shell") != "stock")
        self._duo.connect("notify::active", self._on_duo)
        group.add(self._duo)

        scales = [value for value, _ in self.SCALES]
        current = state.get("scale", "2")
        if current not in scales:
            # set by hand to something not offered here: shown, not changed
            scales.append(current)
        self._scales = scales
        self._scale_row = Adw.ComboRow(
            title="Output scale",
            subtitle="2: 1392×900, the port's. 3: Droidian's. "
                     "2.5 is drawn at 3 and scaled down, and is slower.",
            model=Gtk.StringList.new(scales))
        self._scale_row.set_selected(scales.index(current))
        self._scale_row.connect("notify::selected", self._on_scale)
        group.add(self._scale_row)

        self._restart = Adw.ActionRow(
            title="Restart the shell to apply",
            subtitle="Every open window is closed, this one too")
        button = Gtk.Button(label="Restart", valign=Gtk.Align.CENTER)
        button.add_css_class("destructive-action")
        button.connect("clicked", lambda _b: self._run(["--restart"]))
        self._restart.add_suffix(button)
        self._restart.set_visible(self._pending())
        group.add(self._restart)
        return group

    def _shell_state(self):
        try:
            out = subprocess.run([self.SHELL_TOOL], capture_output=True, text=True,
                                 check=False).stdout
        except OSError:
            return {}
        return dict(line.split("=", 1) for line in out.splitlines() if "=" in line)

    def _pending(self):
        """Whether the running shell is not what is set: a binary replaced
        under a running phosh or phoc, or an output at another scale."""
        for name in ("phosh", "phoc", "phosh-osk-stub"):
            for pid in os.listdir("/proc"):
                if not pid.isdigit() or read(f"/proc/{pid}/comm") != name[:15]:
                    continue
                try:
                    if os.readlink(f"/proc/{pid}/exe").endswith(" (deleted)"):
                        return True
                except OSError:
                    pass
        monitors = Gdk.Display.get_default().get_monitors()
        if monitors.get_n_items():
            running = monitors.get_item(0).get_scale()
            try:
                return abs(running - float(self._shell_state().get("scale", running))) > 0.01
            except ValueError:
                return False
        return False

    def _on_duo(self, row, _pspec):
        want = row.get_active()
        if want == (self._shell_state().get("shell") != "stock"):
            return
        self._run(["--duo" if want else "--stock"])

    def _on_scale(self, row, _pspec):
        want = self._scales[row.get_selected()]
        if want == self._shell_state().get("scale"):
            return
        self._run(["--scale", want])

    def _run(self, args):
        """pkexec in the background: the password prompt is phosh's, and the
        install scripts take a few seconds that the page should not hang for.
        Refused or failed, the rows go back to what is actually set."""
        for widget in (self._duo, self._scale_row, self._restart):
            widget.set_sensitive(False)
        try:
            proc = Gio.Subprocess.new(
                ["pkexec", self.SHELL_TOOL, *args],
                Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE)
        except GLib.Error as err:
            print(f"sfduo-settings: pkexec: {err.message}", file=sys.stderr)
            self._settle()
            return

        def done(proc, result):
            try:
                _ok, out, _err = proc.communicate_utf8_finish(result)
            except GLib.Error as err:
                out = err.message
            if out:
                print(out.rstrip(), file=sys.stderr)
            # 126: the prompt was dismissed, 127: not authorised
            if proc.get_exit_status() != 0:
                print(f"sfduo-settings: sfduo-shell {' '.join(args)}: "
                      f"exit {proc.get_exit_status()}", file=sys.stderr)
            self._settle()

        proc.communicate_utf8_async(None, None, done)

    def _settle(self):
        state = self._shell_state()
        self._duo.set_active(state.get("shell") != "stock")
        scale = state.get("scale")
        if scale in self._scales:
            self._scale_row.set_selected(self._scales.index(scale))
        self._restart.set_visible(self._pending())
        for widget in (self._duo, self._scale_row, self._restart):
            widget.set_sensitive(True)

    # The port's default is Never (dconf/52-sfduo-idle): closing the Duo is
    # what turns it off, and mobile-power-saver slows the phone down while the
    # screen is blank. The key is GNOME's own, the one Battery and Power's
    # "Screen Blank" writes, so the two pages cannot disagree.
    BLANK_DELAYS = [(0, "Never"), (60, "1 minute"), (120, "2 minutes"),
                    (300, "5 minutes"), (600, "10 minutes"), (900, "15 minutes")]

    def _blank_row(self):
        source = Gio.SettingsSchemaSource.get_default()
        if not source or not source.lookup("org.gnome.desktop.session", True):
            return None
        self._session = Gio.Settings(schema_id="org.gnome.desktop.session")
        delays = list(self.BLANK_DELAYS)
        current = self._session.get_uint("idle-delay")
        if current not in (d for d, _ in delays):
            # set elsewhere to a value not offered here: shown, not changed
            delays.append((current, f"{current // 60} min {current % 60} s"
                           if current % 60 else f"{current // 60} minutes"))
            delays.sort()
        self._delays = [d for d, _ in delays]

        row = Adw.ComboRow(
            title="Turn the screen off when idle",
            subtitle="Closing the Duo turns it off anyway. While the screen is "
                     "off the phone slows down, and it locks.",
            model=Gtk.StringList.new([label for _, label in delays]))
        row.set_selected(self._delays.index(current))
        row.connect("notify::selected", self._on_blank_selected)
        self._session.connect("changed::idle-delay", self._on_blank_changed, row)
        return row

    def _on_blank_selected(self, row, _pspec):
        delay = self._delays[row.get_selected()]
        if self._session.get_uint("idle-delay") != delay:
            self._session.set_uint("idle-delay", delay)

    def _on_blank_changed(self, settings, _key, row):
        delay = settings.get_uint("idle-delay")
        if delay in self._delays and row.get_selected() != self._delays.index(delay):
            row.set_selected(self._delays.index(delay))

    @staticmethod
    def _package_version():
        try:
            out = subprocess.run(
                ["dpkg-query", "-W", "-f", "${Version}", "adaptation-droidian-surfaceduo"],
                capture_output=True, text=True, check=False).stdout.strip()
        except OSError:
            return None
        return out or None

    @staticmethod
    def _shell():
        if os.path.exists("/etc/sfduo/phosh-stock"):
            return "stock phosh (the port's shell restored away)"
        version = read("/usr/lib/sfduo/phosh/version")
        return "phosh with the port's patches" if version else "stock phosh"


class Window(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Settings")
        self.set_default_size(420, 800)

        self.nav = Adw.NavigationView()
        page = Adw.PreferencesPage()
        for title, rows in BLOCKS:
            group = Adw.PreferencesGroup(title=title)
            for name, subtitle, icon, target in rows:
                group.add(self._row(name, subtitle, icon, target))
            page.add(group)

        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        view.set_content(page)
        self.nav.add(Adw.NavigationPage(title="Settings", child=view))
        self.set_content(self.nav)
        # A window that opens gives the keyboard to the first thing that can
        # take it, and a row that has the keyboard is drawn as chosen: the
        # list came up with Wi-Fi lit, and the light went out at the first
        # touch. There is no keyboard here to speak of, so nothing holds it.
        self.connect("map", lambda *_a: self.set_focus(None))
        self.connect("notify::is-active", self._on_active)
        # Back at the list, the first page, goes nowhere in the navigation -
        # so it leaves: the window is minimized, as back from an app's first
        # screen does on a phone. The navigation view takes Alt+Left while
        # it can pop; only what it lets through reaches this, in the bubble
        # phase. Alt+Left is what the dock's swipe from the edge sends (#80).
        shortcuts = Gtk.ShortcutController()
        shortcuts.set_propagation_phase(Gtk.PropagationPhase.BUBBLE)
        shortcuts.add_shortcut(Gtk.Shortcut.new(
            Gtk.ShortcutTrigger.parse_string("<Alt>Left"),
            Gtk.CallbackAction.new(self._back_at_root)))
        self.add_controller(shortcuts)

    def _back_at_root(self, *_args):
        if self.nav.get_previous_page(self.nav.get_visible_page()) is not None:
            return False                # not the first page: the view's to handle
        self.minimize()
        return True

    def _row(self, name, subtitle, icon, target):
        row = Adw.ActionRow(title=name, activatable=True)
        if subtitle:
            row.set_subtitle(subtitle)
        row.add_prefix(Gtk.Image.new_from_icon_name(icon))
        # no chevron: it points right on both panels, and on the right one it
        # meets the dock's back arrow at the same edge pointing the other way.
        # A row with an icon and a title reads as a door without it (Android's
        # settings have none).
        row.connect("activated", lambda _r: self._open(name, target))
        return row

    def _open(self, name, target):
        kind = target[0]
        if kind == "duo":
            self.nav.push(DuoPage())
            return
        program = GNOME if kind == "gnome" else MOBILE
        # A program already running answers in about a tenth of a second,
        # with the window it has: nothing to wait for and nothing to stand
        # in for. A cold start is a second away, so the tap is answered here
        # meanwhile - a page with the same title slides in, and the window
        # lands on it.
        if not is_running(program):
            self._wait(name)
        open_page(program, target[1], target[2:])

    # ---- the page another program shows --------------------------------------
    #
    # A row that opens GNOME Settings or Mobile Settings while it is not
    # running pushes a stand-in here first, titled as the page will be, and
    # the program's window then comes up over it on this panel (the dock's
    # Follow). A program already running needs none of this: its window is
    # there before the eye, with the page already switched. Back in that window
    # closes it (sfduo-one-column), this window is the active one again, and
    # the stand-in slides away: to the eye, one program going forward and
    # back. If the window never comes, the stand-in goes by itself.

    WAIT_SPINNER_MS = 500           # a spinner only if the wait is long enough to see
    WAIT_GIVE_UP_S = 8

    def _wait(self, title):
        self._end_wait()
        spinner = Adw.Spinner()
        spinner.set_size_request(32, 32)
        spinner.set_halign(Gtk.Align.CENTER)
        spinner.set_valign(Gtk.Align.CENTER)
        spinner.set_visible(False)
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar(show_back_button=False))
        view.set_content(spinner)
        self.stand_in = Adw.NavigationPage(title=title, child=view)
        self.stand_in.connect("hidden", lambda page: self._stand_in_gone(page))
        self.left = False
        self.nav.push(self.stand_in)
        self.wait_timers = {
            "spinner": GLib.timeout_add(self.WAIT_SPINNER_MS, self._fired, "spinner",
                                        lambda: spinner.set_visible(True)),
            "give-up": GLib.timeout_add_seconds(self.WAIT_GIVE_UP_S, self._fired, "give-up",
                                                self._give_up),
        }

    def _fired(self, key, action):
        self.wait_timers.pop(key, None)
        action()
        return False

    def _on_active(self, *_args):
        stand_in = getattr(self, "stand_in", None)
        if self.is_active():
            self.set_focus(None)            # see the "map" handler
        if stand_in is None:
            return
        if not self.is_active():
            self.left = True                # the program's window took over
            self._stop_timers()
            return
        if self.left:
            # The page's window has just gone and this one is what shows
            # through: it has to be the list already. Sliding the stand-in
            # away once it is in sight is a second motion for one gesture,
            # after the window's own leaving - so it goes without one.
            back = self.nav.get_previous_page(stand_in) or stand_in
            if hasattr(self.nav, "set_animate_transitions"):
                self.nav.set_animate_transitions(False)
                self.nav.pop_to_page(back)
                GLib.idle_add(self.nav.set_animate_transitions, True)
            else:
                self.nav.pop_to_page(back)

    def _give_up(self):
        if getattr(self, "stand_in", None) is not None and not self.left:
            self.nav.pop()

    def _stop_timers(self):
        for timer in getattr(self, "wait_timers", {}).values():
            GLib.source_remove(timer)
        self.wait_timers = {}

    def _stand_in_gone(self, page):
        if page is getattr(self, "stand_in", None):
            self._end_wait()

    def _end_wait(self):
        self._stop_timers()
        self.stand_in = None
        self.left = False


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID,
                         flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self):
        window = self.get_active_window() or Window(self)
        window.present()

    def do_shutdown(self):
        # the pages' programs are kept alive for this window's sake alone
        close_pages()
        Adw.Application.do_shutdown(self)


def main():
    GLib.set_prgname(APP_ID)
    sys.exit(App().run(sys.argv))


if __name__ == "__main__":
    main()
