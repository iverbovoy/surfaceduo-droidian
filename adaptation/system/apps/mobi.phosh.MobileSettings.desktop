[Desktop Entry]
# Out of the grid, not out of reach: the port's Settings (org.sfduo.Settings)
# opens its pages. NoDisplay rather than Hidden, so it can still be launched
# by its id and by D-Bus. Installed by adaptation-droidian-surfaceduo.
Type=Application
Name=Mobile Settings
Exec=phosh-mobile-settings
Icon=mobi.phosh.MobileSettings
Terminal=false
Categories=GNOME;GTK;Settings;
StartupNotify=true
DBusActivatable=true
NoDisplay=true
