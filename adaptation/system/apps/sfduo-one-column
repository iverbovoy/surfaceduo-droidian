#!/bin/sh
# sfduo-one-column: the settings programs one step at a time on one panel
# (#77, #78). Installed as /usr/local/bin/gnome-control-center and
# /usr/local/bin/phosh-mobile-settings - ahead of /usr/bin in PATH, and named
# by D-Bus service files in /usr/local/share/dbus-1/services, since both are
# D-Bus activated - and it tells which one it is by the name it is run as.
#
# Both windows are split views, a list of pages beside the open page, that
# collapse to one column below a width: 550sp for GNOME Settings, 500sp for
# Mobile Settings. A window on one of the Duo's panels is 675 logical px at
# scale 2, so both took themselves for a desktop and put two cramped columns
# side by side. This raises the line to 900sp: one panel goes list, then
# page, with a back button; spanned across both panels (1392 px) it is two
# columns as before.
#
# No rebuild: GLib's G_RESOURCE_OVERLAYS serves a resource from a file on
# disk instead. The file is taken from the installed binary at launch and
# patched here, cached against the binary's mtime and size, so an upgrade
# never meets a stale copy; if the condition is not in it any more, the
# program runs untouched. The session already sets G_RESOURCE_OVERLAYS
# (Droidian's gmobile display panel), so this one is added to it.
#
# Neither program's own list of pages is the way in any more: the port's
# Settings is (sfduo-settings), and it opens their pages over itself, on its
# panel. So the list's column holds one button instead, "Settings", that puts
# the window away and leaves the port's Settings showing under it: the back
# arrow on a page leads there. The window is minimized rather than closed, so
# the program stays and the next page it is asked for is a switch inside it -
# a tenth of a second against the second a cold start costs (#86); the port's
# Settings tells it to quit when it closes itself. The list is still in the
# file, hidden - the program's code holds on to it - and the search and menu
# buttons above it are hidden with it. Should the file not have the shape
# this expects, only the width is changed.
#
# Mobile Settings draws nothing at all with GTK's own default renderer on
# this device - an empty grey window - and draws with GSK_RENDERER=gl. The
# phosh session sets that for everything it starts; this sets it too, for a
# start from anywhere else, unless a renderer was chosen already.

name=${0##*/}
case "$name" in
gnome-control-center)
    RESOURCE=/org/gnome/Settings/gtk/cc-window.ui
    FROM='<condition>max-width: 550sp</condition>'
    PAGE=/org/gnome/Settings/gtk/cc-panel.ui   # the template every panel is built from
    ;;
phosh-mobile-settings)
    RESOURCE=/mobi/phosh/MobileSettings/ui/mobile-settings-window.ui
    FROM='<condition>max-width: 500sp</condition>'
    : "${GSK_RENDERER:=gl}"
    export GSK_RENDERER
    ;;
*)
    echo "sfduo-one-column: run as gnome-control-center or phosh-mobile-settings" >&2
    exit 1
    ;;
esac
REAL=/usr/bin/$name
TO='max-width: 900sp'
DIR="${XDG_RUNTIME_DIR:-/tmp}/sfduo-one-column/$name"
UI="$DIR/window.ui"
PAGE_UI="$DIR/page.ui"

# The cache is against both files that decide what is in it: the program,
# whose resource is taken apart, and this script, which patches it - an
# upgrade of either has to be met with a new copy and not a stale one.
stamp=$(stat -Lc '%Y %s' "$REAL" "$0" 2>/dev/null | tr '\n' ' ')
if [ "$(cat "$DIR/stamp" 2>/dev/null)" != "$stamp" ]; then
    mkdir -p "$DIR"
    rm -f "$UI" "$DIR/stamp"
    if gresource extract "$REAL" "$RESOURCE" > "$UI.new" 2>/dev/null \
       && grep -qF "$FROM" "$UI.new"; then
        python3 - "$UI.new" "$UI" "$TO" <<'PY' || rm -f "$UI"
import sys
import xml.etree.ElementTree as ET

src, dst, width = sys.argv[1:4]
tree = ET.parse(src)
root = tree.getroot()

for cond in root.iter("condition"):
    cond.text = width


def prop(obj, name):
    return next((p for p in obj.findall("property") if p.get("name") == name), None)


def hide(obj):
    el = ET.SubElement(obj, "property", name="visible")
    el.text = "False"


def button():
    """One button over the whole column: back to the port's Settings."""
    btn = ET.Element("object", {"class": "GtkButton"})
    for name, value in (("action-name", "window.minimize"), ("hexpand", "True"),
                        ("vexpand", "True"), ("tooltip-text", "Back to Settings")):
        ET.SubElement(btn, "property", name=name).text = value
    ET.SubElement(ET.SubElement(btn, "style"), "class", name="flat")
    box = ET.SubElement(ET.SubElement(btn, "property", name="child"),
                        "object", {"class": "GtkBox"})
    for name, value in (("spacing", "12"), ("halign", "center"), ("valign", "center")):
        ET.SubElement(box, "property", name=name).text = value
    icon = ET.SubElement(ET.SubElement(box, "child"), "object", {"class": "GtkImage"})
    ET.SubElement(icon, "property", name="icon-name").text = "go-previous-symbolic"
    ET.SubElement(icon, "property", name="pixel-size").text = "24"
    label = ET.SubElement(ET.SubElement(box, "child"), "object", {"class": "GtkLabel"})
    ET.SubElement(label, "property", name="label").text = "Settings"
    ET.SubElement(ET.SubElement(label, "style"), "class", name="title-2")
    return btn


try:
    split = next(o for o in root.iter("object") if o.get("class") == "AdwNavigationSplitView")
    page = prop(split, "sidebar").find("object")
    toolbar = prop(page, "child").find("object")
    content = prop(toolbar, "content")
    listing = content.find("object")
    # the header's buttons: search and the menu, nothing to search here
    for top in toolbar.findall("child"):
        header = top.find("object")
        if header is not None and header.get("class") == "AdwHeaderBar":
            for c in header.findall("child"):
                hide(c.find("object"))
    content.remove(listing)
    hide(listing)
    # Back puts the window away from the page it is on, without going
    # through the program's own first screen: Alt+Left is taken before the
    # navigation sees it. That screen is a column with one button here, and
    # a window put away on it came back on it - a blank page for a tenth of
    # a second while the page asked for was built, because a window put away
    # is suspended and its client only starts drawing when it is shown
    # again. Put away on its page, it comes back on that page; asked for the
    # same one again, there is nothing to change at all.
    template = root.find("template")
    if template is not None:
        # The program's own back button leads to that first screen too, and
        # left to itself it stops there - a column with one button in it.
        # Reaching it, by any road, puts the window away as well: GtkBuilder
        # finds gtk_window_minimize by name in the loaded libraries when the
        # window's class has no callback of that name.
        ET.SubElement(page, "signal", name="shown", handler="gtk_window_minimize",
                      object=template.get("class"), swapped="yes")
        controller = ET.SubElement(ET.SubElement(template, "child"), "object",
                                   {"class": "GtkShortcutController"})
        ET.SubElement(controller, "property", name="scope").text = "local"
        ET.SubElement(controller, "property", name="propagation-phase").text = "capture"
        shortcut = ET.SubElement(ET.SubElement(controller, "child"), "object",
                                 {"class": "GtkShortcut"})
        ET.SubElement(shortcut, "property", name="trigger").text = "<Alt>Left"
        ET.SubElement(shortcut, "property", name="action").text = "action(window.minimize)"
    column = ET.SubElement(content, "object", {"class": "GtkBox"})
    ET.SubElement(column, "property", name="orientation").text = "vertical"
    ET.SubElement(column, "child").append(button())
    ET.SubElement(column, "child").append(listing)
except (StopIteration, AttributeError) as err:
    print(f"sfduo-one-column: the list stays: {err!r}", file=sys.stderr)

# The page's own way back, where the page is in this file (Mobile Settings
# holds both halves here; GNOME Settings builds its pages in code and is
# dealt with through cc-panel.ui). Collapsed, the header of the content side
# grows an arrow that leads to the list, at the top left - against the hinge
# on the right panel. The port's own sits in the corner under the thumb on
# either panel (#88), so this one goes.
try:
    split = next(o for o in root.iter("object") if o.get("class") == "AdwNavigationSplitView")
    content_page = prop(split, "content").find("object")
    toolbar = prop(content_page, "child").find("object")
    header = next(o for o in toolbar.iter("object") if o.get("class") == "AdwHeaderBar")
    ET.SubElement(header, "property", name="show-back-button").text = "False"
except (StopIteration, AttributeError):
    pass                    # a window whose page is not here: nothing to do

tree.write(dst, encoding="unicode", xml_declaration=True)
PY
    fi
    rm -f "$UI.new"
    # The page's own way back goes too (#88). Collapsed, the split view gives
    # a panel's header an arrow that leads to the list, and on the right
    # panel that arrow is against the hinge - the far reach of the other
    # hand - while the port's own sits in the corner under the thumb on
    # whichever panel the window is on. A page that cannot be popped has no
    # arrow: `can-pop` on the template every panel is built from, one line.
    # The panels' own inner pages keep theirs; this is only the way out.
    if [ -n "$PAGE" ]; then
        rm -f "$PAGE_UI"
        if gresource extract "$REAL" "$PAGE" > "$PAGE_UI.new" 2>/dev/null \
           && grep -q "AdwNavigationPage" "$PAGE_UI.new"; then
            python3 - "$PAGE_UI.new" "$PAGE_UI" <<'PAGEPY' || rm -f "$PAGE_UI"
import sys
import xml.etree.ElementTree as ET

src, dst = sys.argv[1:3]
tree = ET.parse(src)
template = tree.getroot().find("template")
if template is None or template.get("parent") != "AdwNavigationPage":
    print("sfduo-one-column: the panel template is not what this expects", file=sys.stderr)
    raise SystemExit(1)
ET.SubElement(template, "property", name="can-pop").text = "False"
tree.write(dst, encoding="unicode", xml_declaration=True)
PAGEPY
        fi
        rm -f "$PAGE_UI.new"
    fi
    echo "$stamp" > "$DIR/stamp"
fi

if [ -s "$UI" ]; then
    G_RESOURCE_OVERLAYS="${G_RESOURCE_OVERLAYS:+$G_RESOURCE_OVERLAYS:}$RESOURCE=$UI"
    export G_RESOURCE_OVERLAYS
fi
if [ -n "$PAGE" ] && [ -s "$PAGE_UI" ]; then
    G_RESOURCE_OVERLAYS="${G_RESOURCE_OVERLAYS:+$G_RESOURCE_OVERLAYS:}$PAGE=$PAGE_UI"
    export G_RESOURCE_OVERLAYS
fi
exec "$REAL" "$@"
