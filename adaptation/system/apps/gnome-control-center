#!/bin/sh
# gnome-control-center, one step at a time on one panel (#77).
#
# Settings' window is a split view - the list of pages beside the open page -
# that collapses into one column only below 550sp (cc-window.ui). A window on
# one of the Duo's panels is 675 logical px wide at scale 2, so Settings took
# itself for a desktop and put two cramped columns side by side. This raises
# the line to 900sp: on one panel it goes list, then page, with a back
# button; spanned across both panels (1392 px) it is two columns as before.
#
# No rebuild: GLib's G_RESOURCE_OVERLAYS serves a resource from a file on
# disk instead. The file is taken from the installed binary at launch and
# patched here, cached against the binary's mtime and size, so an upgrade of
# Settings never meets a stale copy; if the condition is not in it any more,
# Settings runs untouched. The session already sets G_RESOURCE_OVERLAYS
# (Droidian's gmobile display panel), so this one is added to it.
#
# First in PATH (/usr/local/bin) and named by the D-Bus service file in
# /usr/local/share/dbus-1/services, since Settings is D-Bus activated.

REAL=/usr/bin/gnome-control-center
RESOURCE=/org/gnome/Settings/gtk/cc-window.ui
FROM='<condition>max-width: 550sp</condition>'
TO='<condition>max-width: 900sp</condition>'
DIR="${XDG_RUNTIME_DIR:-/tmp}/sfduo-settings"
UI="$DIR/cc-window.ui"

stamp=$(stat -c '%Y %s' "$REAL" 2>/dev/null)
if [ "$(cat "$DIR/stamp" 2>/dev/null)" != "$stamp" ]; then
    mkdir -p "$DIR"
    rm -f "$UI" "$DIR/stamp"
    if gresource extract "$REAL" "$RESOURCE" > "$UI.new" 2>/dev/null \
       && grep -qF "$FROM" "$UI.new"; then
        sed "s|$FROM|$TO|" "$UI.new" > "$UI"
    fi
    rm -f "$UI.new"
    echo "$stamp" > "$DIR/stamp"
fi

if [ -s "$UI" ]; then
    G_RESOURCE_OVERLAYS="${G_RESOURCE_OVERLAYS:+$G_RESOURCE_OVERLAYS:}$RESOURCE=$UI"
    export G_RESOURCE_OVERLAYS
fi
exec "$REAL" "$@"
