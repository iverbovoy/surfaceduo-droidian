#!/bin/sh
# sfduo-cpufreq: keep the CPUs off the powersave governor while the screen is on.
#
# Droidian's mobile-power-saver puts every core on `powersave` - its lowest
# clock, 576 MHz on the little cores and 826 MHz on the big one - while the
# screen is off, and back on `schedutil` when it comes on. Two ways it gets
# that wrong on this device, both measured 2026-09-18:
#
# 1. At boot the screen is off until phosh has drawn, so the saver starts in
#    the off state; the first "on" never reaches it, and the device runs at
#    its lowest clocks until the screen has been turned off and on once by
#    hand (`systemctl daemon-reload` 30 s that way and 2 s after, a root
#    login 26 s against 2 s).
# 2. Its `StopDozing` method - meant for a client that needs the device awake
#    for a moment - restarts the saver's "dozing" cycle without looking at
#    the screen: 30 s later every cluster is on `powersave` for 300 s out of
#    every 330 s, with the screen on, until the next screen-off/on. Droidian's
#    headphone-manager calls it on every headset-jack event, and on the Duo
#    the USB-C cable is the headset jack - so every cable plug does this.
#
# So this watches for the whole session: whenever the screen is on and the
# governor says powersave, put schedutil back. Nothing here fights the saver
# while the screen is off. The check is two sysfs reads every 5 s.
for i in $(seq 1 120); do
    pgrep -x phosh >/dev/null && break
    sleep 1
done
screen_on() {
    for b in /sys/class/backlight/*/bl_power; do
        [ -r "$b" ] && [ "$(cat "$b")" = 0 ] && return 0
    done
    return 1
}
while :; do
    if screen_on && [ "$(cat /sys/devices/system/cpu/cpufreq/policy0/scaling_governor)" = powersave ]; then
        for p in /sys/devices/system/cpu/cpufreq/policy*; do
            [ -w "$p/scaling_governor" ] && echo schedutil > "$p/scaling_governor"
        done
        echo "sfduo-cpufreq: screen on and governor powersave - schedutil put back"
    fi
    sleep 5
done
