#!/bin/sh
# sfduo-cpufreq: take the CPUs off the powersave governor once the shell is up.
#
# Droidian's mobile-power-saver puts every core on `powersave` - its lowest
# clock, 576 MHz on the little cores and 826 MHz on the big one - while the
# screen is off, and back on `schedutil` when it comes on. At boot the screen
# is off until phosh has drawn, so the saver starts in the off state; the
# first "on" never reaches it, and the device runs at its lowest clocks until
# the screen has been turned off and on once by hand. Measured 2026-09-18:
# `systemctl daemon-reload` 30 s that way and 2 s after a screen cycle, a
# root login 26 s against 2 s. With the port's idle blanking off an open
# device would stay like that for the whole session.
#
# So this waits for the shell and then, for the first minutes of the session,
# keeps putting schedutil back whenever the screen is on and the governor
# says powersave: the saver's user service starts a little after phosh, and a
# single write 15 s in lost the race to it once (measured: powersave again by
# the afternoon, launches 8-14 s instead of 2). From then on the saver toggles
# the governor on screen events as it should; nothing here fights it while
# the screen is off.
for i in $(seq 1 120); do
    pgrep -x phosh >/dev/null && break
    sleep 1
done
screen_on() {
    for b in /sys/class/backlight/*/bl_power; do
        [ -r "$b" ] && [ "$(cat "$b")" = 0 ] && return 0
    done
    return 1
}
fixed=0
for i in $(seq 1 18); do          # 3 minutes
    sleep 10
    if screen_on && [ "$(cat /sys/devices/system/cpu/cpufreq/policy0/scaling_governor)" = powersave ]; then
        for p in /sys/devices/system/cpu/cpufreq/policy*; do
            [ -w "$p/scaling_governor" ] && echo schedutil > "$p/scaling_governor"
        done
        fixed=$((fixed + 1))
    fi
done
echo "sfduo-cpufreq: governor $(cat /sys/devices/system/cpu/cpufreq/policy0/scaling_governor); put back $fixed time(s) in the first 3 minutes"
