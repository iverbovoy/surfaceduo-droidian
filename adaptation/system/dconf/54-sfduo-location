# Location on request, not all day (#102). GNOME Clocks' background process
# (gnome-clocks --hidden, autostarted for the alarms) follows the location
# for its world clocks' "current location" whenever it runs, and it runs
# always: GeoClue reported InUse at every moment, which made a location mark
# meaningless and kept the modem and Wi-Fi sources busy. Alarms and timers
# need no location. The desktop clock's weather is GNOME Weather's chosen
# city. A default, not a lock - Clocks can turn it back on.
[org/gnome/clocks]
geolocation=false

# Night Light (gsd-color) asked for the location at every session start to
# find the sunset - with Night Light itself off - and GeoClue sent the Wi-Fi
# networks around the phone to api.beacondb.net to answer it. Its schedule
# is the fixed one instead (20:00-06:00 unless changed); "sunset to sunrise"
# is one switch away in Settings.
[org/gnome/settings-daemon/plugins/color]
night-light-schedule-automatic=false
